---
import MarketTickerBar from "../components/MarketTickerBar.astro";
import { DISCOVER_PAGE, FOOTER, NEWS_PAGE, SITE, THEMES_PAGE } from "../lib/ui";

interface Props {
  title: string;
  description?: string;
  /** 相對於網站根路徑的社群預覽圖 */
  ogImage?: string;
  /** 不讓搜尋引擎索引（例如預覽環境） */
  noIndex?: boolean;
  /** 頁面層級 JSON-LD 結構化資料(單一或陣列),會與全站 Organization 一併輸出 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = SITE.desc,
  ogImage = "/og-default.svg",
  noIndex = false,
  jsonLd,
} = Astro.props;

const siteBase = Astro.site ?? new URL("/", Astro.url);
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, siteBase);
const ogImageUrl = new URL(ogImage, siteBase);

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: siteBase.href,
};
const pageLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // 在繪製前套用主題(避免閃爍)+ 以事件委派處理切換鈕
      (function () {
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem("tw:theme") || "dark";
        } catch (e) {}
        document.addEventListener("click", function (e) {
          var btn = e.target && e.target.closest && e.target.closest("#theme-toggle");
          if (!btn) return;
          var next =
            document.documentElement.dataset.theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("tw:theme", next);
          } catch (e2) {}
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {pageLdList.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/fin-dash.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">{SITE.name}</a>
        <div class="nav-links">
          <a href="/news">{NEWS_PAGE.nav}</a>
          <a href="/sectors">產業</a>
          <a href="/screener">選股</a>
          <a href="/watchlist">自選</a>
          <a href="/themes">{THEMES_PAGE.nav}</a>
          <a href="/discover">{DISCOVER_PAGE.nav}</a>
          <a href="/wiki">Wikilink 索引</a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="切換深色／明亮模式"
            title="深色／明亮"
            style="background:transparent;border:1px solid var(--border);color:inherit;cursor:pointer;font-size:1rem;line-height:1;padding:4px 8px;border-radius:6px;"
          >◐</button>
        </div>
      </nav>
    </header>
    <MarketTickerBar />
    <main class="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-disclaimer" role="note">{FOOTER.disclaimer}</p>
      <p class="footer-source">
        資料來源：<a
          href="https://github.com/meishihna/myTWstock"
          target="_blank"
          rel="noopener">GitHub · meishihna / TWstock</a
        >
      </p>
    </footer>
  </body>
</html>

---
import { renderReportMarkdown } from "../lib/renderReport";
import type { RelationBlocks } from "../lib/parseReport";
import type { BizRevenueRow } from "../lib/businessIntro";
import { RELATION } from "../lib/ui";

export interface RevenueStructureTab {
  yearLabel: string | null;
  revenueRows: BizRevenueRow[];
  revenueGeo: string | null;
}

interface Props {
  blocks: RelationBlocks;
  /** 來自業務簡介／enrichment 之營收結構，插入為「第四個」膠囊（在主要供應商之後、競爭對手之前） */
  revenueStructure?: RevenueStructureTab | null;
  /** 個股代號：提供時加入「相關新聞」頁籤，前端於開啟時即時抓 /api/revenue-news */
  ticker?: string | null;
  nameToTicker: Record<string, string>;
  labelToWikiSlug?: Record<string, string>;
}
const {
  blocks,
  revenueStructure = null,
  ticker = null,
  nameToTicker,
  labelToWikiSlug,
} = Astro.props;

/** 將「**上游 (說明):**」整段粗體拆成僅上游／中游／下游加粗，避免括號內文被一併放大 */
function normalizeRelationTierLabels(html: string): string {
  let out = html.replace(
    /<strong>(上游|中游|下游)\s*\(([^)]+)\)\s*[:：]\s*<\/strong>/g,
    '<strong class="relation-tier-label">$1</strong> ($2):',
  );
  out = out.replace(
    /<strong>(上游|中游|下游)<\/strong>(?=\s*[\(（])/g,
    '<strong class="relation-tier-label">$1</strong>',
  );
  return out;
}

function toHtml(fragment?: string): string {
  if (!fragment?.trim()) return "";
  return normalizeRelationTierLabels(
    renderReportMarkdown(fragment, nameToTicker, labelToWikiSlug),
  );
}

type TabEntry =
  | {
      kind: "md";
      key: keyof RelationBlocks;
      title: string;
      html: string;
    }
  | {
      kind: "revenue";
      key: "revenueStructure";
      title: string;
      yearLabel: string | null;
      rows: BizRevenueRow[];
      geo: string | null;
    }
  | {
      kind: "news";
      key: "news";
      title: string;
      ticker: string;
    };

const entries: TabEntry[] = [];

function pushMd(key: keyof RelationBlocks, title: string, html: string) {
  if (html.length > 0) {
    entries.push({ kind: "md", key, title, html });
  }
}

pushMd("supplyChain", RELATION.supply, toHtml(blocks.supplyChain));
pushMd("customers", RELATION.customers, toHtml(blocks.customers));
pushMd("suppliers", RELATION.suppliers, toHtml(blocks.suppliers));

if (
  revenueStructure &&
  revenueStructure.revenueRows &&
  revenueStructure.revenueRows.length > 0
) {
  entries.push({
    kind: "revenue",
    key: "revenueStructure",
    title: RELATION.revenue,
    yearLabel: revenueStructure.yearLabel,
    rows: revenueStructure.revenueRows,
    geo: revenueStructure.revenueGeo,
  });
}

pushMd("competitors", RELATION.competitors, toHtml(blocks.competitors));

if (ticker && /^\d{4,6}$/.test(ticker)) {
  entries.push({ kind: "news", key: "news", title: "相關新聞", ticker });
}

/** 穩定唯一 id 前綴（同頁僅一區塊時亦唯一） */
const relationIdBase = entries.map((e) => e.key).join("-") || "relation";
---

{
  entries.length > 0 && (
    <section
      class="relation-summary"
      aria-label={RELATION.title}
      data-relation-tabs={relationIdBase}
    >
      <div class="relation-summary__head">
        <h2 class="relation-summary-title">{RELATION.title}</h2>
        <p class="relation-summary-hint">{RELATION.hint}</p>
      </div>

      <div class="relation-tablist-wrap">
        <div role="tablist" class="relation-tablist" aria-label={RELATION.title}>
          {entries.map((s, i) => {
            const tid = `rel-tab-${relationIdBase}-${s.key}`;
            const pid = `rel-panel-${relationIdBase}-${s.key}`;
            return (
              <button
                type="button"
                role="tab"
                id={tid}
                class:list={["relation-tab", { "relation-tab--active": i === 0 }]}
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={pid}
                tabindex={i === 0 ? 0 : -1}
                data-relation-key={s.key}
              >
                <span class="relation-tab__icon" aria-hidden="true">
                  {s.key === "supplyChain" ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="3" />
                      <path d="M4 12h5M15 12h5M12 5v5M12 14v5" />
                    </svg>
                  ) : s.key === "customers" ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  ) : s.key === "suppliers" ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                      <line x1="12" y1="22.08" x2="12" y2="12" />
                    </svg>
                  ) : s.key === "revenueStructure" ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="18" y1="20" x2="18" y2="10" />
                      <line x1="12" y1="20" x2="12" y2="4" />
                      <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                  ) : s.key === "news" ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" />
                      <path d="M18 14h-8M15 18h-5M10 6h8v4h-8z" />
                    </svg>
                  ) : (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <path d="m15 9-6 6M9 9l6 6" />
                    </svg>
                  )}
                </span>
                <span class="relation-tab__label">{s.title}</span>
              </button>
            );
          })}
        </div>
      </div>

      <div class="relation-panels">
        {entries.map((s, i) => {
          const tid = `rel-tab-${relationIdBase}-${s.key}`;
          const pid = `rel-panel-${relationIdBase}-${s.key}`;
          const panelOuterClass =
            i === 0
              ? "relation-tabpanel relation-tabpanel--active"
              : "relation-tabpanel";
          const revYear =
            s.kind === "revenue" &&
            s.yearLabel != null &&
            s.yearLabel !== ""
              ? s.yearLabel
              : "—";
          return (
            <div
              role="tabpanel"
              id={pid}
              class={panelOuterClass}
              aria-labelledby={tid}
              tabindex={0}
              hidden={i !== 0 ? true : undefined}
            >
              {s.kind === "md" ? (
                <div
                  class="relation-summary-body prose-rel relation-tabpanel-inner"
                  set:html={s.html}
                />
              ) : s.kind === "revenue" ? (
                <div class="relation-tabpanel-inner relation-rev-wrap">
                  <div
                    class="biz-rev relation-rev"
                    aria-label={RELATION.revenue}
                    data-revenue-panel=""
                  >
                    <div class="biz-rev-title relation-rev-title">營收結構（{revYear}）</div>
                    {s.rows.map((item, ri) => (
                      <div class="biz-rev-item relation-rev-row">
                        <div class="biz-rev-label">{item.name}</div>
                        <div class="biz-rev-bar-wrap relation-rev-bar-track">
                          <div
                            class="biz-rev-bar-fill relation-rev-bar-fill"
                            style={`--bar-accent: ${item.color}; --rev-delay: ${ri * 55}ms`}
                            data-target-pct={item.pct}
                          />
                        </div>
                        <div class="biz-rev-pct relation-rev-pct">
                          <span class="relation-rev-pct-num" data-target-pct={item.pct}
                            >0</span
                          ><span class="relation-rev-pct-unit" aria-hidden="true">%</span>
                        </div>
                      </div>
                    ))}
                    {s.geo && <div class="biz-rev-geo relation-rev-geo">{s.geo}</div>}
                  </div>
                </div>
              ) : (
                <div
                  class="relation-tabpanel-inner relation-news"
                  data-news-ticker={s.ticker}
                >
                  <p class="relation-news-status">載入中…</p>
                </div>
              )}
            </div>
          );
        })}
      </div>

      <script is:inline define:vars={{ relationIdBase, nTabs: entries.length }}>
        (function () {
          var base = relationIdBase;
          var root = document.querySelector(
            '.relation-summary[data-relation-tabs="' + base + '"]'
          );
          if (!root || !nTabs) return;

          var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
          var panels = tabs.map(function (tab) {
            var id = tab.getAttribute("aria-controls");
            return id ? document.getElementById(id) : null;
          });

          function ix(i) {
            return ((i % tabs.length) + tabs.length) % tabs.length;
          }

          /* ── FinMind:一律由【使用者瀏覽器】匿名直抓 ────────────────────────
           * 本站【不】在伺服器端抓取、【不】快取後供其他訪客、【不】使用任何金鑰。
           * 使用者自己就是 FinMind 的用戶,本站只提供介面。
           *
           * 實測(2026-08-02):成功回應帶 access-control-allow-origin: *,可跨域;
           * 但【錯誤回應(400 等)不帶 CORS 標頭】→ 瀏覽器只會拿到不透明的 Failed to fetch,
           * 無從分辨「額度用完 / 服務異常 / 使用者網路問題」→ 因此一律顯示「暫時取不到」,
           * 絕不臆測原因、絕不自動重試轟炸。
           */
          var FINMIND_V4 = "https://api.finmindtrade.com/api/v4/data";
          var NEWS_DAYS = 5;
          var MAX_HEADLINES = 8;
          var SRC_BLACKLIST = ["CMoney", "facebook", "Facebook", "玩股網", "PTT", "Dcard"];
          var TITLE_BLACKLIST = [
            "股市爆料同學會", "期貨服務", "盤前規劃", "盤後", "當沖", "籌碼K線", "技術分析",
            "股東會", "股東常會", "股東人數", "除息", "除權", "配息", "現金股利", "減資", "增資",
            "庫藏股", "買回", "董事會決議", "停牌", "變更交易", "選擇權", "權證",
            "能不能接", "還能買", "該不該", "跌破", "漲破", "回跌", "軋空", "作帳",
          ];
          var STRONG = [
            "訂單", "接單", "轉單", "出貨", "拉貨", "擴產", "產能", "漲價", "報價", "調漲",
            "毛利", "營收", "業績", "財報", "財測", "EPS", "純益", "稅後", "需求", "缺貨",
            "得標", "標案", "認證", "打入", "量產", "併購", "旺季", "暢旺", "強勁", "暴增",
            "激增", "年增", "月增", "衰退", "銳減", "轉盈", "轉虧", "去化", "報喜", "法說",
            "展望", "新客戶", "供應鏈", "接獲", "簽約", "合約", "投產", "新廠",
          ];
          /* 只快取在本分頁記憶體(同一 session 切換頁籤不重打);不跨使用者、不落地 */
          var newsMemo = {};

          function cleanTitle(t) {
            var s = (t || "").trim();
            s = s.replace(/\s*[-–—]\s*[^-–—]{1,20}$/, "").trim();
            s = s.replace(/^\d{4,6}\s+\S+\s*[-–—]\s*/, "").trim();
            return s;
          }
          function strongScore(t) {
            var n = 0;
            for (var i = 0; i < STRONG.length; i++) if (t.indexOf(STRONG[i]) >= 0) n++;
            return n;
          }
          /** 成功回陣列(可能為空);【失敗回 null】——
           *  失敗與「當天真的沒新聞」必須分得開,否則全掛時會誤顯示「近期無相關新聞」 */
          function fetchDay(tk, day, signal) {
            var url =
              FINMIND_V4 + "?dataset=TaiwanStockNews&data_id=" + encodeURIComponent(tk) +
              "&start_date=" + day;
            return fetch(url, { signal })
              .then(function (r) {
                if (!r.ok) return null;
                return r.json().then(
                  function (j) {
                    return j && j.status === 200 && Array.isArray(j.data) ? j.data : null;
                  },
                  function () { return null; }
                );
              })
              .catch(function () { return null; });
          }
          /** 回傳 Promise<heads[]>;整批皆失敗則 reject(讓 UI 顯示「暫時取不到」) */
          function fetchNews(tk) {
            if (newsMemo[tk]) return Promise.resolve(newsMemo[tk]);
            var today = new Date();
            var days = [];
            for (var i = 0; i < NEWS_DAYS; i++) {
              days.push(new Date(today.getTime() - i * 86400000).toISOString().slice(0, 10));
            }
            var ctrl = typeof AbortController === "function" ? new AbortController() : null;
            var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 9000);
            return Promise.all(
              days.map(function (d) { return fetchDay(tk, d, ctrl ? ctrl.signal : undefined); })
            ).then(function (batches) {
              clearTimeout(timer);
              var rows = [];
              var okCount = 0;
              batches.forEach(function (b) {
                if (b === null) return;      /* 該日請求失敗 */
                okCount++;
                rows = rows.concat(b);
              });
              /* 【全部日期都失敗】→ 視為取不到,丟出錯誤讓 UI 顯示「暫時取不到」+ 重試。
                 只要有任一日成功(即使回空陣列),就是有效結果 → 可顯示「近期無相關新聞」。 */
              if (okCount === 0) throw new Error("unavailable");
              var seen = {};
              var cand = [];
              rows.forEach(function (r) {
                var rawTitle = String((r && r.title) || "");
                var src = String((r && r.source) || "");
                for (var i = 0; i < SRC_BLACKLIST.length; i++)
                  if (src.indexOf(SRC_BLACKLIST[i]) >= 0) return;
                for (var k = 0; k < TITLE_BLACKLIST.length; k++)
                  if (rawTitle.indexOf(TITLE_BLACKLIST[k]) >= 0) return;
                var t = cleanTitle(rawTitle);
                var key = t.replace(/\s+/g, "").slice(0, 24);
                if (!t || seen[key]) return;
                seen[key] = 1;
                cand.push({
                  d: String((r && r.date) || "").slice(0, 10),
                  t: t,
                  s: src,
                  u: r && typeof r.link === "string" && r.link ? r.link : null,
                  _st: strongScore(t),
                });
              });
              cand.sort(function (a, b) {
                return b._st - a._st || (a.d < b.d ? 1 : a.d > b.d ? -1 : 0);
              });
              var heads = cand.slice(0, MAX_HEADLINES).map(function (h) {
                return { d: h.d, t: h.t, s: h.s, u: h.u };
              });
              newsMemo[tk] = heads;   /* 走到這裡代表至少一日成功,結果有效可快取(僅本分頁記憶體) */
              return heads;
            }, function () {
              clearTimeout(timer);
              throw new Error("unavailable");
            });
          }

          function renderNews(panel, heads) {
            var status = panel.querySelector(".relation-news-status");
            if (!heads || !heads.length) {
              if (status) status.textContent = "近期無相關新聞。";
              return;
            }
            var ul = document.createElement("ul");
            ul.className = "relation-news-list";
            heads.forEach(function (h) {
              var li = document.createElement("li");
              li.className = "relation-news-item";
              var url =
                typeof h.u === "string" && /^https?:\/\//.test(h.u) ? h.u : null;
              var wrap = document.createElement(url ? "a" : "div");
              if (url) {
                wrap.href = url;
                wrap.target = "_blank";
                wrap.rel = "noopener noreferrer";
              }
              var t = document.createElement("span");
              t.className = "relation-news-t";
              t.textContent = h.t || "";
              var m = document.createElement("span");
              m.className = "relation-news-m";
              var d = (h.d || "").slice(5);
              m.textContent = d + (h.s ? (d ? " · " : "") + h.s : "");
              wrap.appendChild(t);
              wrap.appendChild(m);
              li.appendChild(wrap);
              ul.appendChild(li);
            });
            var src = document.createElement("p");
            src.className = "relation-news-src";
            src.textContent =
              "資料來源：FinMind（第三方，非官方）。由你的瀏覽器直接取得，本站不儲存、不轉發。僅供參考，非投資建議。";
            panel.textContent = "";
            panel.appendChild(ul);
            panel.appendChild(src);
          }

          /** 失敗一律顯示「暫時取不到」+ 重試鈕;不臆測原因、不自動重試 */
          function renderNewsError(panel) {
            panel.textContent = "";
            var p = document.createElement("p");
            p.className = "relation-news-status";
            p.textContent = "暫時取不到新聞。";
            var hint = document.createElement("p");
            hint.className = "relation-news-src";
            hint.textContent =
              "本欄位由你的瀏覽器直接向 FinMind（第三方，非官方）取得，本站不儲存、不轉發。";
            var btn = document.createElement("button");
            btn.type = "button";
            btn.className = "relation-news-retry";
            btn.textContent = "重試";
            btn.addEventListener("click", function () {
              panel.removeAttribute("data-news-loaded");
              panel.textContent = "";
              var s = document.createElement("p");
              s.className = "relation-news-status";
              s.textContent = "載入中…";
              panel.appendChild(s);
              loadNews(panel.closest(".relation-tabpanel") || panel.parentNode);
            });
            panel.appendChild(p);
            panel.appendChild(btn);
            panel.appendChild(hint);
          }

          function loadNews(panelWrap) {
            if (!panelWrap) return;
            var panel = panelWrap.querySelector(".relation-news[data-news-ticker]");
            if (!panel || panel.getAttribute("data-news-loaded")) return;
            var tk = panel.getAttribute("data-news-ticker");
            if (!tk) return;
            panel.setAttribute("data-news-loaded", "1");
            /* 瀏覽器直抓 FinMind;不經本站伺服器 */
            fetchNews(tk)
              .then(function (heads) {
                renderNews(panel, heads);
              })
              .catch(function () {
                panel.removeAttribute("data-news-loaded"); /* 允許使用者按重試 */
                renderNewsError(panel);
              });
          }

          function resetRevenuePanel(panel) {
            if (!panel) return;
            var rev = panel.querySelector(".relation-rev[data-revenue-panel]");
            if (!rev) return;
            rev.querySelectorAll(".relation-rev-bar-fill").forEach(function (el) {
              el.style.width = "0%";
            });
            rev.querySelectorAll(".relation-rev-pct-num").forEach(function (el) {
              el.textContent = "0";
            });
          }

          function playRevenueAnim(panel) {
            if (!panel) return;
            var rev = panel.querySelector(".relation-rev[data-revenue-panel]");
            if (!rev) return;
            var fills = rev.querySelectorAll(".relation-rev-bar-fill");
            var nums = rev.querySelectorAll(".relation-rev-pct-num");
            var reduce =
              typeof window.matchMedia === "function" &&
              window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (reduce) {
              fills.forEach(function (el) {
                var t = el.getAttribute("data-target-pct");
                if (t != null) el.style.width = t + "%";
              });
              nums.forEach(function (el) {
                var t = el.getAttribute("data-target-pct");
                if (t != null) el.textContent = String(t);
              });
              return;
            }
            fills.forEach(function (el) {
              el.style.width = "0%";
            });
            nums.forEach(function (el) {
              el.textContent = "0";
            });
            rev.offsetHeight;
            window.requestAnimationFrame(function () {
              window.requestAnimationFrame(function () {
                fills.forEach(function (el) {
                  var t = el.getAttribute("data-target-pct");
                  if (t != null) el.style.width = t + "%";
                });
                var start = performance.now();
                var duration = 820;
                var targets = [];
                nums.forEach(function (el) {
                  var n = parseInt(el.getAttribute("data-target-pct"), 10);
                  targets.push(isNaN(n) ? 0 : n);
                });
                function tick(now) {
                  var p = Math.min(1, (now - start) / duration);
                  var ease = 1 - Math.pow(1 - p, 3);
                  nums.forEach(function (el, idx) {
                    var tg = targets[idx];
                    el.textContent = String(Math.round(tg * ease));
                  });
                  if (p < 1) {
                    window.requestAnimationFrame(tick);
                  } else {
                    nums.forEach(function (el, idx) {
                      el.textContent = String(targets[idx]);
                    });
                  }
                }
                window.requestAnimationFrame(tick);
              });
            });
          }

          function activate(index) {
            var i = ix(index);
            for (var j = 0; j < tabs.length; j++) {
              var on = j === i;
              tabs[j].setAttribute("aria-selected", on ? "true" : "false");
              tabs[j].tabIndex = on ? 0 : -1;
              if (on) tabs[j].classList.add("relation-tab--active");
              else tabs[j].classList.remove("relation-tab--active");
              if (panels[j]) {
                if (!on && panels[j].querySelector(".relation-rev[data-revenue-panel]")) {
                  resetRevenuePanel(panels[j]);
                }
                if (on) {
                  panels[j].removeAttribute("hidden");
                  panels[j].classList.add("relation-tabpanel--active");
                  if (tabs[j].getAttribute("data-relation-key") === "revenueStructure") {
                    playRevenueAnim(panels[j]);
                  }
                  if (tabs[j].getAttribute("data-relation-key") === "news") {
                    loadNews(panels[j]);
                  }
                } else {
                  panels[j].hidden = true;
                  panels[j].classList.remove("relation-tabpanel--active");
                }
              }
            }
          }

          function currentIndex() {
            for (var k = 0; k < tabs.length; k++) {
              if (tabs[k].getAttribute("aria-selected") === "true") return k;
            }
            return 0;
          }

          tabs.forEach(function (tab, index) {
            tab.addEventListener("click", function () {
              activate(index);
              tab.focus();
            });

            tab.addEventListener("keydown", function (ev) {
              var key = ev.key;
              var ci = currentIndex();
              if (key === "ArrowRight" || key === "ArrowDown") {
                ev.preventDefault();
                activate(ci + 1);
                tabs[ix(ci + 1)].focus();
              } else if (key === "ArrowLeft" || key === "ArrowUp") {
                ev.preventDefault();
                activate(ci - 1);
                tabs[ix(ci - 1)].focus();
              } else if (key === "Home") {
                ev.preventDefault();
                activate(0);
                tabs[0].focus();
              } else if (key === "End") {
                ev.preventDefault();
                activate(tabs.length - 1);
                tabs[tabs.length - 1].focus();
              }
            });
          });

          /* 若預設選中即為營收結構（僅有此膠囊時），初次載入也播放 */
          (function initRevIfActive() {
            for (var q = 0; q < tabs.length; q++) {
              if (
                tabs[q].getAttribute("aria-selected") === "true" &&
                tabs[q].getAttribute("data-relation-key") === "revenueStructure"
              ) {
                window.requestAnimationFrame(function () {
                  playRevenueAnim(panels[q]);
                });
                break;
              }
            }
          })();
        })();
      </script>
    </section>
  )
}

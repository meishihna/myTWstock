            "fin-dash__kpi-card",
            c.emphasize && "fin-dash__kpi-card--emphasize",
            c.trend === "up" && "fin-dash__kpi-card--up",
            c.trend === "down" && "fin-dash__kpi-card--down",
          ]}
        >
          <span class="fin-dash__kpi-label">{c.label}</span>
          <span class="fin-dash__kpi-value">{c.value}</span>
          {c.delta && <span class="fin-dash__kpi-delta">{c.delta}</span>}
          {c.note && <span class="fin-dash__kpi-note">{c.note}</span>}
        </div>
      ))
    }
  </div>
  {
    kpiSecondary.length > 0 && (
      <div class="fin-dash__kpi-row fin-dash__kpi-row--4">
        {kpiSecondary.map((c) => (
          <div
            class:list={[
              "fin-dash__kpi-card",
              c.trend === "up" && "fin-dash__kpi-card--up",
              c.trend === "down" && "fin-dash__kpi-card--down",
            ]}
          >
            <span class="fin-dash__kpi-label">{c.label}</span>
            <span class="fin-dash__kpi-value">{c.value}</span>
            {c.delta && <span class="fin-dash__kpi-delta">{c.delta}</span>}
            {c.note && <span class="fin-dash__kpi-note">{c.note}</span>}
          </div>
        ))}
      </div>
    )
  }

  <div class="fin-dash__tabs" role="tablist">
    <button type="button" class="fin-dash__tab is-active" role="tab" aria-selected="true" data-fin-tab="annual">
      年報
    </button>
    <button
      type="button"
      class="fin-dash__tab"
      role="tab"
      aria-selected="false"
      data-fin-tab="quarterly"
      disabled={!quarterly}
    >
      季報
    </button>
    <button
      type="button"
      class="fin-dash__tab"
      role="tab"
      aria-selected="false"
      data-fin-tab="monthly"
      disabled={!monthly}
    >
      月營收
    </button>
    <button
      type="button"
      class="fin-dash__tab"
      role="tab"
      aria-selected="false"
      data-fin-tab="chips"
      disabled={!hasChips}
    >
      籌碼面
    </button>
  </div>

  <div class="fin-dash__panel is-active" data-fin-panel="annual">
    <div class="fin-dash__chart-grid">
    <figure class="fin-dash__chart">
      <p class="fin-dash__sl">{annRevProfit.title}（{annRevProfit.unit}）</p>
      <ul class="fin-dash__legend">
        {annRevProfit.paths.map((p) => (
          <li>
            <span class="fin-dash__leg-dot" style={`background:${p.color}`} />
            {p.name}
          </li>
        ))}
      </ul>
      <div class="fin-dash__canvas-wrap fin-dash__canvas-wrap--tall">
        <svg class="fin-dash__svg" viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <line class="fin-dash__axis-spine" x1={PAD.l} y1={PAD.t} x2={PAD.l} y2={PLOT_BOTTOM} />
          <line class="fin-dash__axis-spine" x1={PAD.l} y1={PLOT_BOTTOM} x2={PLOT_R} y2={PLOT_BOTTOM} />
          {annRevProfit.tickVals.map((tv) => {
            const yy = annRevProfit.y(tv);
            return (
              <g>
                <line class="fin-dash__grid" x1={PAD.l} x2={CHART_W - PAD.r} y1={yy} y2={yy} />
                <text class="fin-dash__ytick" x={PAD.l - 10} y={yy + 4} text-anchor="end">
                  {fmtM(tv)}
                </text>
              </g>
            );
          })}
          {annRevProfit.revenueFillD && (
            <path d={annRevProfit.revenueFillD} fill="#378ADD" fill-opacity="0.14" stroke="none" />
          )}
          {annRevProfit.paths.map((p) => (
            <path
              d={p.d}
              fill="none"
              stroke={p.color}
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
              stroke-dasharray={p.strokeDasharray}
            />
          ))}
          {annRevProfit.pointDots.flatMap((dots) =>
            dots.map((d) => <circle cx={d.cx} cy={d.cy} r="3.5" fill={d.color} />)
          )}
          {annRevProfit.xLabels.map((lab, i) => {
            const xi = PAD.l + ((CHART_W - PAD.l - PAD.r) * i) / Math.max(1, annRevProfit.xLabels.length - 1);
            return (
              <text class="fin-dash__xtick" x={xi} y={CHART_H - 18} text-anchor="middle">
                {lab}
              </text>
            );
          })}
        </svg>
        <script type="application/json" data-fin-chart-spec set:html={JSON.stringify(annRevProfit.tooltipSpec)} />
      </div>
    </figure>

    <figure class="fin-dash__chart">
      <p class="fin-dash__sl">{annMargins.title}（{annMargins.unit}）</p>
      <ul class="fin-dash__legend">
        {annMargins.paths.map((p) => (
          <li>
            <span class="fin-dash__leg-dot" style={`background:${p.color}`} />
            {p.name}
          </li>
        ))}
      </ul>
      <div class="fin-dash__canvas-wrap fin-dash__canvas-wrap--mar">
        <svg class="fin-dash__svg" viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <line class="fin-dash__axis-spine" x1={PAD.l} y1={PAD.t} x2={PAD.l} y2={PLOT_BOTTOM} />
          <line class="fin-dash__axis-spine" x1={PAD.l} y1={PLOT_BOTTOM} x2={PLOT_R} y2={PLOT_BOTTOM} />
          {annMargins.tickVals.map((tv) => {
            const yy = annMargins.y(tv);
            return (
              <g>
                <line class="fin-dash__grid" x1={PAD.l} x2={CHART_W - PAD.r} y1={yy} y2={yy} />
                <text class="fin-dash__ytick" x={PAD.l - 10} y={yy + 4} text-anchor="end">
                  {tv.toFixed(1)}%
                </text>
              </g>
            );
          })}
          {annMargins.paths.map((p) => (
            <path
              d={p.d}
              fill="none"
              stroke={p.color}
              stroke-width="2"
              stroke-dasharray={p.strokeDasharray}
            />
          ))}
          {annMargins.pointDots.flatMap((dots) =>
            dots.map((d) => <circle cx={d.cx} cy={d.cy} r="3.5" fill={d.color} />)
          )}
          {annMargins.xLabels.map((lab, i) => {
            const xi = PAD.l + ((CHART_W - PAD.l - PAD.r) * i) / Math.max(1, annMargins.xLabels.length - 1);
            return (
              <text class="fin-dash__xtick" x={xi} y={CHART_H - 18} text-anchor="middle">
                {lab}
              </text>
            );
          })}
        </svg>
        <script type="application/json" data-fin-chart-spec set:html={JSON.stringify(annMargins.tooltipSpec)} />
      </div>
    </figure>

    {
      annEpsBars && (
        <figure class="fin-dash__chart">
          <p class="fin-dash__sl">{annEpsBars.title}</p>
          <ul class="fin-dash__legend">
            <li>
              <span class="fin-dash__leg-dot" style="background:#BA7517" />EPS（元／股）
            </li>
          </ul>
          <div class="fin-dash__canvas-wrap fin-dash__canvas-wrap--qni">
            <svg class="fin-dash__svg" viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <line class="fin-dash__axis-spine" x1={PAD.l} y1={PAD.t} x2={PAD.l} y2={PLOT_BOTTOM} />
              <line class="fin-dash__axis-spine" x1={PAD.l} y1={PLOT_BOTTOM} x2={PLOT_R} y2={PLOT_BOTTOM} />
              {
                annEpsBars.hasNegative && (
                  <line
                    class="fin-dash__grid fin-dash__grid--zero"
                    x1={PAD.l}
                    x2={PLOT_R}
                    y1={annEpsBars.baselineY}
                    y2={annEpsBars.baselineY}
                  />
                )
              }
              {annEpsYTickMarks.map(({ v, yy }) => {
                if (!annEpsBars.hasNegative && noPositiveMax(annEpsBars.maxV)) return null;
                return (
                  <g>
                    <line class="fin-dash__grid" x1={PAD.l} y1={yy} x2={PLOT_R} y2={yy} />
                    <text class="fin-dash__ytick" x={PAD.l - 10} y={yy + 4} text-anchor="end">
                      {v.toFixed(2)} 元
                    </text>

                    fill={b.fill}
                    fill-opacity={annEpsBars.fillOpacity}
                    stroke={b.stroke}
                    stroke-width="1.5"
                  />
                ) : null
              )}
              {annEpsBars.xLabels.map((lab, i) => {
                // 柱狀圖:標籤對齊「柱心」(band 置中),非線圖的 i/(n-1) 點定位
                const slot = (CHART_W - PAD.l - PAD.r) / annEpsBars.xLabels.length;
                const xi = PAD.l + slot * i + slot / 2;
                return (
                  <text class="fin-dash__xtick" x={xi} y={CHART_H - 18} text-anchor="middle">
                    {lab}
                  </text>
                );
              })}
            </svg>
            <script type="application/json" data-fin-chart-spec set:html={JSON.stringify(annEpsBars.tooltipSpec)} />

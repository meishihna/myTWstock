---
import type { FinancialsJson, IndustryType } from "../lib/financialsJson";
import {
  areaFillUnderLineD,
  bestQuarterlyBlock,
  buildAnnualKpis,
  computeLineGeometry,
  DASHBOARD_ANNUAL_MAX_PERIODS,
  DASHBOARD_QUARTERLY_MAX_PERIODS,
  linePathD,
  tailBlock,
  withAnnualEpsFromQuarterlySum,
  type TailedBlock,
} from "../lib/financialDashboard";
import {
  getIndustryConfig,
  REVENUE_LINE_COLORS,
  REVENUE_LINE_DASHES,
  REVENUE_LINE_LABELS,
  MARGIN_LINE_COLORS,
  MARGIN_LINE_DASHES,
  MARGIN_LINE_LABELS,
} from "../lib/industryConfig";
import type { ChipsRow } from "../lib/chipsSnapshot";
import type { ChipsHistory } from "../lib/chipsHistory";

interface Props {
  financialsJson: FinancialsJson;
  companyName: string;
  ticker: string;
  industryType?: IndustryType | string;
  chips?: ChipsRow | null;
  chipsDate?: string | null;
  chipsHistory?: ChipsHistory | null;
}

const { financialsJson, companyName, ticker, industryType, chips, chipsDate, chipsHistory } =
  Astro.props;
const indCfg = getIndustryConfig(industryType);

// ── 籌碼面分頁(三大法人最新一日 + 融資融券)──
const chipsInst = chips?.inst ?? null;
const chipsMargin = chips?.margin ?? null;
const chipsHolders = chips?.holders ?? null;
const chipsForeignHold = chips?.foreignHold ?? null;
// 走勢圖最後一日的三大法人若與上方卡片同一交易日 → 四欄都改用卡片值(T86 盤後會修正,統一以卡片為準)
let chipsHistoryAligned = chipsHistory;
if (chipsHistory?.inst && chipsInst && chipsDate && chipsHistory.inst.dates.length) {
  const ds = chipsHistory.inst.dates;
  const li = ds.length - 1;
  if (ds[li] === chipsDate.replace(/-/g, "")) {
    const inst = {
      ...chipsHistory.inst,
      foreign: chipsHistory.inst.foreign.slice(),
      trust: chipsHistory.inst.trust.slice(),
      dealer: chipsHistory.inst.dealer.slice(),
      net3: chipsHistory.inst.net3.slice(),
    };
    if (chipsInst.foreign != null) inst.foreign[li] = chipsInst.foreign;
    if (chipsInst.trust != null) inst.trust[li] = chipsInst.trust;
    if (chipsInst.dealer != null) inst.dealer[li] = chipsInst.dealer;
    if (chipsInst.net3 != null) inst.net3[li] = chipsInst.net3;
    chipsHistoryAligned = { ...chipsHistory, inst };
  }
}
const hasChips = Boolean(chipsInst || chipsMargin || chipsHolders);
const fmtLot = (n: number | null | undefined) =>
  n == null || !Number.isFinite(n) ? "—" : n.toLocaleString("zh-TW");
const fmtSignedLot = (n: number | null | undefined) =>
  n == null || !Number.isFinite(n) ? "—" : (n > 0 ? "+" : "") + n.toLocaleString("zh-TW");
// 買賣超／增減:買超或增(正)＝紅、賣超或減(負)＝綠(紅漲綠跌)
const netColorStyle = (n: number | null | undefined) =>
  n == null || !Number.isFinite(n) || n === 0 ? "" : n > 0 ? "color:#e24b4a" : "color:#1d9e75";
const fmtPct1 = (n: number | null | undefined) =>
  n == null || !Number.isFinite(n) ? "—" : `${n.toFixed(1)}%`;
// 大戶持股週增減(pp):本週 pct − 上週 pct;無上週資料 → null
const wkDeltaPpt = (lvl?: { pct: number | null; prevPct: number | null } | null) => {
  if (!lvl || lvl.pct == null || lvl.prevPct == null) return null;
  const d = lvl.pct - lvl.prevPct;
  return Number.isFinite(d) ? d : null;
};
const fmtPpt = (d: number | null) =>
  d == null ? null : `${d > 0 ? "+" : ""}${d.toFixed(2)}pp`;
const instCells = chipsInst
  ? [
      { label: "外資", v: chipsInst.foreign, hold: chipsForeignHold, role: "foreign" },
      { label: "投信", v: chipsInst.trust, hold: null, role: "trust" },
      { label: "自營商", v: chipsInst.dealer, hold: null, role: "dealer" },
      { label: "三大法人合計", v: chipsInst.net3, hold: null, role: "net3" },
    ]
  : [];

const CHART_W = 920;
const CHART_H = 300;
/**
 * 左側預留固定寬度給 Y 軸（大位數、EPS「元」等），所有圖共用同一 PAD，
 * 縱軸與繪圖區左緣在畫面上才能對齊。
 */
const PAD = { l: 118, r: 28, t: 32, b: 52 };

const annual = withAnnualEpsFromQuarterlySum(
  tailBlock(financialsJson.annual, DASHBOARD_ANNUAL_MAX_PERIODS, "year")!,
  financialsJson
);
const qSrc = bestQuarterlyBlock(financialsJson);
const quarterly = qSrc
  ? tailBlock(qSrc, DASHBOARD_QUARTERLY_MAX_PERIODS)
  : null;

const annualKpis = buildAnnualKpis(annual, financialsJson.valuation, industryType);

type LineSpec = {
  name: string;
  values: (number | null)[];
  color: string;
  strokeDasharray?: string;
};

function lineChartSvg(
  xLabels: string[],
  specs: LineSpec[],
  unit: string,
  title: string,
  includeZero = true,
  opts?: { fillFirstSeriesArea?: boolean }
) {
  const seriesList = specs.map((s) => ({ values: s.values }));
  const geo = computeLineGeometry(
    xLabels,
    seriesList,
    CHART_W,
    CHART_H,
    PAD,
    { includeZero }
  );
  const { x, y, minY, maxY } = geo;
  const bottomY = y(minY);
  const revenueFillD =
    opts?.fillFirstSeriesArea && specs[0]
      ? areaFillUnderLineD(specs[0].values, x, y, bottomY)
      : undefined;
  const pointDots = specs.map((s) => {
    const arr: { cx: number; cy: number; color: string }[] = [];
    for (let i = 0; i < s.values.length; i++) {
      const v = s.values[i];
      if (v == null || !Number.isFinite(v)) continue;
      arr.push({ cx: x(i), cy: y(v), color: s.color });
    }
    return arr;
  });
  const paths = specs.map((s) => ({
    d: linePathD(s.values, x, y),
    color: s.color,
    strokeDasharray: s.strokeDasharray,
    name: s.name,
  }));
  const yTicks = 4;
  const tickVals: number[] = [];
  for (let i = 0; i <= yTicks; i++) {
    tickVals.push(minY + ((maxY - minY) * i) / yTicks);
  }
  const valueFormat = unit === "%" ? "pct" : "int";
  const tooltipSpec = {
    kind: "line" as const,
    valueFormat,
    xLabels,
    series: specs.map((s) => ({ name: s.name, color: s.color, values: s.values })),
    minY,
    maxY,
    pad: PAD,
    w: CHART_W,
    h: CHART_H,
  };
  return {
    paths,
    xLabels,
    minY,
    maxY,
    tickVals,
    y,
    unit,
    title,
    revenueFillD,
    pointDots,
    tooltipSpec,
  };
}

const annRevProfit = lineChartSvg(
  annual.xLabels,
  indCfg.revenueSeries.map((key) => ({
    name: REVENUE_LINE_LABELS[key] ?? key,
    values: annual.series[key] ?? [],
    color: REVENUE_LINE_COLORS[key] ?? "#888",
    strokeDasharray: REVENUE_LINE_DASHES[key],
  })),
  "百萬元",
  "營收與獲利",
  true,
  { fillFirstSeriesArea: true }
);

const annMargins = lineChartSvg(
  annual.xLabels,
  indCfg.marginSeries.map((key) => ({
    name: MARGIN_LINE_LABELS[key] ?? key,
    values: annual.series[key] ?? [],
    color: MARGIN_LINE_COLORS[key] ?? "#888",
    strokeDasharray: MARGIN_LINE_DASHES[key],
  })),
  "%",
  "利潤率趨勢",
  true
);

let annEpsBars: ReturnType<typeof barChartMillion> | null = null;

let qMargins: ReturnType<typeof lineChartSvg> | null = null;
let qRevGrouped: ReturnType<typeof groupedTwoSvg> | null = null;
let qRevSimple: ReturnType<typeof barChartMillion> | null = null;
let qNiBars: ReturnType<typeof barChartNetSigned> | null = null;
let qEpsBars: ReturnType<typeof barChartMillion> | null = null;
let qYoy: ReturnType<typeof lineChartSvg> | null = null;
let qExpenseStack: ReturnType<typeof stackedExpensePctSvg> | null = null;

const NEG_BAR = "#D85A30";

function barChartMillion(
  xLabels: string[],
  values: (number | null)[],
  title: string,
  barColor: string,
  barOpts?: {
    stroke?: string;
    fillOpacity?: number;
    tooltipFormat?: "eps" | "int";
    tooltipLabel?: string;
  }
) {
  const finite = values
    .map((v, i) => ({ v, i }))
    .filter((o) => o.v != null && Number.isFinite(o.v!)) as { v: number; i: number }[];
  let maxV = finite.length ? Math.max(...finite.map((o) => Math.abs(o.v)), 1) : 1;
  maxV *= 1.08;
  const hasNegative = values.some((v) => v != null && Number.isFinite(v) && v < 0);
  const innerW = CHART_W - PAD.l - PAD.r;
  const innerH = CHART_H - PAD.t - PAD.b;
  /** 含負值時零線置中，正／負各用半高，避免負柱超出圖底 */
  const plotHalf = hasNegative ? innerH / 2 : innerH;
  const baselineY = hasNegative ? PAD.t + plotHalf : PAD.t + innerH;
  const n = xLabels.length;
  const gap = 0.2;
  const bw = (innerW / n) * (1 - gap);
  const strokePos = barOpts?.stroke ?? barColor;
  const bars = values.map((v, i) => {
    if (v == null || !Number.isFinite(v)) return null;
    const h = (Math.abs(v) / maxV) * plotHalf;
    const x0 = PAD.l + (innerW * i) / n + (innerW / n - bw) / 2;
    const pos = v >= 0;
    const y0 = pos ? baselineY - h : baselineY;
    return {
      x: x0,
      y: y0,
      w: bw,
      h: Math.max(h, 2),
      v,
      fill: pos ? barColor : NEG_BAR,
      stroke: pos ? strokePos : NEG_BAR,
    };
  });
  const vf = barOpts?.tooltipFormat === "eps" ? "eps" : "int";
  const tooltipSpec = {
    kind: "simpleBar" as const,
    valueFormat: vf,
    valueLabel:
      barOpts?.tooltipLabel ??
      (barOpts?.tooltipFormat === "eps" ? "EPS" : "淨利"),
    xLabels,
    values,
    pad: PAD,
    w: CHART_W,
    h: CHART_H,
  };
  return {
    bars,
    xLabels,
    maxV,
    title,
    barColor,
    barStroke: strokePos,
    fillOpacity: barOpts?.fillOpacity ?? 0.55,
    innerH: innerH + PAD.t,
    tooltipSpec,
    baselineY,
    scaleMax: maxV,
    hasNegative,
  };
}

function barChartNetSigned(
  xLabels: string[],
  values: (number | null)[],
  chartTitle = "季度淨利（Quarterly net income）"
) {
  const innerW = CHART_W - PAD.l - PAD.r;
  const innerH = CHART_H - PAD.t - PAD.b;
  const n = xLabels.length;
  let maxV = 1;
  for (const v of values) {
    if (v != null && Number.isFinite(v)) maxV = Math.max(maxV, Math.abs(v));
  }
  maxV *= 1.08;
  const hasNegative = values.some((v) => v != null && Number.isFinite(v) && v < 0);
  const plotHalf = hasNegative ? innerH / 2 : innerH;
  const baselineY = hasNegative ? PAD.t + plotHalf : PAD.t + innerH;
  const gap = 0.2;
  const bw = (innerW / n) * (1 - gap);
  const bars = values.map((v, i) => {
    if (v == null || !Number.isFinite(v)) return null;
    const h = (Math.abs(v) / maxV) * plotHalf;
    const x0 = PAD.l + (innerW * i) / n + (innerW / n - bw) / 2;
    const pos = v >= 0;
    const y0 = pos ? baselineY - h : baselineY;
    return {
      x: x0,
      y: y0,
      w: bw,
      h: Math.max(h, 2),
      fill: pos ? "#7F77DD" : "#D85A30",
      fillOpacity: 0.33,
      stroke: pos ? "#7F77DD" : "#D85A30",
    };
  });
  const rawVals = values;
  const tooltipSpec = {
    kind: "signedBar" as const,
    xLabels,
    values: rawVals,
    pad: PAD,
    w: CHART_W,
    h: CHART_H,
  };
  return {
    bars,
    xLabels,
    n,
    title: chartTitle,
    baselineY,
    scaleMax: maxV,
    hasNegative,
    tooltipSpec,
  };
}

function seriesHasFinite(row: (number | null)[] | undefined): boolean {
  return Boolean(row?.some((v) => v != null && Number.isFinite(v)));
}

if (seriesHasFinite(annual.series.EPS)) {
  annEpsBars = barChartMillion(
    annual.xLabels,
    annual.series.EPS ?? [],
    "年度 EPS（Annual EPS）",
    "#BA7517",
    { stroke: "#BA7517", fillOpacity: 0.35, tooltipFormat: "eps" as const, tooltipLabel: "EPS" }
  );
}

// 現金流量(營業/投資/籌資)三線圖 —— 資料早已存在 store,過去未繪。可為負,includeZero 確保零基準。
const CF_KEYS = ["Op Cash Flow", "Investing Cash Flow", "Financing Cash Flow"] as const;
const CF_LABELS: Record<string, string> = {
  "Op Cash Flow": "營業現金流",
  "Investing Cash Flow": "投資現金流",
  "Financing Cash Flow": "籌資現金流",
};
const CF_COLORS: Record<string, string> = {
  "Op Cash Flow": "#1D9E75",
  "Investing Cash Flow": "#D85A30",
  "Financing Cash Flow": "#7F77DD",
};
let annCashFlow: ReturnType<typeof lineChartSvg> | null = null;
if (CF_KEYS.some((k) => seriesHasFinite(annual.series[k]))) {
  annCashFlow = lineChartSvg(
    annual.xLabels,
    CF_KEYS.map((k) => ({
      name: CF_LABELS[k],
      values: annual.series[k] ?? [],

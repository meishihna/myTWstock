              {annCashFlow.pointDots.flatMap((dots) =>
                dots.map((d) => <circle cx={d.cx} cy={d.cy} r="3.5" fill={d.color} />)
              )}
              {annCashFlow.xLabels.map((lab, i) => {
                const xi = PAD.l + ((CHART_W - PAD.l - PAD.r) * i) / Math.max(1, annCashFlow.xLabels.length - 1);
                return (
                  <text class="fin-dash__xtick" x={xi} y={CHART_H - 18} text-anchor="middle">
                    {lab}
                  </text>

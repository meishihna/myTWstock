            <script type="application/json" data-fin-chart-spec set:html={JSON.stringify(annCashFlow.tooltipSpec)} />
          </div>
        </figure>
      )
    }

    </div>
  </div>

  {
    quarterly && qNiBars && (qRevGrouped || qRevSimple) && (
      <div class="fin-dash__panel" data-fin-panel="quarterly" hidden>
        <div class="fin-dash__chart-grid">
        {qRevGrouped && (
          <figure class="fin-dash__chart">
            <p class="fin-dash__sl">{qRevGrouped.title}（百萬元）</p>
            <ul class="fin-dash__legend">
              <li>
                <span class="fin-dash__leg-dot" style="background:#378ADD" />{qRevGrouped.nameA}
              </li>
              <li>
                <span class="fin-dash__leg-dot" style="background:#1D9E75" />{qRevGrouped.nameB}
              </li>
            </ul>
            <div class="fin-dash__canvas-wrap fin-dash__canvas-wrap--tall">
              <svg class="fin-dash__svg" viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">

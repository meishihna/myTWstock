                    <span class="fin-dash__kpi-label">{c.label}</span>
                    <span class="fin-dash__kpi-value" data-chip-role={c.role} style={netColorStyle(c.v)}>
                      {fmtSignedLot(c.v)}
                    </span>
                  </div>
                  <div class="chips-hold">
                    <span class="fin-dash__kpi-label">持股</span>
                    <span class="chips-hold-pct" data-chip-hold>{c.hold.pct.toFixed(2)}%</span>
                    <span
                      class="chips-hold-chg"
                      data-chip-holdchg
                      style={c.hold.chgPp != null ? netColorStyle(c.hold.chgPp) : "display:none"}
                    >
                      {c.hold.chgPp != null
                        ? `${c.hold.chgPp > 0 ? "▲" : c.hold.chgPp < 0 ? "▼" : ""} ${Math.abs(c.hold.chgPp).toFixed(2)}pp`
                        : ""}
                    </span>
                  </div>
                </div>
              ) : (
                <div class="fin-dash__kpi-card">
                  <span class="fin-dash__kpi-label">{c.label}</span>
                  <span class="fin-dash__kpi-value" data-chip-role={c.role} style={netColorStyle(c.v)}>
                    {fmtSignedLot(c.v)}
                  </span>
                </div>
              ),
            )}
          </div>
        </figure>
      ) : (
        <p class="fin-dash__sl">三大法人：上櫃個股暫無全市場免費資料(待後續優化補上)。</p>
      )}
      {chipsHistory?.inst && (
        <figure class="fin-dash__chart">
          <div class="chips-trend" data-chips-trend="inst" />
        </figure>
      )}
      {chipsMargin && (
        <figure class="fin-dash__chart">
          <p class="fin-dash__sl">融資融券餘額（單位：張）</p>
          <div class="fin-dash__kpi-row fin-dash__kpi-row--4">
            <div class="fin-dash__kpi-card">
              <span class="fin-dash__kpi-label">融資餘額</span>
              <span class="fin-dash__kpi-value">{fmtLot(chipsMargin.bal)}</span>
              <span class="fin-dash__kpi-delta" style={netColorStyle(chipsMargin.chg)}>
                日增減 {fmtSignedLot(chipsMargin.chg)}
              </span>
            </div>
            <div class="fin-dash__kpi-card">
              <span class="fin-dash__kpi-label">融券餘額</span>
              <span class="fin-dash__kpi-value">{fmtLot(chipsMargin.shortBal)}</span>
              <span class="fin-dash__kpi-delta" style={netColorStyle(chipsMargin.shortChg)}>
                日增減 {fmtSignedLot(chipsMargin.shortChg)}
              </span>
            </div>
          </div>
        </figure>
      )}
      {chipsHolders && (
        <figure class="fin-dash__chart">
          <p class="fin-dash__sl">
            大戶持股{chipsHolders.date ? `（集保 ${chipsHolders.date}）` : ""}（占集保比例;增紅減綠）
          </p>
          <div class="fin-dash__kpi-row fin-dash__kpi-row--4">
            <div class="fin-dash__kpi-card">
              <span class="fin-dash__kpi-label">千張大戶持股</span>
              <span class="fin-dash__kpi-value">{fmtPct1(chipsHolders.k1000.pct)}</span>
              {wkDeltaPpt(chipsHolders.k1000) != null && (
                <span class="fin-dash__kpi-delta" style={netColorStyle(wkDeltaPpt(chipsHolders.k1000))}>
                  週 {fmtPpt(wkDeltaPpt(chipsHolders.k1000))}
                </span>
              )}
            </div>
            <div class="fin-dash__kpi-card">
              <span class="fin-dash__kpi-label">千張大戶人數</span>
              <span class="fin-dash__kpi-value">{fmtLot(chipsHolders.k1000.people)}</span>
            </div>
            <div class="fin-dash__kpi-card">
              <span class="fin-dash__kpi-label">400張大戶持股</span>
              <span class="fin-dash__kpi-value">{fmtPct1(chipsHolders.k400.pct)}</span>
              {wkDeltaPpt(chipsHolders.k400) != null && (
                <span class="fin-dash__kpi-delta" style={netColorStyle(wkDeltaPpt(chipsHolders.k400))}>
                  週 {fmtPpt(wkDeltaPpt(chipsHolders.k400))}
                </span>
              )}
            </div>
            <div class="fin-dash__kpi-card">
              <span class="fin-dash__kpi-label">400張大戶人數</span>
              <span class="fin-dash__kpi-value">{fmtLot(chipsHolders.k400.people)}</span>
            </div>
          </div>
        </figure>
      )}
      {chipsHistory?.holders && (
        <figure class="fin-dash__chart">
          <div class="chips-trend" data-chips-trend="holders" />
        </figure>
      )}
      {chipsHistory && (chipsHistory.inst || chipsHistory.holders) && (
        <script type="application/json" data-chips-history set:html={JSON.stringify({ ticker, ...chipsHistoryAligned })} />
      )}
    </div>
  </div>
</section>
</div>

<script is:inline src="/scripts/fin-dash-charts.js"></script>

<script>
  (function () {
    const root = document.querySelector("[data-fin-dash]");
    if (!root) return;
    const tabs = root.querySelectorAll("[data-fin-tab]");
    const panels = root.querySelectorAll("[data-fin-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-fin-tab");
        if (!key || tab.hasAttribute("disabled")) return;
        tabs.forEach((t) => {
          const on = t.getAttribute("data-fin-tab") === key;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach((p) => {
          const match = p.getAttribute("data-fin-panel") === key;
          p.classList.toggle("is-active", match);
          if (match) p.removeAttribute("hidden");
          else p.setAttribute("hidden", "");
        });
      });
    });
  })();
</script>

<script>
  // 籌碼面走勢圖:三大法人(柱)+ 股價(線);千張/400張大戶(線)+ 股價(線)。
  // 歷史(三大法人/大戶)由頁面嵌入;股價即時抓 /api/bars/[ticker]。各序列各自縮放套疊。
  (function () {
    const holder = document.querySelector("[data-chips-history]");
    if (!holder) return;
    let H;
    try { H = JSON.parse(holder.textContent || "{}"); } catch { return; }
    if (!H.ticker) return;

    const W = 720, HT = 210, P = { l: 12, r: 12, t: 18, b: 22 };
    const pw = W - P.l - P.r, ph = HT - P.t - P.b;
    const UP = "#e24b4a", DOWN = "#1d9e75", GOLD = "#d6a64a", BLUE = "#4a9ed6", PURP = "#b07bd6";
    const p2 = (n) => (n < 10 ? "0" : "") + n;
    const toYmd = (t) => {
      if (t == null) return "";
      if (typeof t === "number") { const d = new Date(t > 1e11 ? t : t * 1000); return "" + d.getFullYear() + p2(d.getMonth() + 1) + p2(d.getDate()); }
      return String(t).slice(0, 10).replace(/-/g, "");
    };
    const xAt = (i, n) => P.l + (n <= 1 ? pw / 2 : (pw * i) / (n - 1));
    const sY = (v, mn, mx) => (mx === mn ? P.t + ph / 2 : P.t + ph - ((v - mn) / (mx - mn)) * ph);
    // 缺值不斷線:跳過 null、把前後有效點直接相連(股價偶有單日缺、大戶為週點,皆連續呈現)
    const linePath = (pts) => { let d = "", on = false; for (const p of pts) { if (!p) continue; d += (on ? " L" : "M") + p.x.toFixed(1) + " " + p.y.toFixed(1); on = true; } return d; };
    const xticks = (dates) => { const n = dates.length, s = Math.max(1, Math.floor(n / 5)), o = []; for (let i = 0; i < n; i += s) { const d = dates[i]; o.push(`<text x="${xAt(i, n).toFixed(1)}" y="${HT - 6}" class="ct-x">${d.slice(4, 6)}/${d.slice(6, 8)}</text>`); } return o.join(""); };
    const priceLine = (dates, pbd) => { const cl = dates.map((d) => pbd[d]); const fin = cl.filter((v) => v != null && isFinite(v)); if (fin.length < 2) return ""; const mn = Math.min(...fin), mx = Math.max(...fin), n = dates.length; const pts = cl.map((v, i) => (v == null || !isFinite(v) ? null : { x: xAt(i, n), y: sY(v, mn, mx) })); return `<path d="${linePath(pts)}" fill="none" stroke="${GOLD}" stroke-width="1.6"/>`; };

    // ── 互動 tooltip + 十字準星(共用) ──
    let _tip;
    const getTip = () => { if (_tip) return _tip; _tip = document.createElement("div"); _tip.className = "ct-tip"; _tip.style.display = "none"; document.body.appendChild(_tip); return _tip; };
    const fmtDate = (y) => (y && y.length >= 8 ? y.slice(0, 4) + "/" + y.slice(4, 6) + "/" + y.slice(6, 8) : y);
    function attachHover(el, model, hooks) {
      const svg = el.querySelector("svg"); if (!svg) return;
      const NS = "http://www.w3.org/2000/svg";
      const cross = document.createElementNS(NS, "line");
      cross.setAttribute("y1", P.t); cross.setAttribute("y2", P.t + ph);
      cross.setAttribute("stroke", "rgba(255,255,255,.32)"); cross.setAttribute("stroke-dasharray", "3 3");
      cross.style.display = "none"; svg.appendChild(cross);
      const tip = getTip();
      el.addEventListener("mousemove", (e) => {
        const r = svg.getBoundingClientRect();
        const vx = ((e.clientX - r.left) / r.width) * W;
        let i = Math.round(((vx - P.l) / pw) * (model.n - 1));
        i = Math.max(0, Math.min(model.n - 1, i));
        const cx = xAt(i, model.n);
        cross.setAttribute("x1", cx); cross.setAttribute("x2", cx); cross.style.display = "";
        let html = `<div class="ct-tip-d">${fmtDate(model.dates[i])}</div>`;
        for (const s of model.series) {
          const v = s.values[i];
          const col = s.signColor ? (v == null ? "#999" : v > 0 ? UP : DOWN) : s.color;
          html += `<div class="ct-tip-r"><i style="background:${col}"></i>${s.label} <b>${v == null || !isFinite(v) ? "—" : s.fmt(v)}</b></div>`;
        }
        tip.innerHTML = html; tip.style.display = "block";
        tip.style.left = Math.min(e.clientX + 14, window.innerWidth - 170) + "px";
        tip.style.top = (e.clientY + 14) + "px";
        if (hooks && hooks.onIndex) hooks.onIndex(i);
      });
      el.addEventListener("mouseleave", () => { cross.style.display = "none"; tip.style.display = "none"; if (hooks && hooks.onLeave) hooks.onLeave(); });
    }
    const fmtLots = (v) => (v > 0 ? "+" : "") + Math.round(v).toLocaleString() + " 張";
    const fmtPrice = (v) => Number(v).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtPct = (v) => v.toFixed(2) + "%";

    // ── hover 三大法人圖 → 上方四卡 + 外資持股 跟著顯示該日;移開復原最新日 ──
    const ROLE = H.inst ? { foreign: H.inst.foreign, trust: H.inst.trust, dealer: H.inst.dealer, net3: H.inst.net3 } : {};
    const fmtCard = (v) => (v == null || !isFinite(v) ? "—" : (v > 0 ? "+" : "") + Math.round(v).toLocaleString());
    const dateDash = (y) => (y && y.length >= 8 ? y.slice(0, 4) + "-" + y.slice(4, 6) + "-" + y.slice(6, 8) : y);
    const snap = [];
    document.querySelectorAll("[data-chip-role],[data-chip-date],[data-chip-hold],[data-chip-holdchg]")
      .forEach((el) => snap.push({ el, t: el.textContent, c: el.style.color, d: el.style.display }));
    function setCards(i) {
      for (const role in ROLE) {
        const el = document.querySelector('[data-chip-role="' + role + '"]'); if (!el) continue;
        const v = ROLE[role][i]; el.textContent = fmtCard(v);
        el.style.color = (v == null || v === 0) ? "" : (v > 0 ? UP : DOWN);
      }
      const de = document.querySelector("[data-chip-date]"); if (de && H.inst) de.textContent = dateDash(H.inst.dates[i]);
      const hp = H.holdPct ? H.holdPct[i] : null;
      const he = document.querySelector("[data-chip-hold]"); if (he) he.textContent = (hp == null || !isFinite(hp)) ? "—" : hp.toFixed(2) + "%";
      const ce = document.querySelector("[data-chip-holdchg]");
      if (ce) {
        const pv = (H.holdPct && i > 0) ? H.holdPct[i - 1] : null;
        const ch = (hp != null && pv != null) ? hp - pv : null;
        if (ch == null) { ce.style.display = "none"; }
        else { ce.style.display = ""; ce.textContent = (ch > 0 ? "▲" : ch < 0 ? "▼" : "") + " " + Math.abs(ch).toFixed(2) + "pp"; ce.style.color = (ch > 0 ? UP : ch < 0 ? DOWN : ""); }
      }
    }
    function restoreCards() { for (const s of snap) { s.el.textContent = s.t; s.el.style.color = s.c; s.el.style.display = s.d; } }

    function drawInst(el, dates, net3, pbd) {
      const n = dates.length, am = Math.max(1, ...net3.map((v) => (v == null ? 0 : Math.abs(v)))), zy = P.t + ph / 2, bw = Math.max(1.5, (pw / n) * 0.62);
      let bars = "";
      for (let i = 0; i < n; i++) { const v = net3[i]; if (v == null || !isFinite(v)) continue; const h = (Math.abs(v) / am) * (ph / 2); const x = xAt(i, n) - bw / 2; const y = v >= 0 ? zy - h : zy; bars += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(h, 0.5).toFixed(1)}" fill="${v >= 0 ? UP : DOWN}" opacity="0.85"/>`; }
      el.innerHTML = `<svg viewBox="0 0 ${W} ${HT}" class="ct-svg"><line x1="${P.l}" x2="${W - P.r}" y1="${zy}" y2="${zy}" stroke="rgba(255,255,255,.16)"/>${bars}${priceLine(dates, pbd)}${xticks(dates)}</svg>`;
      attachHover(el, { dates, n, series: [
        { label: "三大法人", signColor: true, values: net3, fmt: fmtLots },
        { label: "股價", color: GOLD, values: dates.map((d) => pbd[d] ?? null), fmt: fmtPrice },
      ] }, { onIndex: setCards, onLeave: restoreCards });
    }
    function drawHolders(el, xdates, hdates, k1000, k400, pbd) {
      const n = xdates.length, idx = {}; xdates.forEach((d, i) => (idx[d] = i));
      const map = (vals) => { const a = new Array(n).fill(null); hdates.forEach((d, j) => { const i = idx[d]; if (i != null && vals[j] != null) a[i] = vals[j]; }); return a; };
      const s1 = map(k1000), s4 = map(k400), all = [...s1, ...s4].filter((v) => v != null && isFinite(v));
      let pct = "";
      if (all.length) { const mn = Math.min(...all), mx = Math.max(...all); const mk = (arr, c) => { const pts = arr.map((v, i) => (v == null ? null : { x: xAt(i, n), y: sY(v, mn, mx) })); const dots = pts.filter(Boolean).map((p) => `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="2.6" fill="${c}"/>`).join(""); return `<path d="${linePath(pts)}" fill="none" stroke="${c}" stroke-width="1.6"/>${dots}`; }; pct = mk(s1, BLUE) + mk(s4, PURP); }
      const note = hdates.length < 2 ? `<text x="${P.l}" y="${P.t + 4}" class="ct-note">大戶累積中（目前 ${hdates.length} 週）</text>` : "";
      el.innerHTML = `<svg viewBox="0 0 ${W} ${HT}" class="ct-svg">${priceLine(xdates, pbd)}${pct}${note}${xticks(xdates)}</svg>`;
      attachHover(el, { dates: xdates, n, series: [
        { label: "千張大戶", color: BLUE, values: s1, fmt: fmtPct },
        { label: "400張大戶", color: PURP, values: s4, fmt: fmtPct },
        { label: "股價", color: GOLD, values: xdates.map((d) => pbd[d] ?? null), fmt: fmtPrice },
      ] });
    }

    fetch("/api/bars/" + encodeURIComponent(H.ticker)).then((r) => (r.ok ? r.json() : null)).then((j) => {
      const pbd = {};
      if (j && j.bars) for (const b of j.bars) { const d = toYmd(b.time); if (d) pbd[d] = b.close; }
      const ie = document.querySelector('[data-chips-trend="inst"]');
      if (ie && H.inst) drawInst(ie, H.inst.dates, H.inst.net3, pbd);
      const he = document.querySelector('[data-chips-trend="holders"]');
      if (he && H.holders) drawHolders(he, (H.inst && H.inst.dates) || H.holders.dates, H.holders.dates, H.holders.k1000, H.holders.k400, pbd);
    }).catch(() => {});
  })();
</script>

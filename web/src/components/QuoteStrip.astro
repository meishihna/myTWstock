---
import { getPrice } from "../lib/priceCache";
import { QUOTE } from "../lib/ui";

interface Props {
  ticker: string;
}

const { ticker } = Astro.props;

// 向 Yahoo 取數:供價格 header 與持股／殖利率資訊列。
// 走勢圖（含區間選擇與互動 OHLCV）由前端 Lightweight Charts 讀 /api/bars 繪製。
const priceData = await getPrice(ticker);

const nClose = priceData?.close.length ?? 0;
const headlineClose =
  nClose >= 1 && priceData ? priceData.close[nClose - 1]! : null;
const prevSessionClose =
  nClose >= 2 && priceData ? priceData.close[nClose - 2]! : null;
const dayChange =
  headlineClose != null && prevSessionClose != null
    ? Math.round((headlineClose - prevSessionClose) * 100) / 100
    : null;
const dayChangePct =
  dayChange != null && prevSessionClose != null && prevSessionClose !== 0
    ? Math.round((dayChange / prevSessionClose) * 10000) / 100
    : null;

const badgeUp = dayChange != null && dayChange > 0;
const badgeDown = dayChange != null && dayChange < 0;
const badgeClass = badgeUp ? "up" : badgeDown ? "down" : "flat";

function fmtPrice(n: number): string {
  return n.toLocaleString("zh-TW", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function fmtPctOrDash(v: number | null | undefined): string {
  if (v == null || !Number.isFinite(v)) return "-";
  return `${v.toFixed(2)}%`;
}

let timeDisplay = "";
if (priceData?.marketTime) {
  try {
    timeDisplay = new Date(priceData.marketTime).toLocaleString("zh-TW", {
      timeZone: "Asia/Taipei",
    });
  } catch {
    timeDisplay = "";
  }
} else if (priceData?.dates?.length) {
  timeDisplay = priceData.dates[priceData.dates.length - 1] ?? "";
}

const chgBigStr =
  dayChange == null
    ? "—"
    : dayChange === 0
      ? fmtPrice(0)
      : (dayChange > 0 ? "+" : "-") + fmtPrice(Math.abs(dayChange));
const chgPctStr =
  dayChangePct == null
    ? "—"
    : (dayChangePct === 0
        ? "0.00"
        : (dayChangePct > 0 ? "+" : "-") + Math.abs(dayChangePct).toFixed(2)) +
      "%";

const ranges: { label: string; months: number }[] = [
  { label: "1月", months: 1 },
  { label: "3月", months: 3 },
  { label: "6月", months: 6 },
  { label: "1年", months: 12 },
  { label: "2年", months: 24 },
];
const defaultMonths = 6;
---

<section class="quote-widget-wrap" aria-label={QUOTE.title}>
  <h2 class="quote-widget-sr-only">{QUOTE.title}</h2>

  {
    priceData ? (
      <div class="quote-widget">
        <div class="quote-top">
          <div class="quote-top-left">
            <div class="quote-price-with-chg">
              <div class="quote-price-block">
                <div class="quote-price">
                  {headlineClose != null
                    ? fmtPrice(headlineClose)
                    : fmtPrice(priceData.latest)}
                </div>
              </div>
              <div class="quote-change-block quote-change-block--next-price">
                <div class={`quote-chg-big ${badgeClass}`}>{chgBigStr}</div>
                <div class={`quote-chg-pct ${badgeClass}`}>{chgPctStr}</div>
              </div>
            </div>
            <div class="quote-sub">NT$ · {ticker}</div>
          </div>
          <div class="quote-top-metrics" aria-label={QUOTE.holdingsStripAria}>
            <div class="quote-metric">
              <span class="quote-metric__label">{QUOTE.insiderHold}</span>
              <span class="quote-metric__value">
                {fmtPctOrDash(priceData.insiderPct)}
              </span>
            </div>
            <div class="quote-metric">
              <span class="quote-metric__label">{QUOTE.instHold}</span>
              <span class="quote-metric__value">
                {fmtPctOrDash(priceData.institutionPct)}
              </span>
            </div>
            <div class="quote-metric">
              <span class="quote-metric__label">{QUOTE.divYield}</span>
              <span class="quote-metric__value">
                {fmtPctOrDash(priceData.divYieldPct)}
              </span>
            </div>
          </div>
        </div>

        <div class="quote-lwc-ranges" role="group" aria-label="日期區間">
          {
            ranges.map((r) => (
              <button
                type="button"
                class:list={["quote-lwc-range", { "is-active": r.months === defaultMonths }]}
                data-months={r.months}
              >
                {r.label}
              </button>
            ))
          }
        </div>

        <div
          class="quote-lwc"
          data-ticker={ticker}
          data-default-months={defaultMonths}
          role="img"
          aria-label={QUOTE.title}
        ></div>

        <div class="quote-foot">
          <div class="quote-ma-legend">
            <span class="quote-ma-legend__item"><i style="background:#F0B429"></i>5MA</span>
            <span class="quote-ma-legend__item"><i style="background:#6BA3E8"></i>10MA</span>
            <span class="quote-ma-legend__item"><i style="background:#B388FF"></i>20MA</span>
          </div>
          <div class="quote-foot__time">
            {QUOTE.delayedShort}
            {timeDisplay ? ` · ${timeDisplay}` : ""}
          </div>
        </div>
      </div>
    ) : (
      <div class="quote-error">
        <p>{QUOTE.error}</p>
        <p>{QUOTE.chartUnavailable}</p>
      </div>
    )
  }
</section>

<script>
  import { createChart, CrosshairMode } from "lightweight-charts";

  interface Bar {
    time: string;
    open: number;
    high: number;
    low: number;
    close: number;
    volume: number;
  }

  function fmtNum(n: number): string {
    return n.toLocaleString("zh-TW", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }
  function fmtVol(v: number): string {
    if (v >= 1e9) return (v / 1e9).toFixed(1) + "B";
    if (v >= 1e6) return (v / 1e6).toFixed(1) + "M";
    if (v >= 1e3) return (v / 1e3).toFixed(0) + "K";
    return String(Math.round(v));
  }
  function sma(bars: Bar[], period: number): { time: string; value: number }[] {
    const out: { time: string; value: number }[] = [];
    for (let i = period - 1; i < bars.length; i++) {
      let s = 0;
      for (let j = i - period + 1; j <= i; j++) s += bars[j]!.close;
      out.push({ time: bars[i]!.time, value: Math.round((s / period) * 100) / 100 });
    }
    return out;
  }
  /** crosshair 的 time 可能是 'YYYY-MM-DD' 字串或 {year,month,day}；統一成字串 key */
  function timeKey(t: unknown): string {
    if (typeof t === "string") return t;
    if (t && typeof t === "object" && "year" in (t as any)) {
      const o = t as { year: number; month: number; day: number };
      return `${o.year}-${String(o.month).padStart(2, "0")}-${String(o.day).padStart(2, "0")}`;
    }
    return String(t);
  }

  async function initQuoteChart(): Promise<void> {
    const el = document.querySelector<HTMLElement>(".quote-lwc[data-ticker]");
    if (!el || el.dataset.lwcInit) return;
    el.dataset.lwcInit = "1";
    const ticker = el.getAttribute("data-ticker");

    let bars: Bar[] = [];
    try {
      const r = await fetch(`/api/bars/${ticker}`);
      const j = await r.json();
      bars = (j.bars as Bar[]) || [];
    } catch {
      /* ignore */
    }
    if (bars.length < 2) {
      el.innerHTML = '<div class="quote-lwc-msg">走勢資料暫時無法載入</div>';
      return;
    }

    const chart = createChart(el, {
      autoSize: true,
      layout: { background: { color: "transparent" }, textColor: "#cbd5e1", fontSize: 11 },
      grid: {
        vertLines: { color: "rgba(255,255,255,0.05)" },
        horzLines: { color: "rgba(255,255,255,0.05)" },
      },
      rightPriceScale: { borderColor: "rgba(255,255,255,0.12)" },
      timeScale: { borderColor: "rgba(255,255,255,0.12)", rightOffset: 4 },
      crosshair: { mode: CrosshairMode.Normal },
    });

    const candle = chart.addCandlestickSeries({
      upColor: "#1D9E75",
      downColor: "#E24B4A",
      borderVisible: false,
      wickUpColor: "#1D9E75",
      wickDownColor: "#E24B4A",
    });
    candle.setData(
      bars.map((b) => ({ time: b.time, open: b.open, high: b.high, low: b.low, close: b.close })),
    );

    const vol = chart.addHistogramSeries({ priceFormat: { type: "volume" }, priceScaleId: "" });
    vol.priceScale().applyOptions({ scaleMargins: { top: 0.82, bottom: 0 } });
    vol.setData(
      bars.map((b) => ({
        time: b.time,
        value: b.volume,
        color: b.close >= b.open ? "rgba(29,158,117,0.45)" : "rgba(226,75,74,0.45)",
      })),
    );

    const maDefs: [number, string][] = [
      [5, "#F0B429"],
      [10, "#6BA3E8"],
      [20, "#B388FF"],
    ];
    for (const [period, color] of maDefs) {
      const line = chart.addLineSeries({
        color,
        lineWidth: 1,
        priceLineVisible: false,
        lastValueVisible: false,
        crosshairMarkerVisible: false,
      });
      line.setData(sma(bars, period));
    }

    // ── 互動式 OHLCV 圖例(隨游標更新,預設最新一根)─────────────
    const legend = document.createElement("div");
    legend.className = "quote-lwc-legend";
    el.appendChild(legend);
    const byTime = new Map(bars.map((b, i) => [b.time, i] as const));
    function renderAt(idx: number): void {
      const b = bars[idx];
      if (!b) return;
      const prev = idx > 0 ? bars[idx - 1]!.close : null;
      const up = b.close >= b.open;
      const col = up ? "#3fd6a0" : "#ff7b78";
      let chg = "";
      if (prev != null && prev !== 0) {
        const d = Math.round((b.close - prev) * 100) / 100;
        const p = (d / prev) * 100;
        const c2 = d >= 0 ? "#5ee9b5" : "#ff9a9a";
        chg = ` <b style="color:${c2}">${d >= 0 ? "+" : ""}${p.toFixed(2)}%</b>`;
      }
      legend.innerHTML =
        `<span class="t">${b.time}</span> 開<b>${fmtNum(b.open)}</b> ` +
        `高<b style="color:${col}">${fmtNum(b.high)}</b> ` +
        `低<b style="color:${col}">${fmtNum(b.low)}</b> ` +
        `收<b style="color:${col}">${fmtNum(b.close)}</b> ` +
        `量<b>${fmtVol(b.volume)}</b>${chg}`;
    }
    renderAt(bars.length - 1);
    chart.subscribeCrosshairMove((param) => {
      if (!param || !param.point || param.time == null) {
        renderAt(bars.length - 1);
        return;
      }
      const idx = byTime.get(timeKey(param.time));
      renderAt(idx == null ? bars.length - 1 : idx);
    });

    // ── 日期區間選擇 ───────────────────────────────────────────
    function applyRange(months: number): void {
      try {
        if (months >= 24) {
          chart.timeScale().fitContent();
          return;
        }
        const lastT = bars[bars.length - 1]!.time;
        const f = new Date(lastT + "T00:00:00Z");
        f.setUTCMonth(f.getUTCMonth() - months);
        chart.timeScale().setVisibleRange({
          from: f.toISOString().split("T")[0]! as any,
          to: lastT as any,
        });
      } catch {
        chart.timeScale().fitContent();
      }
    }
    const section = el.closest(".quote-widget-wrap");
    const btns = section
      ? Array.from(section.querySelectorAll<HTMLButtonElement>(".quote-lwc-range"))
      : [];
    for (const btn of btns) {
      btn.addEventListener("click", () => {
        for (const b of btns) b.classList.remove("is-active");
        btn.classList.add("is-active");
        applyRange(Number(btn.getAttribute("data-months")));
      });
    }
    const defMonths = Number(el.getAttribute("data-default-months")) || 6;
    requestAnimationFrame(() => applyRange(defMonths));
  }

  initQuoteChart();
  document.addEventListener("astro:page-load", initQuoteChart);
</script>

<style>
  .quote-lwc-ranges {
    display: flex;
    gap: 6px;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .quote-lwc-range {
    font-size: 11px;
    line-height: 1;
    padding: 4px 9px;
    border-radius: 6px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.14));
    background: transparent;
    color: var(--muted, #9aa0a6);
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .quote-lwc-range:hover {
    color: var(--fg, #e5e7eb);
  }
  .quote-lwc-range.is-active {
    background: rgba(255, 255, 255, 0.1);
    color: var(--fg, #fff);
    border-color: rgba(255, 255, 255, 0.28);
  }
  .quote-lwc {
    width: 100%;
    height: 380px;
    margin-top: 0.5rem;
    position: relative;
  }
  /* 圖例與訊息為 JS 動態建立,Astro scoped 屬性套不到 → 用 :global()（限定在 .quote-lwc 內) */
  .quote-lwc :global(.quote-lwc-legend) {
    position: absolute;
    top: 6px;
    left: 8px;
    z-index: 3;
    pointer-events: none;
    font-size: 11px;
    font-family: ui-monospace, "SF Mono", monospace;
    color: var(--muted, #aab);
    background: rgba(0, 0, 0, 0.4);
    padding: 3px 7px;
    border-radius: 4px;
    white-space: nowrap;
    max-width: calc(100% - 16px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .quote-lwc :global(.quote-lwc-legend b) {
    color: #e5e7eb;
    font-weight: 500;
  }
  .quote-lwc :global(.quote-lwc-legend .t) {
    color: #9aa0a6;
    margin-right: 5px;
  }
  .quote-lwc :global(.quote-lwc-msg) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--muted, #888);
    font-size: 0.85rem;
  }
  .quote-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.4rem;
    font-size: 11px;
    color: var(--muted, #888);
  }
  .quote-ma-legend {
    display: flex;
    gap: 0.85rem;
  }
  .quote-ma-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .quote-ma-legend__item i {
    display: inline-block;
    width: 12px;
    height: 2px;
    border-radius: 1px;
  }
</style>

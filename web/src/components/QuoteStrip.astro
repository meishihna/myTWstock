---
import { getPrice } from "../lib/priceCache";
import { QUOTE } from "../lib/ui";

interface Props {
  ticker: string;
}

const { ticker } = Astro.props;

// 向 Yahoo 取數:供價格 header 與持股／殖利率資訊列。
// 走勢圖（含區間選擇與互動 OHLCV）由前端 Lightweight Charts 讀 /api/bars 繪製。
const priceData = await getPrice(ticker);

// 大價格用 latest(regularMarketPrice):盤中＝最新成交價,收盤後＝當日收盤價。
// 漲跌以 latest 對「前一交易日收盤」計算——前收取 close[] 倒數第二根(最後一根為最新交易日),
// 落在實際成交區間、與走勢圖一致;不用 meta.previousClose(偶發異常值,曾出現超出漲跌停的錯誤前收)。
const headlinePrice = priceData?.latest ?? null;
const closeArr = priceData?.close ?? [];
const prevSessionClose =
  closeArr.length >= 2
    ? closeArr[closeArr.length - 2]!
    : closeArr.length === 1
      ? closeArr[0]!
      : null;
const dayChange =
  headlinePrice != null && prevSessionClose != null
    ? Math.round((headlinePrice - prevSessionClose) * 100) / 100
    : null;
const dayChangePct =
  dayChange != null && prevSessionClose != null && prevSessionClose !== 0
    ? Math.round((dayChange / prevSessionClose) * 10000) / 100
    : null;

const badgeUp = dayChange != null && dayChange > 0;
const badgeDown = dayChange != null && dayChange < 0;
const badgeClass = badgeUp ? "up" : badgeDown ? "down" : "flat";

function fmtPrice(n: number): string {
  return n.toLocaleString("zh-TW", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function fmtPctOrDash(v: number | null | undefined): string {
  if (v == null || !Number.isFinite(v)) return "-";
  return `${v.toFixed(2)}%`;
}

let timeDisplay = "";
if (priceData?.marketTime) {
  try {
    timeDisplay = new Date(priceData.marketTime).toLocaleString("zh-TW", {
      timeZone: "Asia/Taipei",
    });
  } catch {
    timeDisplay = "";
  }
} else if (priceData?.dates?.length) {
  timeDisplay = priceData.dates[priceData.dates.length - 1] ?? "";
}

const chgBigStr =
  dayChange == null
    ? "—"
    : dayChange === 0
      ? fmtPrice(0)
      : (dayChange > 0 ? "+" : "-") + fmtPrice(Math.abs(dayChange));
const chgPctStr =
  dayChangePct == null
    ? "—"
    : (dayChangePct === 0
        ? "0.00"
        : (dayChangePct > 0 ? "+" : "-") + Math.abs(dayChangePct).toFixed(2)) +
      "%";

// months: 0 = 當日分時線(intraday line);其餘為日 K 可見區間月數
const ranges: { label: string; months: number }[] = [
  { label: "當日", months: 0 },
  { label: "1月", months: 1 },
  { label: "3月", months: 3 },
  { label: "6月", months: 6 },
  { label: "1年", months: 12 },
  { label: "2年", months: 24 },
];
const defaultMonths = 6;
---

<section class="quote-widget-wrap" aria-label={QUOTE.title}>
  <h2 class="quote-widget-sr-only">{QUOTE.title}</h2>

  {
    priceData ? (
      <div
        class="quote-widget"
        data-quote-ticker={ticker}
        data-prev-close={prevSessionClose != null ? String(prevSessionClose) : ""}
      >
        <div class="quote-top">
          <div class="quote-top-left">
            <div class="quote-price-with-chg">
              <div class="quote-price-block">
                <div class="quote-price">
                  {headlinePrice != null ? fmtPrice(headlinePrice) : "—"}
                </div>
              </div>
              <div class="quote-change-block quote-change-block--next-price">
                <div class={`quote-chg-big ${badgeClass}`}>{chgBigStr}</div>
                <div class={`quote-chg-pct ${badgeClass}`}>{chgPctStr}</div>
              </div>
            </div>
            <div class="quote-sub">NT$ · {ticker}</div>
          </div>
          <div class="quote-top-metrics" aria-label={QUOTE.holdingsStripAria}>
            <div class="quote-metric">
              <span class="quote-metric__label">{QUOTE.insiderHold}</span>
              <span class="quote-metric__value">
                {fmtPctOrDash(priceData.insiderPct)}
              </span>
            </div>
            <div class="quote-metric">
              <span class="quote-metric__label">{QUOTE.instHold}</span>
              <span class="quote-metric__value">
                {fmtPctOrDash(priceData.institutionPct)}
              </span>
            </div>
            <div class="quote-metric">
              <span class="quote-metric__label">{QUOTE.divYield}</span>
              <span class="quote-metric__value">
                {fmtPctOrDash(priceData.divYieldPct)}
              </span>
            </div>
          </div>
        </div>

        <div class="quote-lwc-ranges" role="group" aria-label="日期區間">
          {
            ranges.map((r) => (
              <button
                type="button"
                class:list={["quote-lwc-range", { "is-active": r.months === defaultMonths }]}
                data-months={r.months}
              >
                {r.label}
              </button>
            ))
          }
        </div>

        <div
          class="quote-lwc"
          data-ticker={ticker}
          data-default-months={defaultMonths}
          role="img"
          aria-label={QUOTE.title}
        ></div>

        <div class="quote-foot">
          <div class="quote-ma-legend">
            <span class="quote-ma-legend__item"><i style="background:var(--accent)"></i>5MA</span>
            <span class="quote-ma-legend__item"><i style="background:var(--series-3)"></i>10MA</span>
            <span class="quote-ma-legend__item"><i style="background:var(--series-5)"></i>20MA</span>
          </div>
          <div class="quote-foot__time">
            {QUOTE.delayedShort}
            {timeDisplay ? ` · ${timeDisplay}` : ""}
          </div>
        </div>
      </div>
    ) : (
      <div class="quote-error">
        <p>{QUOTE.error}</p>
        <p>{QUOTE.chartUnavailable}</p>
      </div>
    )
  }
</section>

<script>
  import {
    createChart,
    CrosshairMode,
    type IChartApi,
    type ISeriesApi,
  } from "lightweight-charts";

  interface Bar {
    time: string;
    open: number;
    high: number;
    low: number;
    close: number;
    volume: number;
  }

  function fmtNum(n: number): string {
    return n.toLocaleString("zh-TW", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }
  function fmtVol(v: number): string {
    if (v >= 1e9) return (v / 1e9).toFixed(1) + "B";
    if (v >= 1e6) return (v / 1e6).toFixed(1) + "M";
    if (v >= 1e3) return (v / 1e3).toFixed(0) + "K";
    return String(Math.round(v));
  }
  function sma(bars: Bar[], period: number): { time: string; value: number }[] {
    const out: { time: string; value: number }[] = [];
    for (let i = period - 1; i < bars.length; i++) {
      let s = 0;
      for (let j = i - period + 1; j <= i; j++) s += bars[j]!.close;
      out.push({ time: bars[i]!.time, value: Math.round((s / period) * 100) / 100 });
    }
    return out;
  }
  /** 最後一根的 SMA（盤中即時更新末點用） */
  function smaLast(bars: Bar[], period: number): number | null {
    if (bars.length < period) return null;
    let s = 0;
    for (let j = bars.length - period; j < bars.length; j++) s += bars[j]!.close;
    return Math.round((s / period) * 100) / 100;
  }
  function fmt2(n: number): string {
    return n.toLocaleString("zh-TW", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }
  interface MiniQ {
    latest: number;
    prevClose?: number;
    dayOpen?: number | null;
    dayHigh?: number | null;
    dayLow?: number | null;
    dayVolume?: number | null;
    sessionDate?: string | null;
    points?: number[];
    times?: number[];
  }
  /** 由 quote-mini 組「今日這根」日 K（open=當日開、high/low=當日極值、close=最新價） */
  function buildTodayBar(q: MiniQ): Bar | null {
    if (!q || typeof q.latest !== "number" || !(q.latest > 0) || !q.sessionDate) {
      return null;
    }
    const close = Math.round(q.latest * 100) / 100;
    const open = typeof q.dayOpen === "number" && q.dayOpen > 0 ? q.dayOpen : close;
    let high = typeof q.dayHigh === "number" && q.dayHigh > 0 ? q.dayHigh : close;
    let low = typeof q.dayLow === "number" && q.dayLow > 0 ? q.dayLow : close;
    high = Math.max(high, close, open);
    low = Math.min(low, close, open);
    const volume = typeof q.dayVolume === "number" && q.dayVolume >= 0 ? q.dayVolume : 0;
    return { time: q.sessionDate, open, high, low, close, volume };
  }
  /** 更新大股價 + 漲跌（漲跌基準 prevClose 與 K 線今日這根共用 → 三者一致） */
  function updateHeadline(latest: number, prevClose: number | null): void {
    const w = document.querySelector<HTMLElement>(".quote-widget[data-quote-ticker]");
    if (!w) return;
    const priceEl = w.querySelector(".quote-price");
    if (priceEl && Number.isFinite(latest) && latest > 0) {
      priceEl.textContent = fmt2(latest);
    }
    const chgEl = w.querySelector(".quote-chg-big");
    const pctEl = w.querySelector(".quote-chg-pct");
    if (chgEl && pctEl && prevClose != null && Number.isFinite(prevClose) && prevClose > 0) {
      const chg = Math.round((latest - prevClose) * 100) / 100;
      const pct = Math.round((chg / prevClose) * 10000) / 100;
      const cls = chg > 0 ? "up" : chg < 0 ? "down" : "flat";
      chgEl.className = "quote-chg-big " + cls;
      pctEl.className = "quote-chg-pct " + cls;
      chgEl.textContent = chg === 0 ? fmt2(0) : (chg > 0 ? "+" : "-") + fmt2(Math.abs(chg));
      pctEl.textContent =
        (pct === 0 ? "0.00" : (pct > 0 ? "+" : "-") + Math.abs(pct).toFixed(2)) + "%";
    }
  }
  /** crosshair 的 time 可能是 'YYYY-MM-DD' 字串或 {year,month,day}；統一成字串 key */
  function timeKey(t: unknown): string {
    if (typeof t === "string") return t;
    if (t && typeof t === "object" && "year" in (t as any)) {
      const o = t as { year: number; month: number; day: number };
      return `${o.year}-${String(o.month).padStart(2, "0")}-${String(o.day).padStart(2, "0")}`;
    }
    return String(t);
  }

  async function initQuoteChart(): Promise<void> {
    const el = document.querySelector<HTMLElement>(".quote-lwc[data-ticker]");
    if (!el || el.dataset.lwcInit) return;
    el.dataset.lwcInit = "1";
    const ticker = el.getAttribute("data-ticker");
    const miniUrl = `/api/quote-mini/${ticker}`;

    let bars: Bar[] = [];
    let mini: MiniQ | null = null;
    try {
      const [rb, rq] = await Promise.all([
        fetch(`/api/bars/${ticker}`).then((r) => r.json()).catch(() => null),
        fetch(miniUrl).then((r) => (r.ok ? r.json() : null)).catch(() => null),
      ]);
      bars = (rb && (rb.bars as Bar[])) || [];
      mini = rq && typeof rq.latest === "number" ? (rq as MiniQ) : null;
    } catch {
      /* ignore */
    }

    // 前一交易日收盤：大股價漲跌與 K 線「今日這根」共用同一基準 → 三者一致。
    // 若 Yahoo 日線末根已是今日(== mini.sessionDate)則取其前一根，否則末根即昨收。
    let prevDailyClose: number | null = null;
    if (bars.length >= 1) {
      const lastBar = bars[bars.length - 1]!;
      prevDailyClose =
        mini && mini.sessionDate && lastBar.time === mini.sessionDate
          ? bars.length >= 2
            ? bars[bars.length - 2]!.close
            : lastBar.close
          : lastBar.close;
    }

    if (bars.length < 2) {
      el.innerHTML = '<div class="quote-lwc-msg">走勢資料暫時無法載入</div>';
      // 無 K 線仍讓大股價即時：先更新一次再輪詢
      if (mini) updateHeadline(mini.latest, prevDailyClose ?? mini.prevClose ?? null);
      setInterval(() => {
        if (document.hidden) return;
        fetch(miniUrl)
          .then((r) => (r.ok ? r.json() : null))
          .then((q) => {
            if (q && typeof q.latest === "number")
              updateHeadline(q.latest, prevDailyClose ?? q.prevClose ?? null);
          })
          .catch(() => {});
      }, 45000);
      return;
    }

    // 併入「今日這根」到日線尾端（首屏即：大股價 = K 線末根 = 圖例）；盤中由輪詢續更。
    if (mini) {
      const tb = buildTodayBar(mini);
      if (tb) {
        const last = bars[bars.length - 1]!;
        if (last.time === tb.time) bars[bars.length - 1] = tb;
        else if (tb.time > last.time) bars.push(tb);
      }
    }

    // 兩個圖層宿主疊在同一容器：日 K 與「當日分時線」，切換時互相顯隱
    const dailyHost = document.createElement("div");
    dailyHost.className = "quote-lwc-host";
    const intradayHost = document.createElement("div");
    intradayHost.className = "quote-lwc-host";
    intradayHost.style.display = "none";
    el.appendChild(dailyHost);
    el.appendChild(intradayHost);

    // ── 主題色:canvas 圖表(lightweight-charts)自行解析顏色字串,**不支援 CSS var()**
    //    故一律傳「解析後的實色」;切換深/淺色時由 tw-theme-change 重新套用(見下方 applyChartTheme)
    const rootCS = () => getComputedStyle(document.documentElement);
    const tc = (name: string, fb: string): string =>
      rootCS().getPropertyValue(name).trim() || fb;
    /** 以 --ink(深=白/淺=墨)組 rgba,供格線與座標軸邊框 */
    const inkA = (a: number): string => `rgba(${tc("--ink", "255, 255, 255")}, ${a})`;
    /** hex → rgba(帶透明度);非 hex 原樣回傳 */
    const alphaOf = (c: string, a: number): string => {
      const m = c.match(/^#([0-9a-fA-F]{6})$/);
      if (!m) return c;
      const n = parseInt(m[1], 16);
      return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
    };
    const upC = () => tc("--up", "#e24f43");
    const downC = () => tc("--down", "#2fa572");
    const maColors = () => [
      tc("--accent", "#d8a24e"),
      tc("--series-3", "#5b9ce6"),
      tc("--series-5", "#9085e9"),
    ];
    const baselineColors = () => ({
      topLineColor: upC(),
      topFillColor1: alphaOf(upC(), 0.28),
      topFillColor2: alphaOf(upC(), 0.02),
      bottomLineColor: downC(),
      bottomFillColor1: alphaOf(downC(), 0.02),
      bottomFillColor2: alphaOf(downC(), 0.28),
    });
    const baseChartOpts = () => ({
      layout: {
        background: { color: "transparent" },
        textColor: tc("--text-secondary", "#a09c92"),
        fontSize: 11,
      },
      grid: { vertLines: { color: inkA(0.05) }, horzLines: { color: inkA(0.05) } },
    });

    const chart = createChart(dailyHost, {
      autoSize: true,
      ...baseChartOpts(),
      rightPriceScale: { borderColor: inkA(0.12) },
      timeScale: { borderColor: inkA(0.12), rightOffset: 4 },
      crosshair: { mode: CrosshairMode.Normal },
    });

    const candleColors = () => ({
      upColor: upC(),
      downColor: downC(),
      borderVisible: false,
      wickUpColor: upC(),
      wickDownColor: downC(),
    });
    const candle = chart.addCandlestickSeries(candleColors());
    candle.setData(
      bars.map((b) => ({ time: b.time, open: b.open, high: b.high, low: b.low, close: b.close })),
    );

    const vol = chart.addHistogramSeries({ priceFormat: { type: "volume" }, priceScaleId: "" });
    vol.priceScale().applyOptions({ scaleMargins: { top: 0.82, bottom: 0 } });
    vol.setData(
      bars.map((b) => ({
        time: b.time,
        value: b.volume,
        color: b.close >= b.open ? alphaOf(upC(), 0.45) : alphaOf(downC(), 0.45),
      })),
    );

    const maPeriods = [5, 10, 20];
    const maDefs: [number, string][] = maPeriods.map(
      (pd, i) => [pd, maColors()[i]!] as [number, string],
    );
    const maRuntime: [number, ReturnType<typeof chart.addLineSeries>][] = [];
    for (const [period, color] of maDefs) {
      const line = chart.addLineSeries({
        color,
        lineWidth: 1,
        priceLineVisible: false,
        lastValueVisible: false,
        crosshairMarkerVisible: false,
      });
      line.setData(sma(bars, period));
      maRuntime.push([period, line]);
    }

    // ── 切換深/淺色:canvas 圖表不吃 CSS 變數,需重新套用色彩(Layout 發 tw-theme-change)
    const applyChartTheme = () => {
      try {
        chart.applyOptions({
          ...baseChartOpts(),
          rightPriceScale: { borderColor: inkA(0.12) },
          timeScale: { borderColor: inkA(0.12), rightOffset: 4 },
        });
        candle.applyOptions(candleColors());
        vol.setData(
          bars.map((b) => ({
            time: b.time,
            value: b.volume,
            color: b.close >= b.open ? alphaOf(upC(), 0.45) : alphaOf(downC(), 0.45),
          })),
        );
        const cols = maColors();
        maRuntime.forEach(([, line], i) => line.applyOptions({ color: cols[i]! }));
        if (intradayChart) {
          intradayChart.applyOptions({
            ...baseChartOpts(),
            rightPriceScale: {
              borderColor: inkA(0.12),
              scaleMargins: { top: 0.02, bottom: 0.02 },
            },
            timeScale: {
              borderColor: inkA(0.12),
              timeVisible: true,
              secondsVisible: false,
              rightOffset: 2,
            },
          });
        }
        if (intradaySeries) intradaySeries.applyOptions(baselineColors());
      } catch {
        /* 圖表尚未就緒 */
      }
    };
    window.addEventListener("tw-theme-change", applyChartTheme);

    // ── 互動式 OHLCV 圖例(隨游標更新,預設最新一根)─────────────
    const legend = document.createElement("div");
    legend.className = "quote-lwc-legend";
    el.appendChild(legend);
    const byTime = new Map(bars.map((b, i) => [b.time, i] as const));
    function renderAt(idx: number): void {
      const b = bars[idx];
      if (!b) return;
      const prev = idx > 0 ? bars[idx - 1]!.close : null;
      const up = b.close >= b.open;
      const col = up ? "var(--up)" : "var(--down)";
      let chg = "";
      if (prev != null && prev !== 0) {
        const d = Math.round((b.close - prev) * 100) / 100;
        const p = (d / prev) * 100;
        const c2 = d >= 0 ? "var(--up)" : "var(--down)";
        chg = ` <b style="color:${c2}">${d >= 0 ? "+" : ""}${p.toFixed(2)}%</b>`;
      }
      legend.innerHTML =
        `<span class="t">${b.time}</span> 開<b>${fmtNum(b.open)}</b> ` +
        `高<b style="color:${col}">${fmtNum(b.high)}</b> ` +
        `低<b style="color:${col}">${fmtNum(b.low)}</b> ` +
        `收<b style="color:${col}">${fmtNum(b.close)}</b> ` +
        `量<b>${fmtVol(b.volume)}</b>${chg}`;
    }
    let pinnedLast = true;
    let pinnedLastIntra = true;
    let mode: "daily" | "intraday" = "daily";
    let intradayChart: IChartApi | null = null;
    let intradaySeries: ISeriesApi<"Baseline"> | null = null;
    let intradayBuilt = false;
    renderAt(bars.length - 1);
    chart.subscribeCrosshairMove((param) => {
      if (!param || !param.point || param.time == null) {
        pinnedLast = true;
        renderAt(bars.length - 1);
        return;
      }
      const idx = byTime.get(timeKey(param.time));
      if (idx == null) {
        pinnedLast = true;
        renderAt(bars.length - 1);
      } else {
        pinnedLast = idx === bars.length - 1;
        renderAt(idx);
      }
    });

    // ── 盤中即時：同一份 quote-mini 同步更新「大股價 + 今日 K + 量 + MA 末點 + 圖例」──
    // 三者共用 prevDailyClose 與 latest → 永遠一致，不再有「大股價 vs K 線末根」落差。
    const VOL_UP = "rgba(226,75,74,0.45)";
    const VOL_DOWN = "rgba(29,158,117,0.45)";
    function applyLive(q: MiniQ): void {
      mini = q;
      updateHeadline(q.latest, prevDailyClose);
      // 分時線同步：資料保持新鮮；顯示中且未 hover 才刷新圖例
      if (intradaySeries && q.points && q.times) {
        setIntradayData();
        if (mode === "intraday" && pinnedLastIntra && q.times.length) {
          renderIntraAt(q.times.length - 1);
        }
      }
      const tb = buildTodayBar(q);
      if (tb) {
        const last = bars[bars.length - 1];
        if (last && last.time === tb.time) {
          bars[bars.length - 1] = tb;
        } else if (!last || tb.time > last.time) {
          bars.push(tb);
          byTime.set(tb.time, bars.length - 1);
        } else {
          return;
        }
        candle.update({ time: tb.time, open: tb.open, high: tb.high, low: tb.low, close: tb.close });
        vol.update({
          time: tb.time,
          value: tb.volume,
          color: tb.close >= tb.open ? VOL_UP : VOL_DOWN,
        });
        for (const [period, line] of maRuntime) {
          const v = smaLast(bars, period);
          if (v != null) line.update({ time: tb.time, value: v });
        }
        if (pinnedLast) renderAt(bars.length - 1);
      }
    }
    if (mini) updateHeadline(mini.latest, prevDailyClose);
    setInterval(() => {
      if (document.hidden) return;
      fetch(miniUrl)
        .then((r) => (r.ok ? r.json() : null))
        .then((q) => {
          if (q && typeof q.latest === "number") applyLive(q as MiniQ);
        })
        .catch(() => {});
    }, 45000);

    // ── 當日分時線（baseline：昨收之上紅、之下綠，同行情列平盤線分色）────────
    function intraBase(): number {
      if (prevDailyClose != null && prevDailyClose > 0) return prevDailyClose;
      return mini && mini.prevClose && mini.prevClose > 0 ? mini.prevClose : 0;
    }
    function intraTimeLabel(utcSec: number): string {
      return new Date(utcSec * 1000).toLocaleTimeString("zh-TW", {
        timeZone: "Asia/Taipei",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      });
    }
    function renderIntraAt(idx: number): void {
      if (!mini || !mini.points || !mini.times) return;
      const v = mini.points[idx];
      const t = mini.times[idx];
      if (v == null || t == null) return;
      const base = intraBase();
      const up = base > 0 ? v >= base : true;
      const col = up ? "var(--up)" : "var(--down)";
      let chg = "";
      if (base > 0) {
        const d = Math.round((v - base) * 100) / 100;
        const p = (d / base) * 100;
        chg = ` <b style="color:${col}">${d >= 0 ? "+" : ""}${p.toFixed(2)}%</b>`;
      }
      legend.innerHTML =
        `<span class="t">${intraTimeLabel(t)}</span> 價<b style="color:${col}">${fmtNum(v)}</b>${chg}`;
    }
    function setIntradayData(): void {
      if (!intradaySeries || !mini || !mini.points || !mini.times) return;
      const pts = mini.points;
      const tms = mini.times;
      const data: { time: any; value: number }[] = [];
      let lastT = -1;
      for (let i = 0; i < pts.length; i++) {
        const t = tms[i];
        if (typeof t !== "number" || t <= 0) continue;
        // +8h 位移：使 lightweight-charts 的 UTC 時間軸顯示為台北盤中時刻(09:00–13:30)
        const shifted = t + 28800;
        if (shifted <= lastT) continue; // 時間須嚴格遞增
        lastT = shifted;
        data.push({ time: shifted as any, value: pts[i]! });
      }
      intradaySeries.setData(data as any);
    }
    function ensureIntraday(): void {
      if (intradayBuilt) return;
      intradayBuilt = true;
      const ok =
        !!mini &&
        Array.isArray(mini.points) &&
        mini.points.length >= 2 &&
        Array.isArray(mini.times) &&
        mini.times.length === mini.points.length;
      if (!ok) {
        intradayHost.innerHTML = '<div class="quote-lwc-msg">當日無盤中分時資料</div>';
        return;
      }
      intradayChart = createChart(intradayHost, {
        autoSize: true,
        ...baseChartOpts(),
        rightPriceScale: {
          borderColor: inkA(0.12),
          scaleMargins: { top: 0.02, bottom: 0.02 },
        },
        timeScale: {
          borderColor: inkA(0.12),
          timeVisible: true,
          secondsVisible: false,
          rightOffset: 2,
        },
        crosshair: { mode: CrosshairMode.Normal },
        // 當日走勢＝固定框：禁止使用者左右平移與縮放(日 K 其他區間不受影響)
        handleScroll: false,
        handleScale: false,
      });
      const base = intraBase();
      // 當日 Y 軸天花板/地板 = 當日漲停/跌停價(前收 ±10%,依台股升降單位取整)
      const twTick = (p: number) =>
        p < 10 ? 0.01 : p < 50 ? 0.05 : p < 100 ? 0.1 : p < 500 ? 0.5 : p < 1000 ? 1 : 5;
      const roundToTick = (p: number) => {
        const t = twTick(p);
        return Math.round(p / t + 1e-9) * t;
      };
      const limitUp = base > 0 ? roundToTick(base * 1.1) : null;
      const limitDown = base > 0 ? roundToTick(base * 0.9) : null;
      const fixedRange =
        limitUp != null && limitDown != null
          ? () => ({ priceRange: { minValue: limitDown, maxValue: limitUp } })
          : undefined;
      intradaySeries = intradayChart.addBaselineSeries({
        baseValue: { type: "price", price: base },
        ...baselineColors(),
        lineWidth: 2,
        priceLineVisible: false,
        lastValueVisible: true,
        // Y 軸固定為當日漲跌停區間(不隨資料自動縮放)
        autoscaleInfoProvider: fixedRange,
      });
      setIntradayData();
      if (base > 0) {
        intradaySeries.createPriceLine({
          price: base,
          color: inkA(0.28),
          lineWidth: 1,
          lineStyle: 2,
          axisLabelVisible: true,
          title: "昨收",
        });
      }
      intradayChart.timeScale().fitContent();
      intradayChart.subscribeCrosshairMove((param: any) => {
        const n = mini && mini.times ? mini.times.length : 0;
        if (!param || !param.point || param.time == null) {
          pinnedLastIntra = true;
          renderIntraAt(n - 1);
          return;
        }
        const target = Number(param.time) - 28800;
        let idx = -1;
        if (mini && mini.times) {
          for (let i = 0; i < mini.times.length; i++) {
            if (mini.times[i] === target) {
              idx = i;
              break;
            }
          }
        }
        if (idx < 0) {
          pinnedLastIntra = true;
          renderIntraAt(n - 1);
        } else {
          pinnedLastIntra = idx === n - 1;
          renderIntraAt(idx);
        }
      });
    }
    const maLegendEl =
      el.closest(".quote-widget-wrap")?.querySelector<HTMLElement>(".quote-ma-legend") ??
      null;
    function showMode(m: "daily" | "intraday"): void {
      mode = m;
      if (maLegendEl) maLegendEl.style.display = m === "intraday" ? "none" : "";
      if (m === "intraday") {
        dailyHost.style.display = "none";
        intradayHost.style.display = "";
        ensureIntraday();
        if (intradaySeries && mini && mini.times) {
          intradayChart!.timeScale().fitContent();
          pinnedLastIntra = true;
          renderIntraAt(mini.times.length - 1);
        }
      } else {
        intradayHost.style.display = "none";
        dailyHost.style.display = "";
        pinnedLast = true;
        renderAt(bars.length - 1);
      }
    }

    // ── 日期區間選擇 ───────────────────────────────────────────
    function applyRange(months: number): void {
      try {
        if (months >= 24) {
          chart.timeScale().fitContent();
          return;
        }
        const lastT = bars[bars.length - 1]!.time;
        const f = new Date(lastT + "T00:00:00Z");
        f.setUTCMonth(f.getUTCMonth() - months);
        chart.timeScale().setVisibleRange({
          from: f.toISOString().split("T")[0]! as any,
          to: lastT as any,
        });
      } catch {
        chart.timeScale().fitContent();
      }
    }
    const section = el.closest(".quote-widget-wrap");
    const btns = section
      ? Array.from(section.querySelectorAll<HTMLButtonElement>(".quote-lwc-range"))
      : [];
    for (const btn of btns) {
      btn.addEventListener("click", () => {
        for (const b of btns) b.classList.remove("is-active");
        btn.classList.add("is-active");
        const m = Number(btn.getAttribute("data-months"));
        if (m === 0) {
          showMode("intraday");
        } else {
          showMode("daily");
          applyRange(m);
        }
      });
    }
    const defMonths = Number(el.getAttribute("data-default-months")) || 6;
    requestAnimationFrame(() => applyRange(defMonths));
  }

  initQuoteChart();
  document.addEventListener("astro:page-load", initQuoteChart);
</script>


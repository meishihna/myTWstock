---
import Layout from "../../layouts/Layout.astro";
import Bi from "../../components/Bi.astro";
import SectorBilingualName from "../../components/SectorBilingualName.astro";
import fs from "node:fs";
import path from "node:path";
import { HOME, SECTORS_PAGE, SITE } from "../../lib/ui";

const dataDir = path.join(process.cwd(), "public/data");
const idx = JSON.parse(fs.readFileSync(path.join(dataDir, "reports-index.json"), "utf8"));
const sectors = idx.sectors as { name: string; slug: string; count: number }[];

// TPEx 產業鏈(主):industries-index.json
let industries: any[] = [];
const indPath = path.join(dataDir, "industries-index.json");
if (fs.existsSync(indPath)) {
  industries = JSON.parse(fs.readFileSync(indPath, "utf8")).industries || [];
}
---
<Layout title={`${SECTORS_PAGE.title} — ${SITE.name}`} description={SECTORS_PAGE.title}>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/"><Bi zh="首頁" en="Home" /></a>
    <span class="bc-sep"> / </span>
    <span>{SECTORS_PAGE.breadcrumb}</span>
  </div>
  <h1 class="page-h1"><Bi zh="產業" en="Industries" /></h1>

  <div class="ind-toggle" role="tablist">
    <button class="ind-tg active" data-view="tpex" role="tab">TPEx 產業鏈 <span>{industries.length}</span></button>
    <button class="ind-tg" data-view="yahoo" role="tab">細分類別 <span>{sectors.length}</span></button>
  </div>

  {/* 主:TPEx 產業鏈 */}
  <div id="view-tpex">
    <p class="page-lead">櫃買中心產業價值鏈 — 點產業看上中下游與成分股</p>
    <div class="ind-grid">
      {industries.map((ind: any) => (
        <a class="ind-card" href={`/sectors/chain/${ind.slug}`}>
          <span class="ind-card-title">{ind.title}</span>
          <span class="ind-card-count">{ind.companyCount} {HOME.filesUnit}</span>
          <span class="ind-card-go"><Bi zh="看產業鏈" en="View chain" /> →</span>
        </a>
      ))}
    </div>
  </div>

  {/* 次:細分類別(99 Yahoo sectors) */}
  <div id="view-yahoo" hidden>
    <p class="page-lead">{SECTORS_PAGE.countPrefix} {sectors.length} {SECTORS_PAGE.countSuffix}</p>
    <div class="sector-grid">
      {sectors.map((s) => (
        <a class="sector-card" href={`/sectors/${s.slug}`}>
          <SectorBilingualName enName={s.name} class="sector-card-title" />
          <span class="count">{s.count} {HOME.filesUnit}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style is:global>
  .ind-toggle { display: flex; gap: 0.4rem; margin: 0.6rem 0 1rem; }
  .ind-tg { padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; cursor: pointer; }
  .ind-tg.active { background: var(--accent); color: #1a1a1a; border-color: var(--accent); }
  .ind-tg span { opacity: 0.7; font-weight: 500; }
  .ind-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.7rem; }
  .ind-card { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.8rem 0.9rem; background: var(--surface); border: 1px solid var(--border); border-radius: 11px; text-decoration: none; color: var(--text-primary); transition: border-color 0.15s, transform 0.1s; }
  .ind-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .ind-card-title { font-size: 1.02rem; font-weight: 700; }
  .ind-card-count { font-size: 0.78rem; color: var(--text-secondary); }
  .ind-card-go { font-size: 0.74rem; color: var(--accent); margin-top: 0.15rem; }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".ind-tg");
  const views: Record<string, HTMLElement | null> = {
    tpex: document.getElementById("view-tpex"),
    yahoo: document.getElementById("view-yahoo"),
  };
  btns.forEach((b) =>
    b.addEventListener("click", () => {
      const v = b.dataset.view!;
      btns.forEach((x) => x.classList.toggle("active", x === b));
      for (const [k, el] of Object.entries(views)) if (el) el.hidden = k !== v;
    }),
  );
</script>

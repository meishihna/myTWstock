---
// 產業 section — 單一 TPEx 產業價值鏈頁:上方上下游框圖 + 下方角色分群卡片。
// 資料來源 industries-index.json(build_industries.py → build-industries-index.mjs)。
import Layout from "../../../layouts/Layout.astro";
import Bi from "../../../components/Bi.astro";
import { SITE } from "../../../lib/ui";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const p = path.join(process.cwd(), "public/data/industries-index.json");
  if (!fs.existsSync(p)) return [];
  const { industries } = JSON.parse(fs.readFileSync(p, "utf8"));
  return industries.map((ind: any) => ({ params: { slug: ind.slug }, props: { ind } }));
}

const { ind } = Astro.props as { ind: any };
const TIER = { u: "上游", m: "中游", d: "下游" } as const;
const tiersPresent = (["u", "m", "d"] as const).filter((k) => ind.tiers[k].length);

function groupNodes(arr: any[]) {
  const m = new Map<string, any[]>();
  for (const c of arr) {
    const k = c.subcat || "其他";
    if (!m.has(k)) m.set(k, []);
    m.get(k)!.push(c);
  }
  return [...m.entries()].map(([node, items]) => ({ node, items }));
}
const grouped: Record<string, { node: string; items: any[] }[]> = {
  u: groupNodes(ind.tiers.u), m: groupNodes(ind.tiers.m), d: groupNodes(ind.tiers.d),
};
// 只有「單一層節點過多」(>=12)才改多欄並排,且欄數讓它高度對齊最長的單欄層;
// 其餘層(及一般協調的產業)維持原本「等寬欄、單欄節點」,不動。
const WRAP_MIN = 12;
const refRows = Math.max(
  8,
  ...tiersPresent.filter((tk) => grouped[tk].length < WRAP_MIN).map((tk) => grouped[tk].length),
);
const hasWrap = tiersPresent.some((tk) => grouped[tk].length >= WRAP_MIN);
const tierCols = (tk: string) =>
  grouped[tk].length >= WRAP_MIN ? Math.min(6, Math.ceil(grouped[tk].length / refRows)) : 1;

// 熱力圖資料:個股(去重)+ 節點(分類)分群,供前端 treemap
const _seenCon = new Set<string>();
const hmCons: { t: string; n: string }[] = [];
for (const tk of ["u", "m", "d"] as const) {
  for (const c of ind.tiers[tk]) {
    if (!_seenCon.has(c.t)) { _seenCon.add(c.t); hmCons.push({ t: c.t, n: c.n }); }
  }
}
const hmNodes = tiersPresent.flatMap((tk) =>
  grouped[tk].map((g) => ({ node: g.node, tickers: g.items.map((i: any) => i.t) })),
);

function momTag(n: number) {
  if (!n) return null;
  const dir = n > 0 ? "年增" : "年減";
  const a = Math.abs(n);
  return { label: a === 1 ? `營收${dir}` : `連${a}月${dir}`, cls: n > 0 ? "up" : "down" };
}
function fmtMc(mc: number | null) {
  if (mc == null) return "—";
  if (mc >= 1_000_000) return (mc / 1_000_000).toFixed(2) + "兆";
  if (mc >= 100) return (mc / 100).toFixed(0) + "億";
  return mc + "百萬";
}
const anchor = (tier: string, node: string) => `n-${tier}-${node}`;
---

<Layout title={`${ind.title} 產業鏈 — ${SITE.name}`} description={`${ind.title} 產業價值鏈：上中下游與成分股`}>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/"><Bi zh="首頁" en="Home" /></a><span class="bc-sep"> / </span>
    <a href="/sectors"><Bi zh="產業" en="Industries" /></a><span class="bc-sep"> / </span>
    <span>{ind.title}</span>
  </div>

  <h1 class="page-h1">{ind.title} <span class="ind-h1-sub">產業鏈</span></h1>
  <p class="page-lead">
    {ind.companyCount} 家成分股 ·
    <span class="ind-src">結構參照櫃買中心產業價值鏈平台</span>
  </p>

  {ind.indicators?.length > 0 && (
    <div class="ind-keyrow">
      {ind.indicators.map((d: any) => (
        <div class="ind-key"><span class="ind-key-l">{d.label}</span><span class="ind-key-v">{d.value}</span></div>
      ))}
    </div>
  )}

  {/* 上下游框圖 */}
  <h2 class="ind-sec-h">產業鏈結構</h2>
  <div class={`chain-diagram ${ind.flat ? "flat" : ""}`}>
    {ind.flat ? (
      <div class="chain-tier full">
        <div class="chain-nodes">
          {grouped.m.map((g) => (
            <button class="chain-node" type="button" data-target={anchor("m", g.node)}>{g.node}<span class="cn-n">{g.items.length}</span></button>
          ))}
        </div>
      </div>
    ) : (
      tiersPresent.map((tk, i) => {
        const cols = tierCols(tk);
        return (
          <>
            <div class={`chain-tier ${cols > 1 ? "multi" : ""}`} style={hasWrap ? `flex-grow:${cols}` : undefined}>
              <div class="chain-tier-label">{TIER[tk]}</div>
              <div class="chain-nodes" style={cols > 1 ? `grid-template-columns: repeat(${cols}, 1fr)` : undefined}>
                {grouped[tk].map((g) => (
                  <button class="chain-node" type="button" data-target={anchor(tk, g.node)}>{g.node}<span class="cn-n">{g.items.length}</span></button>
                ))}
              </div>
            </div>
            {i < tiersPresent.length - 1 && <div class="chain-arrow">▸</div>}
          </>
        );
      })
    )}
  </div>

  {/* 成交額熱力圖:節點(分類)層級 + 個股層級 */}
  <h2 class="ind-sec-h">成交額熱力圖</h2>
  <div class="ind-hm-head">
    <span class="ind-hm-note">磚塊＝成交額,顏色＝漲跌(紅漲綠跌)</span>
    <div class="hmp-toggle" role="tablist" aria-label="期間切換">
      <button class="hmp-tab is-active" type="button" role="tab" aria-selected="true" data-hmp="d">日</button>
      <button class="hmp-tab" type="button" role="tab" aria-selected="false" data-hmp="w">週</button>
      <button class="hmp-tab" type="button" role="tab" aria-selected="false" data-hmp="m">月</button>
    </div>
  </div>
  <h3 class="ind-hm-h3">分類(節點)</h3>
  <div id="ind-hm-node" class="ind-hm" role="img" aria-label="產業鏈節點成交額熱力圖" />
  <h3 class="ind-hm-h3" id="ind-hm-stock-h">個股</h3>
  <div id="ind-hm-stock" class="ind-hm" role="img" aria-label="個股成交額熱力圖" />
  <div class="ind-legend" aria-label="漲跌色階(紅漲綠跌)">
    <div class="ind-legend-cell"><span>-8%</span><i style="background:#15ab7a"></i></div>
    <div class="ind-legend-cell"><span>-5%</span><i style="background:#148f66"></i></div>
    <div class="ind-legend-cell"><span>-2%</span><i style="background:#19704f"></i></div>
    <div class="ind-legend-cell"><span>0%</span><i style="background:#38332d"></i></div>
    <div class="ind-legend-cell"><span>+2%</span><i style="background:#9c382e"></i></div>
    <div class="ind-legend-cell"><span>+5%</span><i style="background:#c83d34"></i></div>
    <div class="ind-legend-cell"><span>+8%</span><i style="background:#ee4640"></i></div>
  </div>
  <script type="application/json" id="ind-hm-cons" set:html={JSON.stringify(hmCons)} />
  <script type="application/json" id="ind-hm-nodes" set:html={JSON.stringify(hmNodes)} />

  {/* 角色分群 */}
  <h2 class="ind-sec-h">成分股(依節點分群)</h2>
  <p class="sc-hint">↑ 點選上方產業鏈節點以查看成分股(可複選,再點一次取消)</p>
  <div class="sc-rolegrid">
    {tiersPresent.map((tk) => (
      <section class="sc-tier">
        {!ind.flat && <div class="sc-tier-title">{TIER[tk]} <span>{ind.tiers[tk].length}</span></div>}
        {grouped[tk].map((g) => (
          <div class="sc-subgroup" id={anchor(tk, g.node)}>
            <h3 class="sc-subhead">{g.node} <span class="sc-subn">{g.items.length}</span></h3>
            <div class="sc-grid">
              {g.items.map((c: any) => {
                const mt = momTag(c.mom);
                return (
                  <a class="sc-card2" href={`/report/${c.t}`}>
                    <div class="sc-card2-top">
                      <span class="sc-name">{c.n}{c.status === "lead" && <span class="sc-lead" title="產業龍頭">●</span>}</span>
                      <span class="sc-tk">{c.t}</span>
                    </div>
                    <div class="sc-sector">{c.s}{c.status === "challenge" ? " · 成長挑戰" : ""}</div>
                    <div class="sc-meta">市值 {fmtMc(c.mc)}{c.pe != null && c.pe > 0 ? ` · 本益比 ${c.pe.toFixed(1)}` : ""}</div>
                    <div class="sc-card2-foot">
                      <span class="sc-mom">{mt ? mt.label : ""}</span>
                      {c.revYoy != null && (
                        <span class={`sc-yoy ${c.revYoy >= 0 ? "up" : "down"}`}>營收 {c.revYoy >= 0 ? "+" : ""}{c.revYoy}%</span>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>
</Layout>

<style is:global>
  .ind-h1-sub { font-size: 0.6em; color: var(--text-secondary); font-weight: 500; }
  .ind-src { color: var(--text-secondary); font-size: 0.85em; }
  .ind-keyrow { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0.8rem 0 1.4rem; }
  .ind-key { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.45rem 0.7rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .ind-key-l { font-size: 0.7rem; color: var(--text-secondary); }
  .ind-key-v { font-size: 0.85rem; font-weight: 600; }
  .ind-sec-h { font-size: 1.05rem; margin: 1.6rem 0 0.8rem; padding-left: 0.5rem; border-left: 3px solid var(--accent); }

  /* 上下游框圖 */
  .chain-diagram { display: flex; align-items: stretch; gap: 0.5rem; overflow-x: auto; padding: 0.4rem 0 0.8rem; }
  .chain-diagram.flat { display: block; }
  .chain-tier { flex: 1 1 0; min-width: 180px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 0.55rem; }
  .chain-tier.full { min-width: 0; }
  .chain-tier-label { text-align: center; font-weight: 700; color: var(--accent); font-size: 0.85rem; margin-bottom: 0.5rem; letter-spacing: 0.05em; }
  .chain-nodes { display: flex; flex-direction: column; gap: 0.4rem; }
  .chain-diagram.flat .chain-nodes { flex-direction: row; flex-wrap: wrap; }
  .chain-tier.multi .chain-nodes { display: grid; align-content: start; }
  .chain-node { display: flex; justify-content: space-between; align-items: center; gap: 0.3rem; width: 100%; padding: 0.45rem 0.45rem; white-space: nowrap; background: var(--surface-elevated); border: 1px solid var(--border); border-radius: 7px; font-family: inherit; font-size: 0.72rem; font-weight: 600; line-height: 1.2; color: var(--text-primary); text-align: left; text-decoration: none; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .chain-node:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--surface-elevated)); }
  .chain-node.sel { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 20%, var(--surface-elevated)); color: var(--accent); }
  .cn-n { font-size: 0.72rem; color: var(--text-secondary); font-weight: 500; }
  .chain-arrow { display: flex; align-items: center; color: var(--text-secondary); font-size: 1.1rem; }

  /* 角色分群(沿用 /map 卡片語言) */
  .sc-rolegrid { display: flex; flex-direction: column; gap: 1.4rem; }
  .sc-tier-title { font-size: 0.95rem; font-weight: 700; color: var(--accent); margin-bottom: 0.6rem; }
  .sc-tier-title span { color: var(--text-secondary); font-weight: 500; }
  .sc-tier { display: flex; flex-direction: column; gap: 0.9rem; }
  .sc-hint { color: var(--text-secondary); font-size: 0.85rem; margin: 0 0 0.8rem; }
  .sc-tier.hide { display: none; }
  .sc-subgroup { display: none; flex-direction: column; gap: 0.45rem; scroll-margin-top: 70px; }
  .sc-subgroup.show { display: flex; }
  .sc-subhead { font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin: 0; display: flex; align-items: baseline; gap: 0.35rem; padding-left: 0.4rem; border-left: 3px solid color-mix(in srgb, var(--accent) 55%, transparent); }
  .sc-subn { font-size: 0.72rem; color: var(--text-secondary); }
  .sc-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sc-grid > .sc-card2 { flex: 0 0 172px; width: 172px; min-height: 7rem; }
  .sc-card2 { display: flex; flex-direction: column; gap: 0.14rem; padding: 0.4rem 0.6rem; background: var(--surface); border: 1px solid var(--border); border-radius: 9px; text-decoration: none; color: var(--text-primary); transition: border-color 0.15s; }
  .sc-card2:hover { border-color: var(--accent); }
  .sc-card2-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.3rem; }
  .sc-name { font-weight: 700; font-size: 0.92rem; }
  .sc-tk { font-size: 0.72rem; color: var(--text-secondary); }
  .sc-sector { font-size: 0.7rem; color: var(--text-secondary); }
  .sc-lead { color: var(--accent); font-size: 0.5rem; vertical-align: middle; margin-left: 4px; }
  .sc-meta { font-size: 0.72rem; color: var(--text-secondary); }
  .sc-mom { font-size: 0.72rem; color: var(--text-secondary); }
  .sc-card2-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: baseline; gap: 0.3rem; padding-top: 0.2rem; }
  .sc-yoy { font-size: 0.78rem; font-weight: 600; }
  .sc-yoy.up { color: var(--up); }
  .sc-yoy.down { color: var(--down); }

  .ind-hm-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; margin: 0.2rem 0 0.6rem; }
  .ind-hm-note { font-size: 0.78rem; color: var(--text-secondary); }
  .ind-hm-h3 { font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); margin: 0.8rem 0 0.4rem; }
  .ind-hm { position: relative; width: 100%; height: 260px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--surface); }
  #ind-hm-node { height: 300px; }
  #ind-hm-stock { height: 360px; }
  .ind-tile { position: absolute; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 1px; padding: 2px 6px; border-radius: 3px; text-decoration: none; }
  .ind-tile-t { font-size: 0.72rem; font-weight: 600; color: #f1ede5; line-height: 1.15; }
  .ind-tile-p { font-size: 0.68rem; color: #e6e1d8; }
  .ind-hm-empty { color: var(--text-secondary); font-size: 0.82rem; padding: 1rem; text-align: center; }
  .hmp-toggle { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
  .hmp-tab { appearance: none; border: none; background: transparent; color: var(--text-secondary); font: inherit; font-size: 0.76rem; font-weight: 600; padding: 4px 13px; border-radius: 999px; cursor: pointer; }
  .hmp-tab.is-active { color: #1a1613; background: var(--accent); }
  .ind-hm-tip { position: fixed; z-index: 60; pointer-events: none; background: #2a2620; border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; color: var(--text-primary); box-shadow: 0 4px 18px rgba(0,0,0,0.5); }
  .ind-hm-tip .tip-head { margin-bottom: 6px; }
  .ind-hm-tip .tip-code { font-weight: 700; font-size: 0.9rem; }
  .ind-hm-tip .tip-name { color: var(--text-secondary); font-size: 0.78rem; }
  .ind-hm-tip .tip-row { display: flex; gap: 16px; }
  .ind-hm-tip .tip-m { display: flex; flex-direction: column; gap: 1px; }
  .ind-hm-tip .tip-l { font-size: 0.66rem; color: var(--text-secondary); }
  .ind-hm-tip .tip-v { font-size: 0.82rem; font-weight: 600; }
  .ind-legend { display: flex; max-width: 520px; margin: 0.8rem 0 0.2rem; }
  .ind-legend-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .ind-legend-cell span { font-size: 0.7rem; color: var(--text-secondary); }
  .ind-legend-cell i { width: 100%; height: 13px; display: block; }
  .ind-legend-cell:first-child i { border-radius: 4px 0 0 4px; }
  .ind-legend-cell:last-child i { border-radius: 0 4px 4px 0; }
</style>

<script>
  // 框圖節點 = 切換鍵:點選顯示該節點成分股(可複選,再點取消);預設不顯示。
  const diagram = document.querySelector(".chain-diagram");
  const hint = document.querySelector<HTMLElement>(".sc-hint");
  const tierSecs = [...document.querySelectorAll<HTMLElement>(".sc-tier")];
  function refresh() {
    const anyShown = !!document.querySelector(".sc-subgroup.show");
    if (hint) hint.hidden = anyShown;
    for (const t of tierSecs) t.classList.toggle("hide", !t.querySelector(".sc-subgroup.show"));
  }
  if (diagram) {
    diagram.querySelectorAll<HTMLButtonElement>(".chain-node").forEach((btn) => {
      btn.addEventListener("click", () => {
        const grp = document.getElementById(btn.dataset.target || "");
        if (!grp) return;
        const shown = grp.classList.toggle("show");
        btn.classList.toggle("sel", shown);
        refresh();
      });
    });
  }
  refresh();
</script>

<script>
  import { treemap, tileColor } from "../../../lib/heatmap";
  type Stat = { d: number[]; w: number[]; m: number[] };
  const stats: Record<string, Stat> = {};
  let period: "d" | "w" | "m" = "d";
  const hmCons: { t: string; n: string }[] = JSON.parse(document.getElementById("ind-hm-cons")?.textContent || "[]");
  const hmNodes: { node: string; tickers: string[] }[] = JSON.parse(document.getElementById("ind-hm-nodes")?.textContent || "[]");
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));

  function renderStock() {
    const root = document.getElementById("ind-hm-stock"); if (!root) return;
    const all = hmCons
      .map((c) => { const s = stats[c.t]; return s && s[period] ? { ...c, chg: s[period][0], tov: s[period][1], price: (s as Stat & { p?: number }).p ?? null } : null; })
      .filter((c): c is { t: string; n: string; chg: number; tov: number; price: number | null } => !!c && c.tov > 0)
      .sort((a, b) => b.tov - a.tov);
    // 門檻:成交額 >= 最大值 1%(去碎尾巴),上限 50 檔;固定高度、由大到小排列
    const topTov = all.length ? all[0].tov : 0;
    const rows = all.filter((c) => c.tov >= topTov * 0.01).slice(0, 50);
    const hh = document.getElementById("ind-hm-stock-h");
    if (hh) hh.textContent = rows.length < hmCons.length ? `個股(成交額前 ${rows.length} 大)` : "個股";
    if (rows.length === 0) { root.innerHTML = `<p class="ind-hm-empty">暫無成交額資料</p>`; return; }
    const W = root.clientWidth, H = root.clientHeight; if (W < 10 || H < 10) return;
    const laid = treemap(rows.map((c) => ({ ...c, value: Math.sqrt(c.tov) })), 0, 0, W, H);
    const G = 1;
    root.innerHTML = laid.map((c) => {
      const p = c.chg, big = c.w > 52 && c.h > 26, showP = p != null && c.w > 42 && c.h > 38;
      return `<a class="ind-tile" href="/report/${c.t}" data-name="${esc(c.n)}" data-code="${c.t}" data-price="${c.price != null ? c.price : ""}" data-chg="${p != null ? p.toFixed(2) : ""}" data-tov="${c.tov}" style="left:${c.x + G}px;top:${c.y + G}px;width:${Math.max(0, c.w - 2 * G)}px;height:${Math.max(0, c.h - 2 * G)}px;background:${tileColor(p ?? null)}">`
        + (big ? `<span class="ind-tile-t">${esc(c.n)}</span>` : "")
        + (showP ? `<span class="ind-tile-p">${p > 0 ? "+" : ""}${p.toFixed(2)}%</span>` : "") + `</a>`;
    }).join("");
  }

  function nodeStat(g: { tickers: string[] }) {
    let tov = 0, wsum = 0, psum = 0; const seen = new Set<string>();
    for (const t of g.tickers) {
      if (seen.has(t)) continue; seen.add(t);
      const s = stats[t]; if (!s || !s[period]) continue;
      const chg = s[period][0], tv = s[period][1];
      if (typeof tv === "number" && tv > 0) { tov += tv; if (typeof chg === "number" && isFinite(chg)) { wsum += tv; psum += tv * chg; } }
    }
    return { tov, chg: wsum > 0 ? psum / wsum : null };
  }

  function renderNode() {
    const root = document.getElementById("ind-hm-node"); if (!root) return;
    const W = root.clientWidth, H = root.clientHeight; if (W < 10 || H < 10) return;
    const rows = hmNodes.map((g) => ({ g, st: nodeStat(g) })).filter((x) => x.st.tov > 0)
      .sort((a, b) => b.st.tov - a.st.tov); // 依成交額由大到小 → 最大在左、往右下遞減
    if (rows.length === 0) { root.innerHTML = `<p class="ind-hm-empty">暫無成交額資料</p>`; return; }
    const laid = treemap(rows.map((x) => ({ node: x.g.node, count: x.g.tickers.length, value: Math.sqrt(x.st.tov), _chg: x.st.chg, _tov: x.st.tov })), 0, 0, W, H);
    const G = 1;
    root.innerHTML = laid.map((t) => {
      const tt = t as typeof t & { _chg: number | null; count: number; _tov: number };
      const p = tt._chg;
      const big = t.w > 60 && t.h > 28, showP = p != null && t.w > 48 && t.h > 40;
      return `<div class="ind-tile node" data-name="${esc(t.node)}" data-count="${tt.count}" data-chg="${p != null ? p.toFixed(2) : ""}" data-tov="${tt._tov}" style="left:${t.x + G}px;top:${t.y + G}px;width:${Math.max(0, t.w - 2 * G)}px;height:${Math.max(0, t.h - 2 * G)}px;background:${tileColor(p ?? null)}">`
        + (big ? `<span class="ind-tile-t">${esc(t.node)}</span>` : "")
        + (showP ? `<span class="ind-tile-p">${p! > 0 ? "+" : ""}${p!.toFixed(2)}%</span>` : "") + `</div>`;
    }).join("");
  }

  function renderAll() { renderNode(); renderStock(); }

  (async () => {
    try { const r = await fetch("/data/heatmap-stats.json"); if (r.ok) Object.assign(stats, (await r.json()).stats || {}); } catch { /* ignore */ }
    renderAll();
  })();

  document.querySelectorAll<HTMLButtonElement>(".hmp-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      period = (tab.getAttribute("data-hmp") as "d" | "w" | "m") || "d";
      document.querySelectorAll<HTMLButtonElement>(".hmp-tab").forEach((t) => {
        const on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", on ? "true" : "false");
      });
      renderAll();
    });
  });

  let _t: number;
  const ro = new ResizeObserver(() => { clearTimeout(_t); _t = window.setTimeout(renderAll, 150); });
  ["ind-hm-node", "ind-hm-stock"].forEach((id) => { const el = document.getElementById(id); if (el) ro.observe(el); });

  // 互動式 tooltip:hover 磚塊顯示 名稱/代號(或家數)+ 漲跌 + 成交額
  const tip = document.createElement("div");
  tip.className = "ind-hm-tip";
  tip.style.display = "none";
  document.body.appendChild(tip);
  function fmtTov(n: number): string { return n >= 10000 ? `${(n / 10000).toFixed(2)} 兆` : `${Math.round(n)} 億`; }
  function fmtPrice(p: number): string { return p < 50 ? p.toFixed(2) : p < 500 ? p.toFixed(1) : String(Math.round(p)); }
  function onMove(e: MouseEvent) {
    const tile = (e.target as HTMLElement).closest(".ind-tile") as HTMLElement | null;
    if (!tile) { tip.style.display = "none"; return; }
    const d = tile.dataset;
    const isNode = tile.classList.contains("node");
    const chg = d.chg || "", cn = parseFloat(chg);
    const col = chg === "" ? "var(--muted)" : cn > 0 ? "#e24b4a" : cn < 0 ? "#1d9e75" : "var(--muted)";
    const chgStr = chg === "" ? "—" : `${cn > 0 ? "+" : ""}${chg}%`;
    const tovStr = fmtTov(parseFloat(d.tov || "0") || 0);
    const head = isNode
      ? `<span class="tip-code">${d.name}</span>`
      : `<span class="tip-code">${d.code || ""}</span> <span class="tip-name">${d.name}</span>`;
    const m1 = isNode
      ? `<div class="tip-m"><span class="tip-l">家數</span><span class="tip-v">${d.count || "—"}</span></div>`
      : `<div class="tip-m"><span class="tip-l">股價</span><span class="tip-v">${d.price ? fmtPrice(parseFloat(d.price)) : "—"}</span></div>`;
    tip.innerHTML = `<div class="tip-head">${head}</div>`
      + `<div class="tip-row">${m1}`
      + `<div class="tip-m"><span class="tip-l">成交額</span><span class="tip-v">${tovStr}</span></div>`
      + `<div class="tip-m"><span class="tip-l">漲跌幅</span><span class="tip-v" style="color:${col}">${chgStr}</span></div></div>`;
    tip.style.display = "block";
    const tw = tip.offsetWidth;
    tip.style.left = (e.clientX + tw + 20 > window.innerWidth ? e.clientX - tw - 12 : e.clientX + 14) + "px";
    tip.style.top = Math.min(e.clientY + 16, window.innerHeight - 70) + "px";
  }
  ["ind-hm-node", "ind-hm-stock"].forEach((id) => {
    const el = document.getElementById(id);
    if (el) { el.addEventListener("mousemove", onMove); el.addEventListener("mouseleave", () => { tip.style.display = "none"; }); }
  });
</script>

---
/**
 * /signals — 策略回測(終端佈局)
 *
 * 版面權威 = 本地版「進出場回測」的終端骨架:
 *   sticky 報頭(個股籤)→ 決策帶(股名/摘要 + KPI 帶 + 整寬籌碼列)
 *   → viewbar(確認層分頁 + 篩選/排序)→ 左 330px 排行 / 右詳情
 * 只對齊【版面結構與密度】,資料、邏輯、契約解析完全不變。
 *
 * 資料來源:私有引擎產出的【資料檔】(signals-contract v2 三層分檔)。
 * 本 repo【不含任何引擎程式碼】,只讀算好的 JSON。
 *
 * 個股清單:一律由 signals-index.json 的 stocks[] 動態讀取(不 hardcode 檔數/代號),
 * 並以【自選股優先】排序(自選來源 = lib/watchlist.ts 同一個 key,不另存一份)。
 *
 * 誠實性原則:
 *  - source / disclaimer / exitReasons / confLayers / 規則名 一律【從 index 讀】
 *  - 0 交易明寫「無交易」;上櫃標「不適用」;「最高組合」「最近訊號」均標為歷史統計、非推薦
 *  - 全頁禁止任何「現在該買/賣」的當前操作語句
 */
import Layout from "../layouts/Layout.astro";
import { SIGNALS_PAGE, SITE } from "../lib/ui";
import fs from "node:fs";
import path from "node:path";

export const prerender = true;

const idxPath = path.join(process.cwd(), "public/data/signals-index.json");
let meta: {
  updatedAt?: string;
  window?: { months?: number; asof?: string };
  source?: string;
  disclaimer?: string;
  layerNote?: string;
  chipsNote?: string;
  equityNote?: string;
  maeMfeNote?: string;
  entryRules?: string[];
  exitRules?: string[];
} | null = null;
if (fs.existsSync(idxPath)) {
  try {
    const j = JSON.parse(fs.readFileSync(idxPath, "utf8"));
    meta = {
      updatedAt: j.updatedAt,
      window: j.window,
      source: j.source,
      disclaimer: j.disclaimer,
      layerNote: j.layerNote,
      chipsNote: j.chipsNote,
      equityNote: j.equityNote,
      maeMfeNote: j.maeMfeNote,
      entryRules: j.entryRules,
      exitRules: j.exitRules,
    };
  } catch {
    meta = null;
  }
}

/**
 * 位元圖的 asof —— 現場計算的快取 key 需要它。
 * 在 build 時取出(只取一個欄位),避免前端為了查快取而先載 889KB 的 chips-bits.json。
 */
let bitsAsof = "";
try {
  const bp = path.join(process.cwd(), "public/data/chips-bits.json");
  if (fs.existsSync(bp)) bitsAsof = JSON.parse(fs.readFileSync(bp, "utf8")).asof ?? "";
} catch {
  bitsAsof = "";
}

const RISK = [
  "本頁為【歷史回測統計】,僅供教育與研究用途。",
  "歷史績效【不代表未來】表現;任何組合的過去報酬都不保證重現。",
  "非投資建議、不構成任何買賣邀約,亦不代為執行交易。",
  "回測可能存在【過度最佳化、存活者偏誤、小樣本】等限制;越嚴格的確認層交易次數越少,結果越不穩健。",
  "成交假設為【訊號次日開盤】,已扣手續費 0.1425%×2 與證交稅 0.3%,但【未計滑價與流動性衝擊】。",
  "本站不提供、也不會顯示任何「當前應買進或賣出」的操作訊號;頁面所列「歷史總報酬最高組合」「最近一次歷史訊號」皆為過去統計描述。",
] as const;
---

<Layout
  title={`${SIGNALS_PAGE.title} — ${SITE.name}`}
  description="以台灣官方公開資料進行的歷史回測統計;僅供教育與研究參考,不代表未來績效、非投資建議。"
>
  {
    !meta ? (
      <p class="ph-empty-block">回測資料尚未匯入。</p>
    ) : (
      <div id="sg-app" data-bits-asof={bitsAsof} data-asof={meta.window?.asof ?? ""} data-months={String(meta.window?.months ?? 61)}>
        <p class="sg-warn" role="note">
          <b>歷史回測統計</b>・僅供教育與研究・<b>不代表未來績效</b>・非投資建議・不含任何當前買賣訊號
          <a href="#sg-disc-foot">完整聲明 ↓</a>
        </p>

        {/* ① 報頭:頁名 + 個股分頁(自選優先) + 資料時間 */}
        <div class="sg-topbar">
          <div class="sg-brand">
            <span class="sg-kicker">回測</span>
            <span class="sg-pname">{SIGNALS_PAGE.title}</span>
          </div>
          <div class="sg-tabs" id="sg-tabs" role="tablist" aria-label="回測個股" />
          <span class="sg-sync">
            <span class="sg-dot" aria-hidden="true" />
            <span>{meta.window?.asof ? `資料至 ${meta.window.asof}` : "載入中…"}</span>
          </span>
        </div>
        <p class="sg-wlnote" id="sg-wlnote" hidden />

        <p id="sg-loading" class="sg-loading">載入回測資料中…</p>

        <div id="sg-main" hidden>
          {/* ②③④⑤ 決策帶 */}
          <div class="sg-kpibar">
            <div class="sg-kpibar-in">
              <div class="sg-idblock">
                <div class="stk-top" id="sg-stk-top" />
                <div class="stk-meta" id="sg-stk-meta" />
                <p class="stk-adv" id="sg-stk-adv" />
              </div>
              <div class="kgrid" id="sg-kgrid" />
              <div class="kinfo" id="sg-chips" />
            </div>
          </div>

          {/* ⑥ viewbar */}
          <div class="sg-viewbar">
            <nav class="ltabs" id="sg-layers" role="tablist" aria-label="確認層" />
            <div class="vtools">
              <span id="sg-filters" role="group" aria-label="篩選條件">
                <button class="sg-chip" type="button" data-f="beat" aria-pressed="false">勝過抱著</button>
                <button class="sg-chip" type="button" data-f="win50" aria-pressed="false">勝率 50%+</button>
              </span>
              <span class="sortsel">
                排序
                <span class="selwrap">
                  <select id="sg-sort" aria-label="排序依據">
                    <option value="tot">總報酬</option>
                    <option value="win">勝率</option>
                    <option value="n">交易次數</option>
                    <option value="mdd">最大回撤</option>
                    <option value="rule">規則順序</option>
                  </select>
                  <b aria-hidden="true">⌄</b>
                </span>
                <button id="sg-sortdir" type="button" title="切換升冪/降冪" aria-label="切換升冪或降冪">↓</button>
              </span>
            </div>
          </div>
          <p id="sg-tpex-note" class="sg-tpex-note" hidden>
            上櫃・確認層與估值不適用(官方三大法人／融資與 BWIBBU 估值僅上市)。
          </p>

          {/* ⑦ 左右分欄 */}
          <div class="sg-layout">
            <div class="lpane">
              <div class="bhcard" id="sg-bhcard" />
              <div class="lnote" id="sg-lnote" />
              <div class="list" id="sg-list" role="listbox" aria-label="組合排行" tabindex="0" />
            </div>
            <div class="rpane" id="sg-detail" />
          </div>

          <details class="sg-rules">
            <summary>規則庫完整定義({meta.entryRules?.length ?? 0} 進場 × {meta.exitRules?.length ?? 0} 出場)</summary>
            <div class="rulegrid">
              <div>
                <h3>進場規則</h3>
                <ul>{(meta.entryRules ?? []).map((r) => <li>{r}</li>)}</ul>
              </div>
              <div>
                <h3>出場規則</h3>
                <ul>{(meta.exitRules ?? []).map((r) => <li>{r}</li>)}</ul>
              </div>
            </div>
            {meta.layerNote && <p class="sg-note">{meta.layerNote}</p>}
          </details>
        </div>

        <p id="sg-error" class="ph-empty-block" hidden>回測資料載入失敗,請重新整理頁面。</p>
      </div>
    )
  }

  <section class="sg-disc" id="sg-disc-foot" aria-label="回測重要聲明">
    <h2 class="sg-disc-h">重要聲明</h2>
    <ul class="sg-disc-list">{RISK.map((d) => <li>{d}</li>)}</ul>
    {meta?.disclaimer && <p class="sg-src">{meta.disclaimer}</p>}
    {meta?.chipsNote && <p class="sg-src">{meta.chipsNote}</p>}
    {meta?.equityNote && <p class="sg-src">{meta.equityNote}</p>}
    {meta?.maeMfeNote && <p class="sg-src">{meta.maeMfeNote}</p>}
    {meta?.source && <p class="sg-src">資料來源:{meta.source}</p>}
    {meta?.updatedAt && <p class="sg-src">資料產生時間:{meta.updatedAt}</p>}
  </section>
</Layout>

<script>
  import { createChart, CrosshairMode, type IChartApi, type ISeriesApi } from "lightweight-charts";
  import { getWatchlist } from "../lib/watchlist";
  import SUFFIX from "../lib/stockSuffix.json";
  import {
    computeLive, getResult, putResult, resultKey, marketOf, quota,
    idbAvailable, LiveBacktestError, MAX_RESULTS,
    type LiveResult, type Progress,
  } from "../lib/liveBacktest";

  interface Idx {
    confLayers: string[]; entryRules: string[]; exitRules: string[]; exitReasons: string[];
    comboFields: string[]; tradeFields: string[]; stocks: Stock[];
  }
  interface Chips { asof: string; priceAsof: string; 百分位5年?: Record<string, number>; [k: string]: unknown }
  interface Stock {
    code: string; name: string; market: string;
    期間: [string, string]; 交易日數: number;
    buyhold: { "總報酬%": number; "最大回撤%": number };
    confLayers: string[]; files: { signals: string; prices: string };
    combos: number; trades: number; chips: Chips | null;
    layerSummary: Record<string, number | string>[];
  }
  type Combo = { s: (number | null)[]; t: number[][] };
  interface Detail { code: string; combos: Combo[] }
  interface Prices { dates: string[]; o: number[]; h: number[]; l: number[]; c: number[]; v: number[] }

  const $ = (id: string) => document.getElementById(id);
  const app = $("sg-app");
  if (app) {
    /* canvas 圖表不吃 CSS var():一律傳解析後實色,並於 tw-theme-change 重套 */
    const rootCS = () => getComputedStyle(document.documentElement);
    const tc = (n: string, fb: string) => rootCS().getPropertyValue(n).trim() || fb;
    const inkA = (a: number) => `rgba(${tc("--ink", "255, 255, 255")}, ${a})`;
    const upC = () => tc("--up", "#e24f43");
    const downC = () => tc("--down", "#2fa572");

    const esc = (s: unknown) =>
      String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);
    const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : null);
    const fmt = (v: unknown, d = 2) => { const n = num(v); return n == null ? "—" : n.toFixed(d); };
    const sgn = (v: number) => (v > 0 ? "+" : "");
    const cls = (v: unknown) => { const n = num(v); return n == null ? "" : n > 0 ? "up" : n < 0 ? "down" : ""; };
    const sd = (v: unknown, d = 2) => { const n = num(v); return n == null ? "—" : sgn(n) + n.toFixed(d); };

    /* 現場計算用的視窗參數與位元圖 asof(build 時寫入,避免為查快取先載 889KB) */
    const ASOF = app.dataset.asof || "";
    const MONTHS = Number(app.dataset.months || 61);
    const BITS_ASOF = app.dataset.bitsAsof || "";

    let IDX: Idx | null = null;
    let stock: Stock | null = null;
    let detail: Detail | null = null;
    let prices: Prices | null = null;
    let layerIdx = 0;
    let comboIdx = -1;
    let sortKey = "tot";
    let sortDesc = true;
    const filters = new Set<string>();
    let range = "all";
    let chart: IChartApi | null = null;
    let candle: ISeriesApi<"Candlestick"> | null = null;
    let maSeries: ISeriesApi<"Line">[] = [];

    /** 欄位位置一律由 index 的 comboFields / tradeFields 查,不 hardcode 順序 */
    let F = { ei: 0, xi: 1, ci: 2, n: 3, win: 4, avg: 5, tot: 6, mdd: 7, hold: 8, skip: 9 };
    let T = { si: 0, ei: 1, xi: 2, ep: 3, xp: 4, rc: 5, r: 6, mae: 7, mfe: 8 };

    const fail = () => { $("sg-loading")!.hidden = true; $("sg-error")!.hidden = false; };

    fetch("/data/signals-index.json")
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((j: Idx) => {
        IDX = j;
        const cf = j.comboFields, tf = j.tradeFields;
        F = { ei: cf.indexOf("ei"), xi: cf.indexOf("xi"), ci: cf.indexOf("ci"), n: cf.indexOf("交易次數"),
              win: cf.indexOf("勝率%"), avg: cf.indexOf("平均報酬%"), tot: cf.indexOf("總報酬%"),
              mdd: cf.indexOf("最大回撤%"), hold: cf.indexOf("平均持有天數"), skip: cf.indexOf("skipped") };
        T = { si: tf.indexOf("si"), ei: tf.indexOf("ei"), xi: tf.indexOf("xi"), ep: tf.indexOf("ep"),
              xp: tf.indexOf("xp"), rc: tf.indexOf("rc"), r: tf.indexOf("r"), mae: tf.indexOf("mae"), mfe: tf.indexOf("mfe") };
        const order = renderTabs();
        $("sg-loading")!.hidden = true;
        $("sg-main")!.hidden = false;
        /* 深連結 ?code=XXXX(來自 /watchlist 的「看回測」);無效則退回第一檔 */
        const want = new URLSearchParams(location.search).get("code");
        const start = (want && order.includes(want) ? want : order[0]) as string | undefined;
        if (start) selectStock(start);
      })
      .catch(fail);

    /* ① 個股分頁:自選優先(自選來源 = lib/watchlist.ts,與 /watchlist 同一份) */
    function renderTabs(): string[] {
      const box = $("sg-tabs")!, note = $("sg-wlnote") as HTMLElement;
      const avail = IDX!.stocks;                       // 可用清單一律動態讀,不 hardcode
      const availCodes = avail.map((s) => s.code);
      const wl = getWatchlist();
      const wlHas = wl.filter((c) => availCodes.includes(c));   // 自選 ∩ 有回測
      const wlMiss = wl.filter((c) => !availCodes.includes(c)); // 自選但無回測
      const rest = availCodes.filter((c) => !wlHas.includes(c));
      const order = [...wlHas, ...rest];

      const byCode = new Map(avail.map((s) => [s.code, s]));
      const tab = (code: string, star: boolean) => {
        const s = byCode.get(code)!;
        return `<button class="stab${star ? " star" : ""}" type="button" role="tab" aria-selected="false" data-code="${esc(code)}">
          ${star ? '<span class="wl" aria-label="自選股">★</span>' : ""}<span class="code">${esc(code)}</span>${esc(s.name)}${
          s.market === "tpex" ? '<span class="mk">櫃</span>' : ""}</button>`;
      };
      box.innerHTML =
        wlHas.map((c) => tab(c, true)).join("") +
        (wlHas.length && rest.length ? '<span class="tabsep" aria-hidden="true"></span>' : "") +
        rest.map((c) => tab(c, false)).join("") +
        /* 自選但無預算資料:上市 → 可現場計算;上櫃 → TPEx 無 CORS,明確標示不支援 */
        wlMiss.map((c) => {
          const mk = marketOf(c, SUFFIX as Record<string, string>);
          if (mk === "twse") {
            return `<button class="stab live" type="button" role="tab" aria-selected="false"
              data-code="${esc(c)}" data-live="1" title="尚未預先計算,可由你的瀏覽器現場計算"
              ><span class="wl">★</span><span class="code">${esc(c)}</span><span class="na">可現場計算</span></button>`;
          }
          const why = mk === "tpex" ? "上櫃暫不支援" : "非上市個股";
          return `<button class="stab off" type="button" disabled aria-disabled="true"
             title="${esc(why)}"><span class="wl">★</span><span class="code">${esc(c)}</span><span class="na">${esc(why)}</span></button>`;
        }).join("");

      box.querySelectorAll<HTMLButtonElement>(".stab:not([disabled])").forEach((b) =>
        b.addEventListener("click", () =>
          b.dataset.live ? selectLive(b.dataset.code!) : selectStock(b.dataset.code!)));

      const liveCount = wlMiss.filter((c) => marketOf(c, SUFFIX as Record<string, string>) === "twse").length;
      const blockedCount = wlMiss.length - liveCount;
      if (!wl.length) {
        note.hidden = false;
        note.innerHTML = `目前顯示全部可回測標的(${avail.length} 檔)。到<a href="/watchlist">自選股</a>加入股票,這裡會優先顯示你的股票。`;
      } else if (wlMiss.length) {
        note.hidden = false;
        const parts: string[] = [];
        if (liveCount) parts.push(`${liveCount} 檔可由你的瀏覽器<b>現場計算</b>`);
        if (blockedCount) parts.push(`${blockedCount} 檔暫不支援(上櫃官方端點不允許瀏覽器直接存取)`);
        note.innerHTML = `你的自選有 ${parts.join("、")}。目前已預先計算 ${avail.length} 檔。`;
      } else {
        note.hidden = true;
        note.innerHTML = "";
      }
      return order;
    }

    /* ── 現場計算 ──────────────────────────────────────────────
     * 資料由【使用者瀏覽器】直接向臺灣證券交易所取得,結果只存在瀏覽器,不上傳。
     * 數值與預先計算的 signals/{code}.json 逐格相同(tests/reconcile-live.mjs 把關)。 */
    let liveAbort: AbortController | null = null;
    let liveBusy = false;
    /** 代號→中文名。現場計算的個股不在 signals-index 內,名字要另外查,
     *  否則會顯示「1101」而不是「台泥」,與預算股有視覺落差。
     *  與抓取並行載入 → 不增加等待時間;只在使用者真的選了現場計算個股時才抓。 */
    let nameMap: Record<string, string> | null = null;
    let namePromise: Promise<void> | null = null;
    function loadNames() {
      if (nameMap || namePromise) return namePromise ?? Promise.resolve();
      namePromise = fetch("/data/reports-index.json")
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => {
          const bt = j?.byTicker ?? {};
          nameMap = {};
          for (const k of Object.keys(bt)) nameMap[k] = bt[k]?.name ?? k;
        })
        .catch(() => { nameMap = {}; });
      return namePromise;
    }
    const nameOf = (code: string) =>
      IDX?.stocks.find((s) => s.code === code)?.name || nameMap?.[code] || code;

    /** 由 LiveResult 合成與預算股相容的 stock/detail/prices,讓十區塊完全共用 */
    function adoptLive(rec: LiveResult) {
      const m = rec.meta as Record<string, unknown>;
      stock = {
        code: rec.code,
        name: nameOf(rec.code),
        market: "twse",
        期間: (m["期間"] as [string, string]) ?? [rec.prices.dates[0]!, rec.prices.dates.at(-1)!],
        交易日數: (m["交易日數"] as number) ?? rec.barsCount,
        buyhold: rec.buyhold,
        confLayers: rec.confirmed ? (m["confLayers"] as string[]) : ["無"],
        files: { signals: "", prices: "" },
        combos: rec.combos.length,
        trades: rec.combos.reduce((a, c) => a + c.t.length, 0),
        chips: null,
        layerSummary: [],
        __live: rec,
      } as unknown as Stock;
      detail = { code: rec.code, combos: rec.combos } as unknown as Detail;
      prices = rec.prices as unknown as Prices;
    }

    function liveOf(): LiveResult | null {
      return (stock as unknown as { __live?: LiveResult })?.__live ?? null;
    }

    function livePanel(inner: string) {
      $("sg-main")!.hidden = false;
      $("sg-detail")!.innerHTML = "";
      $("sg-list")!.innerHTML = "";
      $("sg-kgrid")!.innerHTML = "";
      $("sg-chips")!.innerHTML = "";
      $("sg-layers")!.innerHTML = "";
      $("sg-bhcard")!.innerHTML = "";
      $("sg-lnote")!.textContent = "";
      $("sg-stk-adv")!.textContent = "";
      $("sg-stk-meta")!.textContent = "";
      $("sg-detail")!.innerHTML = `<div class="lvp">${inner}</div>`;
    }

    async function selectLive(code: string) {
      if (liveBusy) return;
      document.querySelectorAll<HTMLButtonElement>(".stab").forEach((b) => {
        const on = b.dataset.code === code;
        b.classList.toggle("active", on);
        if (!b.disabled) b.setAttribute("aria-selected", on ? "true" : "false");
        if (on) b.scrollIntoView({ block: "nearest", inline: "nearest" });
      });
      layerIdx = 0; comboIdx = -1; detail = null; prices = null; range = "all";
      stock = null;
      loadNames();
      $("sg-stk-top")!.innerHTML = `<span class="stk-name">${esc(nameOf(code))}</span>
        <span class="stk-code">${esc(code)}</span><span class="badge">尚未預先計算</span>`;
      ($("sg-tpex-note") as HTMLElement).hidden = true;

      /* 已算過就直接讀快取(秒開) */
      const cached = BITS_ASOF ? await getResult(resultKey(code, ASOF, BITS_ASOF)) : null;
      if (cached) { await loadNames(); adoptLive(cached); renderLiveAll(); return; }

      livePanel(`
        <div class="lv-head"><span class="lv-cap">現場計算回測</span>
          <h2>${esc(code)}</h2></div>
        <p class="lv-lead">此檔尚未預先計算。可由<b>你的瀏覽器</b>直接向臺灣證券交易所取得近
          ${IDX!.stocks.length ? MONTHS : 61} 個月日K,在本機算出 450 組回測。
          <span class="lv-sub">約 20–30 秒 · 資料不經過本站伺服器 · 結果只存在你的瀏覽器</span></p>
        <details class="lv-more"><summary>這是怎麼運作的?</summary>
          <ul>
            <li>日K 由你的瀏覽器直接向證交所公開端點取得,本站不轉發、不儲存。</li>
            <li>計算使用與本站預先計算<b>完全相同</b>的引擎,數值逐格一致。</li>
            <li>結果存在你瀏覽器的本機儲存空間,最多保留 ${MAX_RESULTS} 檔,可隨時清除。</li>
            <li>歷史月份會被快取,之後重算同一檔只需補抓當月。</li>
          </ul>
        </details>
        <div class="lv-actions"><button class="lv-btn" id="lv-go" type="button">開始計算</button></div>
        <p class="lv-status" id="lv-status" role="status"></p>`);
      $("lv-go")!.addEventListener("click", () => runLive(code));
    }

    async function runLive(code: string, resumeNote = "") {
      if (liveBusy) return;
      liveBusy = true;
      liveAbort = new AbortController();
      livePanel(`
        <div class="lv-head"><span class="lv-cap">現場計算中</span><h2>${esc(code)}</h2></div>
        ${resumeNote ? `<p class="lv-resume">${resumeNote}</p>` : ""}
        <p class="lv-phase" id="lv-phase" role="status">準備中…</p>
        <div class="lv-track" role="progressbar" aria-label="計算進度" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="0" id="lv-track"><i id="lv-fill" style="width:0"></i></div>
        <div class="lv-actions"><button class="lv-btn lv-btn--ghost" id="lv-cancel" type="button">取消</button></div>`);
      $("lv-cancel")!.addEventListener("click", () => liveAbort?.abort());

      let lastP: { done: number; total: number } | null = null;
      const onProgress = (p: Progress) => {
        if (p.phase === "fetch") lastP = { done: p.done, total: p.total };
        const phase = $("lv-phase"), fill = $("lv-fill"), track = $("lv-track");
        if (!phase || !fill || !track) return;
        let pct = 0, txt = "";
        if (p.phase === "fetch") {
          pct = Math.round((p.done / p.total) * 90);
          txt = `抓取日K… 第 ${p.done} / ${p.total} 個月` + (p.cacheHits ? `(${p.cacheHits} 個月來自本機快取)` : "");
        } else if (p.phase === "chips") { pct = 93; txt = "載入確認層資料…"; }
        else if (p.phase === "compute") { pct = 96; txt = "計算 450 組…"; }
        else { pct = 100; txt = "完成"; }
        phase.textContent = txt;
        fill.style.width = pct + "%";
        track.setAttribute("aria-valuenow", String(pct));
      };

      try {
        const rec = await computeLive(code, {
          asof: ASOF, months: MONTHS, signal: liveAbort.signal, onProgress,
        });
        const saved = await putResult(rec);
        await loadNames();          // 與抓取並行,此時通常已完成
        adoptLive(rec);
        renderLiveAll(saved.cached ? "" : "本機儲存空間不足,本次結果未快取(重新整理後會消失)。");
      } catch (e) {
        const err = e as LiveBacktestError & { name?: string };
        /* 取消也要給續傳提示:已抓的月份都在快取裡,不講使用者會以為要重等 20 秒 */
        if (err?.name === "AbortError") { renderLiveError(code, "cancel", lastP); }
        else { renderLiveError(code, err?.kind ?? "fetch", err?.progress ?? null); }
      } finally {
        liveBusy = false; liveAbort = null;
      }
    }

    function renderLiveError(code: string, kind: string, progress: { done: number; total: number } | null) {
      /* 訊息一律描述現象,不臆測原因 —— 瀏覽器分不出額度/維護/網路 */
      const MSG: Record<string, [string, string]> = {
        cancel: ["已取消計算。", ""],
        fetch: ["暫時取不到日K資料。", "已抓到的月份會保留,重試時不需重來。"],
        not_listed: ["查無此代號的上市日K資料。", "本功能僅支援上市個股。"],
        insufficient: ["此檔歷史資料不足以計算回測。", ""],
        engine: ["計算失敗。", ""],
        tpex: ["上櫃個股暫不支援現場計算。", "官方端點不允許瀏覽器直接存取。"],
      };
      const [msg, hint] = MSG[kind] ?? MSG.fetch;
      const resume = progress && progress.done > 0
        ? `<p class="lv-resume">已完成 ${progress.done} / ${progress.total} 個月,<b>重試將從中斷處繼續</b>,不需重等。</p>`
        : "";
      livePanel(`
        <div class="lv-head"><span class="lv-cap">現場計算</span><h2>${esc(code)}</h2></div>
        <p class="lv-err">${esc(msg)}</p>
        ${hint ? `<p class="lv-sub">${esc(hint)}</p>` : ""}
        ${resume}
        <div class="lv-actions"><button class="lv-btn" id="lv-retry" type="button">重試</button></div>`);
      $("lv-retry")!.addEventListener("click", () =>
        runLive(code, progress && progress.done > 0
          ? `接續上次:已有 ${progress.done} / ${progress.total} 個月在本機快取。` : ""));
    }

    /** 現場結果 → 完全套用預算股的十區塊渲染 */
    function renderLiveAll(warn = "") {
      const rec = liveOf();
      if (!rec) return;
      renderIdBlock(); renderChips(); renderLayers();
      renderKgrid(); renderAdvice(); renderList();
      const meta = $("sg-stk-meta")!;
      const cov = rec.covered != null && rec.covered < rec.barsCount
        ? ` · 確認層資料截至 ${rec.bitsAsof}(未涵蓋最後 ${rec.barsCount - rec.covered} 個交易日)`
        : rec.confirmed ? ` · 確認層資料截至 ${rec.bitsAsof}` : "";
      meta.innerHTML = `${rec.combos.length} 個組合 · ${rec.combos.reduce((a, c) => a + c.t.length, 0).toLocaleString("zh-TW")} 筆歷史交易` +
        `<span class="lv-tag">本機計算</span>` +
        `資料至 ${esc(rec.asof)}${esc(cov)}` +
        (warn ? `<span class="lv-warn">${esc(warn)}</span>` : "");
    }

    function selectStock(code: string) {
      stock = IDX!.stocks.find((s) => s.code === code) || null;
      if (!stock) return;
      document.querySelectorAll<HTMLButtonElement>(".stab").forEach((b) => {
        const on = b.dataset.code === code;
        b.classList.toggle("active", on);
        if (!b.disabled) b.setAttribute("aria-selected", on ? "true" : "false");
        if (on) b.scrollIntoView({ block: "nearest", inline: "nearest" });
      });
      layerIdx = 0; comboIdx = -1; detail = null; prices = null; range = "all";
      renderIdBlock(); renderChips(); renderLayers();
      $("sg-list")!.innerHTML = `<p class="sg-td-empty">載入中…</p>`;
      $("sg-detail")!.innerHTML = "";
      Promise.all([
        fetch("/data/" + stock.files.signals).then((r) => (r.ok ? r.json() : null)),
        fetch("/data/" + stock.files.prices).then((r) => (r.ok ? r.json() : null)),
      ]).then(([d, p]) => { detail = d; prices = p; renderKgrid(); renderAdvice(); renderList(); })
        .catch(() => { $("sg-list")!.innerHTML = `<p class="sg-td-empty">資料載入失敗</p>`; });
    }

    /* ② 個股標題塊 */
    function renderIdBlock() {
      const s = stock!;
      $("sg-stk-top")!.innerHTML = `
        <span class="stk-name">${esc(s.name)}</span>
        <span class="stk-code">${esc(s.code)}</span>
        <span class="badge">${esc(s.期間[0])} ~ ${esc(s.期間[1])}</span>
        <span class="badge">${s.交易日數.toLocaleString("zh-TW")} 根日K</span>
        <span class="badge">${s.market === "tpex" ? "上櫃" : "上市"}</span>
        <a class="stk-link" href="/report/${esc(s.code)}">個股報告 →</a>`;
      $("sg-stk-meta")!.textContent =
        `${s.combos} 個組合 · ${s.trades.toLocaleString("zh-TW")} 筆歷史交易` +
        (s.chips ? ` · 籌碼日 ${s.chips.asof} · 行情日 ${s.chips.priceAsof}` : " · 上櫃無官方籌碼");
    }

    /* ③ 摘要一句話(純統計描述,不得含買賣建議) */
    function renderAdvice() {
      const el = $("sg-stk-adv")!;
      if (!detail) { el.textContent = ""; return; }
      const list = detail.combos.filter((c) => c.s[F.ci] === layerIdx);
      const withT = list.filter((c) => Number(c.s[F.n]) > 0);
      if (!withT.length) { el.textContent = `此確認層下 ${list.length} 個組合全數無成交,無統計可述。`; return; }
      const bh = stock!.buyhold["總報酬%"];
      const beat = withT.filter((c) => (c.s[F.tot] as number) > bh).length;
      const med = (a: number[]) => { const b = [...a].sort((x, y) => x - y); const m = b.length >> 1;
        return b.length % 2 ? b[m]! : (b[m - 1]! + b[m]!) / 2; };
      el.textContent =
        `此層 ${list.length} 組中 ${withT.length} 組有成交,中位總報酬 ${med(withT.map((c) => c.s[F.tot] as number)).toFixed(1)}%、` +
        `中位勝率 ${med(withT.map((c) => num(c.s[F.win]) ?? 0)).toFixed(1)}%、中位交易 ${med(withT.map((c) => Number(c.s[F.n]))).toFixed(0)} 筆;` +
        `${beat} 組的歷史總報酬高於同期買進持有(${bh.toFixed(1)}%)。以上為歷史統計,非操作建議。`;
    }

    /* ④ 水平 KPI 帶 4 格 */
    function renderKgrid() {
      const s = stock!, box = $("sg-kgrid")!;
      const bh = s.buyhold;
      let best: Combo | null = null, beat = 0, total = 0, last: { d: string; rule: string } | null = null;
      if (detail) {
        const list = detail.combos.filter((c) => c.s[F.ci] === layerIdx);
        total = list.length;
        for (const c of list) {
          if (Number(c.s[F.n]) === 0) continue;
          const t = c.s[F.tot] as number;
          if (t > bh["總報酬%"]) beat++;
          if (!best || t > (best.s[F.tot] as number)) best = c;
          if (prices) {
            const lt = c.t[c.t.length - 1];
            if (lt) { const d = prices.dates[lt[T.si]!]!;
              if (!last || d > last.d) last = { d, rule: IDX!.entryRules[c.s[F.ei] as number]! }; }
          }
        }
      }
      const cell = (micro: string, val: string, ft: string) =>
        `<div class="kpi"><div class="micro">${esc(micro)}</div><div class="val">${val}</div><div class="ft" title="${esc(ft)}">${esc(ft)}</div></div>`;
      box.innerHTML = [
        cell("買進抱著", `<span class="${cls(bh["總報酬%"])}">${sd(bh["總報酬%"], 1)}%</span>`,
          `最大回撤 -${fmt(bh["最大回撤%"], 1)}%`),
        cell("歷史總報酬最高組合",
          best ? `<span class="${cls(best.s[F.tot])}">${sd(best.s[F.tot], 1)}%</span>` : "—",
          best ? `${IDX!.entryRules[best.s[F.ei] as number]} → ${IDX!.exitRules[best.s[F.xi] as number]}(統計最高,非推薦)` : "此層無成交"),
        cell("勝過買進持有", total ? `${beat}<span class="unit"> / ${total}</span>` : "—",
          "歷史總報酬高於同期買進持有的組合數"),
        cell("最近一次歷史訊號", last ? esc(last.d) : "—",
          last ? `${last.rule}(歷史紀錄,非當前建議)` : "此層無成交"),
      ].join("");
    }

    /* ⑤ 水平籌碼列:標籤在上、數值在下 */
    function renderChips() {
      const s = stock!, box = $("sg-chips")!;
      if (!s.chips) {
        /* 現場計算沒有官方籌碼列(那是資料端另外抓 T86/MI_MARGN/BWIBBU 產生的),
           與「上櫃不適用」是兩種不同原因,不可共用同一句話 */
        box.innerHTML = liveOf()
          ? `<div class="ki"><div class="kl">官方籌碼與估值</div><div class="kv ph">現場計算不提供<span class="ks">此列需資料端預先抓取 T86／MI_MARGN／BWIBBU</span></div></div>`
          : `<div class="ki"><div class="kl">官方籌碼與估值</div><div class="kv ph">上櫃・不適用<span class="ks">T86／MI_MARGN／BWIBBU 僅上市</span></div></div>`;
        return;
      }
      const c = s.chips, pct = c.百分位5年 || {};
      const ki = (label: string, inner: string) => `<div class="ki"><div class="kl">${esc(label)}</div>${inner}</div>`;
      const v = (val: unknown, unit = "", signed = false, sub = "") => {
        const n = num(val);
        const txt = n == null ? "—" : (signed ? sgn(n) : "") + n.toLocaleString("zh-TW", { maximumFractionDigits: 2 }) + unit;
        return `<div class="kv ${signed ? cls(n) : ""}">${txt}${sub ? `<span class="ks">${esc(sub)}</span>` : ""}</div>`;
      };
      const p = (k: string) => { const n = num(pct[k]); return n == null ? "" : `5年 ${n.toFixed(0)}%`; };
      box.innerHTML = [
        ki("投信 10 日", v(c["投信10日張"], " 張", true)),
        ki("外資 10 日", v(c["外資10日張"], " 張", true)),
        ki("融資 20 日變化", v(c["融資20日變化張"], " 張", true)),
        ki("券資比", v(c["券資比%"], "%")),
        ki("本益比", v(c["本益比"], "", false, p("本益比"))),
        ki("股價淨值比", v(c["股價淨值比"], "", false, p("股價淨值比"))),
        ki("殖利率", v(c["殖利率%"], "%", false, p("殖利率"))),
        ki("營收 YoY", `<div class="kv ph">—<span class="ks">Phase 2 · 自帶 FinMind 金鑰</span></div>`),
        ki("EPS 成長", `<div class="kv ph">—<span class="ks">Phase 2 · 自帶 FinMind 金鑰</span></div>`),
      ].join("");
    }

    /* ⑥ 確認層分頁 */
    function renderLayers() {
      const s = stock!, box = $("sg-layers")!;
      box.innerHTML = IDX!.confLayers.map((L) => {
        const i = s.confLayers.indexOf(L);
        const has = i >= 0;
        const label = L === "無" ? "原版" : L;
        return `<button class="lbtn${has && i === layerIdx ? " active" : ""}" type="button" role="tab"
          aria-selected="${has && i === layerIdx}" data-li="${i}" ${has ? "" : "disabled"}>${esc(label)}${
          has ? "" : '<span class="na">不適用</span>'}</button>`;
      }).join("");
      box.querySelectorAll<HTMLButtonElement>(".lbtn:not([disabled])").forEach((b) =>
        b.addEventListener("click", () => {
          layerIdx = Number(b.dataset.li); comboIdx = -1;
          renderLayers(); renderKgrid(); renderAdvice(); renderList();
        }));
      ($("sg-tpex-note") as HTMLElement).hidden = s.market !== "tpex";
    }

    /* ⑦ 左欄:B&H 卡 + 編號排行 */
    function currentList() {
      if (!detail) return [] as { c: Combo; i: number }[];
      const bh = stock!.buyhold["總報酬%"];
      let l = detail.combos.map((c, i) => ({ c, i })).filter((x) => x.c.s[F.ci] === layerIdx);
      if (filters.has("beat")) l = l.filter((x) => Number(x.c.s[F.n]) > 0 && (x.c.s[F.tot] as number) > bh);
      if (filters.has("win50")) l = l.filter((x) => (num(x.c.s[F.win]) ?? -1) >= 50);
      if (sortKey !== "rule") {
        const key = sortKey === "tot" ? F.tot : sortKey === "win" ? F.win : sortKey === "n" ? F.n : F.mdd;
        l = [...l].sort((a, b) => {
          const av = num(a.c.s[key]), bv = num(b.c.s[key]);
          if (av == null && bv == null) return 0;
          if (av == null) return 1;
          if (bv == null) return -1;
          return sortDesc ? bv - av : av - bv;
        });
      } else if (!sortDesc) l = [...l].reverse();
      return l;
    }

    function renderList() {
      const box = $("sg-list")!, s = stock!;
      const bh = s.buyhold;
      $("sg-bhcard")!.innerHTML =
        `<span class="tag">基準</span><span>買進持有</span>
         <b class="${cls(bh["總報酬%"])}">${sd(bh["總報酬%"], 1)}%</b>
         <span class="dd">最大回撤 -${fmt(bh["最大回撤%"], 1)}%</span>`;
      if (!detail) { box.innerHTML = `<p class="sg-td-empty">載入中…</p>`; return; }
      const list = currentList();
      const all = detail.combos.filter((c) => c.s[F.ci] === layerIdx);
      const zero = all.filter((c) => Number(c.s[F.n]) === 0).length;
      $("sg-lnote")!.textContent =
        `顯示 ${list.length} / ${all.length} 組` + (zero ? ` · 其中 ${zero} 組無交易` : "") +
        (sortKey === "rule" ? " · 規則順序" : " · 依績效排序(僅供比較,非推薦)");
      if (!list.length) { box.innerHTML = `<p class="sg-td-empty">沒有符合篩選的組合</p>`; renderDetail(null); return; }
      if (comboIdx < 0 || !list.some((x) => x.i === comboIdx)) comboIdx = list[0]!.i;
      const mx = Math.max(1, ...list.map((x) => Math.abs(num(x.c.s[F.tot]) ?? 0)));
      box.innerHTML = list.map(({ c, i }, k) => {
        const n = Number(c.s[F.n]), t = num(c.s[F.tot]);
        const w = t == null ? 0 : (Math.abs(t) / mx) * 100;
        return `<div class="row${i === comboIdx ? " sel" : ""}" data-i="${i}" role="option"
            tabindex="-1" aria-selected="${i === comboIdx}">
          <span class="rk">${String(k + 1).padStart(2, "0")}</span>
          <span class="rules">
            <span class="en">${esc(IDX!.entryRules[c.s[F.ei] as number])}</span>
            <span class="ex">${esc(IDX!.exitRules[c.s[F.xi] as number])}</span>
          </span>
          <span class="vals">
            <span class="tot ${cls(t)}">${n === 0 ? '<span class="none">無交易</span>' : sd(t, 1)}</span>
            <span class="sub">${n === 0 ? "—" : `${fmt(c.s[F.win], 0)}% · ${n} 筆`}</span>
          </span>
          <span class="spark"><i style="width:${w.toFixed(1)}%;background:var(--${(t ?? 0) >= 0 ? "up" : "down"})"></i></span>
        </div>`;
      }).join("");
      box.querySelectorAll<HTMLElement>(".row").forEach((r) =>
        r.addEventListener("click", () => { comboIdx = Number(r.dataset.i); renderList(); }));
      renderDetail(detail.combos[comboIdx]!);
      box.querySelector<HTMLElement>(".row.sel")?.scrollIntoView({ block: "nearest" });
    }

    /* 鍵盤:↑↓ 切換組合 */
    $("sg-list")?.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== "ArrowDown" && k !== "ArrowUp") return;
      e.preventDefault();
      const list = currentList();
      const at = list.findIndex((x) => x.i === comboIdx);
      const next = k === "ArrowDown" ? Math.min(at + 1, list.length - 1) : Math.max(at - 1, 0);
      if (list[next]) { comboIdx = list[next]!.i; renderList(); }
    });

    /* ⑧ 右欄詳情 */
    function renderDetail(c: Combo | null) {
      const box = $("sg-detail")!;
      if (!c) { box.innerHTML = ""; disposeChart(); return; }
      const s = c.s, n = Number(s[F.n]);
      const bh = stock!.buyhold["總報酬%"];
      const maeAvg = c.t.length ? c.t.reduce((a, t) => a + (t[T.mae] ?? 0), 0) / c.t.length : null;
      const K: [string, string, string][] = n === 0
        ? ["總報酬", "超額 vs 抱著", "勝率", "平均報酬", "平均持有", "最大回撤", "平均 MAE"]
            .map((k) => [k, '<span class="none">無交易</span>', ""] as [string, string, string])
        : [
            ["總報酬", `<span class="${cls(s[F.tot])}">${sd(s[F.tot], 1)}%</span>`, `${n} 筆交易`],
            ["超額 vs 抱著", `<span class="${cls((s[F.tot] as number) - bh)}">${sd((s[F.tot] as number) - bh, 1)}%</span>`, `B&H ${sd(bh, 1)}%`],
            ["勝率", `${fmt(s[F.win], 1)}%`, `約 ${Math.round(((num(s[F.win]) ?? 0) / 100) * n)} 勝 / ${n}`],
            ["平均報酬", `<span class="${cls(s[F.avg])}">${sd(s[F.avg], 2)}%</span>`, "每筆淨報酬"],
            ["平均持有", `${fmt(s[F.hold], 1)}`, "交易日(含頭尾)"],
            ["最大回撤", `<span class="down">-${fmt(s[F.mdd], 1)}%</span>`, "逐筆權益峰谷"],
            ["平均 MAE", maeAvg == null ? "—" : `<span class="down">${fmt(maeAvg, 1)}%</span>`, "持有期最大不利(毛值)"],
          ];
      const sk = Number(s[F.skip] ?? 0);
      box.innerHTML = `
        <div class="dhead">
          <div class="cap">組合詳情 · 確認層:${esc(stock!.confLayers[s[F.ci] as number])}</div>
          <h2>${esc(IDX!.entryRules[s[F.ei] as number])} <span class="arw">→</span> ${esc(IDX!.exitRules[s[F.xi] as number])}</h2>
          <p class="desc">進場:訊號成立【次日開盤】買進(開盤達漲停視為買不到)。出場:${esc(IDX!.exitRules[s[F.xi] as number])}。
            報酬已內扣手續費 0.1425%×2 與證交稅 0.3%,未計滑價。</p>
        </div>
        <div class="dstats">${K.map(([k, v, m]) =>
          `<div class="ds"><div class="k">${esc(k)}</div><div class="v">${v}</div><div class="m">${esc(m)}</div></div>`).join("")}</div>
        ${n === 0
          ? `<p class="sg-note">此組合在此確認層【無成交】—— 誠實呈現,不隱藏。</p>`
          : sk > 0 ? `<p class="sg-note">另有 ${sk} 次訊號成立但次日開盤已達漲停(≥ +9.95%)而買不到,未計入交易。</p>` : ""}
        <div class="lyrs"><div class="cap">確認層對照(同一組規則,中性比較)</div><div id="sg-lyrs"></div></div>
        <div class="pchart">
          <div class="cap">走勢與進出點
            <span class="rng" id="sg-rng" role="group" aria-label="期間切換">
              <button type="button" data-r="1y">1 年</button>
              <button type="button" data-r="3y">3 年</button>
              <button type="button" data-r="all">全部</button>
            </span>
          </div>
          <div class="pbox" id="sg-chart" role="img" aria-label="還原日K與進出點"></div>
          <div class="lg">
            <span><i style="background:var(--series-3)"></i>20 日均線</span>
            <span><i style="background:var(--series-5)"></i>60 日均線</span>
            <span><i class="tri up"></i>進場(訊號次日開盤)</span>
            <span><i class="tri down"></i>出場</span>
          </div>
        </div>
        <div class="eq"><div class="cap">逐筆權益曲線<span class="eqv" id="sg-eqv"></span></div><div id="sg-equity"></div></div>
        <div class="dtbl">
          <div class="cap">逐筆明細${n ? ` · ${n} 筆` : ""}</div>
          <div class="scroll"><table>
            <thead><tr><th class="l">#</th><th class="l">訊號日</th><th class="l">進場日</th><th class="l">出場日</th>
              <th>進場價</th><th>出場價</th><th>持有</th><th>淨報酬%</th><th>MAE%</th><th>MFE%</th><th class="l">出場原因</th></tr></thead>
            <tbody id="sg-trades"></tbody>
          </table></div>
        </div>`;
      renderLyrs(c); renderTrades(c); drawEquity(c);
      $("sg-rng")!.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
        b.classList.toggle("active", b.dataset.r === range);
        b.setAttribute("aria-pressed", b.dataset.r === range ? "true" : "false");
        b.addEventListener("click", () => { range = b.dataset.r!; renderDetail(detail!.combos[comboIdx]!); });
      });
      drawChart(c);
    }

    /* 確認層對照:水平長條 */
    function renderLyrs(c: Combo) {
      const host = $("sg-lyrs"); if (!host) return;
      const ei = c.s[F.ei], xi = c.s[F.xi];
      type Row = { li: number; label: string; n: number; t: number | null; m: Combo } | string;
      const rows: Row[] = IDX!.confLayers.map((L) => {
        const li = stock!.confLayers.indexOf(L);
        const label = L === "無" ? "原版" : L;
        if (li < 0) return `<div class="lrowc dead"><span class="lt">${esc(label)}</span>
          <span class="lm wide">上櫃・不適用(官方籌碼僅上市)</span></div>`;
        const m = detail!.combos.find((x) => x.s[F.ei] === ei && x.s[F.xi] === xi && x.s[F.ci] === li);
        if (!m) return "";
        return { li, label, n: Number(m.s[F.n]), t: num(m.s[F.tot]), m };
      });
      const vals = rows.filter((r): r is Exclude<Row, string> => typeof r !== "string");
      const mx = Math.max(1, ...vals.map((r) => Math.abs(r.t ?? 0)));
      host.innerHTML = rows.map((r) => {
        if (typeof r === "string") return r;
        const { li, label, n, t, m } = r;
        const w = t == null ? 0 : (Math.abs(t) / mx) * 100;
        return `<div class="lrowc${li === layerIdx ? " cur" : ""}" data-li="${li}" ${li === layerIdx ? "" : 'role="button" tabindex="0"'}>
          <span class="lt">${esc(label)}</span>
          <span class="lb"><i style="width:${w.toFixed(1)}%;background:var(--${(t ?? 0) >= 0 ? "up" : "down"})"></i></span>
          <span class="lv ${cls(t)}">${n === 0 ? '<span class="none">無交易</span>' : sd(t, 1) + "%"}</span>
          <span class="lm">${n === 0 ? "—" : `勝率 ${fmt(m.s[F.win], 0)}% · ${n} 筆 · 回撤 -${fmt(m.s[F.mdd], 1)}%`}</span>
        </div>`;
      }).join("");
      host.querySelectorAll<HTMLElement>(".lrowc[data-li]:not(.cur):not(.dead)").forEach((el) => {
        const go = () => { layerIdx = Number(el.dataset.li); comboIdx = -1;
          renderLayers(); renderKgrid(); renderAdvice(); renderList(); };
        el.addEventListener("click", go);
        el.addEventListener("keydown", (e) => {
          const k = (e as KeyboardEvent).key;
          if (k === "Enter" || k === " ") { e.preventDefault(); go(); }
        });
      });
    }

    /* 走勢圖(lightweight-charts;傳解析後實色) */
    function sma(arr: number[], p: number) {
      const out: (number | null)[] = []; let sum = 0;
      for (let i = 0; i < arr.length; i++) { sum += arr[i]!; if (i >= p) sum -= arr[i - p]!;
        out.push(i >= p - 1 ? sum / p : null); }
      return out;
    }
    function chartOpts() {
      return {
        autoSize: true,
        layout: { background: { color: "transparent" }, textColor: tc("--text-secondary", "#a09c92"), fontSize: 10 },
        grid: { vertLines: { color: inkA(0.04) }, horzLines: { color: inkA(0.04) } },
        rightPriceScale: { borderColor: inkA(0.1) },
        timeScale: { borderColor: inkA(0.1), rightOffset: 3 },
        crosshair: { mode: CrosshairMode.Normal },
      };
    }
    function disposeChart() { if (chart) { chart.remove(); chart = null; candle = null; maSeries = []; } }
    function drawChart(c: Combo | null) {
      const host = $("sg-chart"); if (!host) return;
      disposeChart();
      if (!prices || !prices.dates?.length) { host.innerHTML = `<p class="sg-td-empty">無價格資料</p>`; return; }
      const P = prices;
      const keep = range === "1y" ? 245 : range === "3y" ? 735 : P.dates.length;
      const from = Math.max(0, P.dates.length - keep);
      chart = createChart(host, chartOpts());
      candle = chart.addCandlestickSeries({ upColor: upC(), downColor: downC(), borderVisible: false,
        wickUpColor: upC(), wickDownColor: downC() });
      maSeries = [20, 60].map((p, k) => chart!.addLineSeries({
        color: k === 0 ? tc("--series-3", "#5b9ce6") : tc("--series-5", "#9085e9"),
        lineWidth: 1, priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false }));
      candle.setData(P.dates.slice(from).map((d, i) => ({ time: d, open: P.o[from + i]!, high: P.h[from + i]!,
        low: P.l[from + i]!, close: P.c[from + i]! })));
      [20, 60].forEach((p, k) => {
        const m = sma(P.c, p);
        maSeries[k]!.setData(P.dates.slice(from).map((d, i) => ({ time: d, value: m[from + i] }))
          .filter((x) => x.value != null) as { time: string; value: number }[]);
      });
      const marks = c ? c.t.flatMap((t) => {
        const out: { time: string; position: "belowBar" | "aboveBar"; color: string;
          shape: "arrowUp" | "arrowDown"; text: string }[] = [];
        if (t[T.ei]! >= from) out.push({ time: P.dates[t[T.ei]!]!, position: "belowBar", color: upC(), shape: "arrowUp", text: "進" });
        if (t[T.xi]! >= from) out.push({ time: P.dates[t[T.xi]!]!, position: "aboveBar", color: downC(), shape: "arrowDown", text: "出" });
        return out;
      }) : [];
      marks.sort((a, b) => (a.time < b.time ? -1 : a.time > b.time ? 1 : 0));
      candle.setMarkers(marks);
      chart.timeScale().fitContent();
    }
    window.addEventListener("tw-theme-change", () => {
      try {
        if (!chart) return;
        chart.applyOptions(chartOpts());
        candle?.applyOptions({ upColor: upC(), downColor: downC(), wickUpColor: upC(), wickDownColor: downC() });
        maSeries[0]?.applyOptions({ color: tc("--series-3", "#5b9ce6") });
        maSeries[1]?.applyOptions({ color: tc("--series-5", "#9085e9") });
        if (comboIdx >= 0 && detail) drawChart(detail.combos[comboIdx]!);
      } catch { /* 尚未就緒 */ }
    });

    /* 權益曲線(SVG:var() 可用,自動跟主題) */
    function drawEquity(c: Combo) {
      const host = $("sg-equity"), lab = $("sg-eqv");
      if (!host) return;
      if (!c.t.length) { host.innerHTML = `<p class="sg-td-empty">此組合無交易,無權益曲線。</p>`;
        if (lab) lab.textContent = ""; return; }
      let eq = 1; const pts = [0];
      for (const t of c.t) { eq *= 1 + t[T.r]! / 100; pts.push((eq - 1) * 100); }
      const W = 900, H = 110, PL = 4, PR = 4, PT = 8, PB = 8;
      const min = Math.min(...pts), max = Math.max(...pts), rg = max - min || 1;
      const x = (i: number) => PL + (i / (pts.length - 1 || 1)) * (W - PL - PR);
      const y = (v: number) => H - PB - ((v - min) / rg) * (H - PT - PB);
      const line = pts.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join("");
      const last = pts[pts.length - 1]!;
      const col = last >= 0 ? "var(--up)" : "var(--down)";
      const area = `${line}L${x(pts.length - 1).toFixed(1)},${y(min).toFixed(1)}L${x(0).toFixed(1)},${y(min).toFixed(1)}Z`;
      host.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" preserveAspectRatio="none"
          role="img" aria-label="逐筆權益曲線,共 ${c.t.length} 筆,終值 ${last.toFixed(2)}%">
        <path d="${area}" fill="${col}" opacity=".08"/>
        <line x1="${PL}" y1="${y(0).toFixed(1)}" x2="${W - PR}" y2="${y(0).toFixed(1)}"
          stroke="var(--border-strong)" stroke-dasharray="3 3" stroke-width="1" vector-effect="non-scaling-stroke"/>
        <path d="${line}" fill="none" stroke="${col}" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
      </svg>`;
      if (lab) lab.innerHTML = `<span class="${cls(last)}">終值 ${sd(last, 2)}%</span> · ${c.t.length} 筆複利`;
    }

    /* 逐筆明細 */
    function renderTrades(c: Combo) {
      const body = $("sg-trades"); if (!body) return;
      if (!c.t.length || !prices) { body.innerHTML = `<tr><td colspan="11" class="sg-td-empty">此組合無交易</td></tr>`; return; }
      const P = prices;
      body.innerHTML = c.t.map((t, i) => {
        /* 引擎「平均持有天數」= mean(xi-ei+1),交易日含頭尾;此處對齊同一定義 */
        const r = t[T.r]!, hold = t[T.xi]! - t[T.ei]! + 1;
        return `<tr>
          <td class="l dim">${i + 1}</td><td class="l dim">${esc(P.dates[t[T.si]!])}</td>
          <td class="l">${esc(P.dates[t[T.ei]!])}</td><td class="l">${esc(P.dates[t[T.xi]!])}</td>
          <td>${fmt(t[T.ep])}</td><td>${fmt(t[T.xp])}</td><td class="dim">${hold}</td>
          <td class="${cls(r)}">${sd(r)}</td>
          <td class="dim">${fmt(t[T.mae], 1)}</td><td class="dim">${fmt(t[T.mfe], 1)}</td>
          <td class="l rsn" title="${esc(IDX!.exitReasons[t[T.rc]!] ?? "")}">${esc(IDX!.exitReasons[t[T.rc]!] ?? "—")}</td></tr>`;
      }).join("");
    }

    /* 篩選 / 排序 */
    $("sg-filters")?.querySelectorAll<HTMLButtonElement>(".sg-chip").forEach((b) =>
      b.addEventListener("click", () => {
        const f = b.dataset.f!;
        if (filters.has(f)) filters.delete(f); else filters.add(f);
        b.classList.toggle("active", filters.has(f));
        b.setAttribute("aria-pressed", filters.has(f) ? "true" : "false");
        comboIdx = -1; renderList();
      }));
    $("sg-sort")?.addEventListener("change", (e) => {
      sortKey = (e.target as HTMLSelectElement).value; comboIdx = -1; renderList();
    });
    $("sg-sortdir")?.addEventListener("click", (e) => {
      sortDesc = !sortDesc;
      (e.currentTarget as HTMLElement).textContent = sortDesc ? "↓" : "↑";
      comboIdx = -1; renderList();
    });
  }
</script>

<style is:global>

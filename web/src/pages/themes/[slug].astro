---
import Layout from "../../layouts/Layout.astro";
import Bi from "../../components/Bi.astro";
import { MAP_PAGE, SITE, THEMES_PAGE } from "../../lib/ui";
import { sectorZh } from "../../lib/sector-i18n";
import fs from "node:fs";
import path from "node:path";

type MapCo = {
  t: string; n: string; s: string; ss: string; mc: number | null;
  subcat?: string; eps?: number | null; pe?: number | null; revYoy?: number | null; mom?: number;
  link?: string; status?: string;
};
type Indicator = { label: string; value: string };
type MapTheme = {
  slug: string;
  title: string;
  companyCount: number;
  desc?: string;
  category?: string;
  cagr?: string;
  marketSize?: string;
  indicators?: Indicator[];
  aggMcap: number;
  related: { label: string; slug: string | null }[];
  tiers: { u: MapCo[]; m: MapCo[]; d: MapCo[] };
};

export function getStaticPaths() {
  const p = path.join(process.cwd(), "public/data/themes-index.json");
  if (!fs.existsSync(p)) return [];
  const data = JSON.parse(fs.readFileSync(p, "utf8"));
  return ((data.themes ?? []) as { slug: string }[]).map((t) => ({ params: { slug: t.slug } }));
}

export const prerender = true;

const { slug } = Astro.params;

// 主資料來自 map-index(tiers 含市值/衍生欄位 + 已解析 related);缺檔則退回 themes-index。
const mapPath = path.join(process.cwd(), "public/data/map-index.json");
const themesPath = path.join(process.cwd(), "public/data/themes-index.json");
const mapData = fs.existsSync(mapPath)
  ? JSON.parse(fs.readFileSync(mapPath, "utf8"))
  : { themes: [] };
let theme = (mapData.themes as MapTheme[]).find((t) => t.slug === slug) || null;

if (!theme) {
  const td = fs.existsSync(themesPath)
    ? JSON.parse(fs.readFileSync(themesPath, "utf8"))
    : { themes: [] };
  const t = (td.themes ?? []).find((x: { slug: string }) => x.slug === slug);
  if (!t) return Astro.redirect("/map");
  const conv = (arr: any[]): MapCo[] =>
    (arr ?? []).map((c) => ({ t: c.ticker, n: c.name, s: c.sector, ss: c.sectorSlug || "", mc: null, subcat: c.subcat || "" }));
  theme = {
    slug: t.slug, title: t.title, companyCount: t.companyCount,
    desc: t.desc || "", category: t.category || "", cagr: t.cagr || "",
    marketSize: t.marketSize || "", indicators: t.indicators || [],
    aggMcap: 0, related: [],
    tiers: { u: conv(t.tiers.upstream), m: conv(t.tiers.midstream), d: conv(t.tiers.downstream) },
  };
}

const tierDefs: { key: "u" | "m" | "d"; label: string }[] = [
  { key: "u", label: THEMES_PAGE.tierUp },
  { key: "m", label: THEMES_PAGE.tierMid },
  { key: "d", label: THEMES_PAGE.tierDown },
];

// 個股熱力圖用:去重成分股(ticker、名稱、市值)
const seen = new Set<string>();
const cons: { t: string; n: string; mc: number | null }[] = [];
for (const k of ["u", "m", "d"] as const) {
  for (const c of theme.tiers[k]) {
    if (seen.has(c.t)) continue;
    seen.add(c.t);
    cons.push({ t: c.t, n: c.n, mc: c.mc });
  }
}

// 角色分群:每段依子分類分組(子分類空者歸「其他」排最後;單一空組則不顯示子標題)
function groupBySubcat(arr: MapCo[]) {
  const m = new Map<string, MapCo[]>();
  for (const c of arr) {
    const k = c.subcat || "";
    if (!m.has(k)) m.set(k, []);
    m.get(k)!.push(c);
  }
  const groups = [...m.entries()].map(([subcat, items]) => ({ subcat, items }));
  // 保留來源順序(策展 members = TPEx 節點順序);「其他」與無子分類者排最後。
  const last = (s: string) => s === "" || s === "其他";
  groups.sort((a, b) => (last(a.subcat) === last(b.subcat) ? 0 : last(a.subcat) ? 1 : -1));
  const flat = groups.length === 1 && groups[0].subcat === "";
  return { groups, flat };
}
function statusInfo(s?: string) {
  if (s === "lead") return { label: THEMES_PAGE.statusLead, cls: "lead" };
  if (s === "challenge") return { label: THEMES_PAGE.statusChallenge, cls: "challenge" };
  return null;
}
function linkLabel(l?: string) {
  return l === "high" ? THEMES_PAGE.linkHigh : l === "mid" ? THEMES_PAGE.linkMid : "";
}
// 動態營收動能標籤:依逐月年增/年減連續月數(1→營收年增/減、N→連N月年增/減,N 用阿拉伯數字)
function momTag(c: MapCo): { label: string; cls: string } | null {
  const s = c.mom ?? 0;
  if (!s) return null;
  const n = Math.abs(s);
  const dir = s > 0 ? "年增" : "年減";
  const cls = s > 0 ? "up" : "down";
  if (n === 1) return { label: `營收${dir}`, cls };
  return { label: `連${n}月${dir}`, cls };
}

const indicators = theme.indicators ?? [];
const aggMcapStr =
  theme.aggMcap >= 1e6
    ? `${(theme.aggMcap / 1e6).toFixed(2)} 兆`
    : theme.aggMcap > 0
      ? `${Math.round(theme.aggMcap / 100)} 億`
      : "";

const pageTitle = `${theme.title} — ${THEMES_PAGE.nav} — ${SITE.name}`;
---
<Layout title={pageTitle} description={`${theme.title} 供應鏈上中下游與成分股、當日漲跌`}>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/"><Bi zh="首頁" en="Home" /></a>
    <span class="bc-sep"> / </span>
    <a href="/map">{MAP_PAGE.nav}</a>
    <span class="bc-sep"> / </span>
    <span>{theme.title}</span>
  </div>

  <h1 class="page-h1">{theme.title}</h1>
  <p class="page-lead">
    {theme.category ? <span class="thm-cat-pill">{theme.category}</span> : null}
    {THEMES_PAGE.countLabel}：<strong>{theme.companyCount || cons.length || "—"}</strong>
    {aggMcapStr ? ` · 市值合計 ${aggMcapStr}` : ""}
  </p>

  <div class="theme-tabs" role="tablist" aria-label="題材檢視切換">
    <button class="theme-tab is-active" role="tab" aria-selected="true" data-ttab="overview">{THEMES_PAGE.tabOverview}</button>
    <button class="theme-tab" role="tab" aria-selected="false" data-ttab="structure">{THEMES_PAGE.tabStructure}</button>
  </div>

  <!-- ===== 總覽 ===== -->
  <section id="tpanel-overview" class="theme-panel" role="tabpanel">
    <div class="thov-card">
      {theme.desc ? <p class="thov-desc">{theme.desc}</p> : null}
      {(theme.cagr || theme.marketSize) && (
        <div class="thov-nums">
          {theme.cagr ? (
            <span class="thov-num"><span class="thov-num-l">{THEMES_PAGE.cagrLabel}</span><span class="thov-num-v">{theme.cagr}</span></span>
          ) : null}
          {theme.marketSize ? (
            <span class="thov-num"><span class="thov-num-l">{THEMES_PAGE.marketSizeLabel}</span><span class="thov-num-v">{theme.marketSize}</span></span>
          ) : null}
        </div>
      )}
    </div>

    {theme.related.length > 0 && (
      <p class="theme-related">
        <span class="theme-related-label">{THEMES_PAGE.related}：</span>
        {theme.related.map((r) =>
          r.slug ? (
            <a class="theme-rel-chip" href={`/themes/${encodeURIComponent(r.slug)}`}>{r.label}</a>
          ) : (
            <span class="theme-rel-chip is-plain">{r.label}</span>
          ),
        )}
      </p>
    )}

    {indicators.length > 0 && (
      <section class="thov-ind-sec" aria-label={THEMES_PAGE.indicatorsTitle}>
        <h2 class="theme-sec-h">{THEMES_PAGE.indicatorsTitle}</h2>
        <div class="thov-ind-grid">
          {indicators.map((it) => (
            <div class="thov-ind">
              <span class="thov-ind-ico" aria-hidden="true">↗</span>
              <span class="thov-ind-l">{it.label}</span>
              <span class="thov-ind-v">{it.value}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {cons.length > 0 && (
      <section class="theme-hm-sec" aria-label="題材個股熱力圖">
        <div class="hm-head">
          <h2 class="theme-sec-h">{THEMES_PAGE.heatTitle} <span class="theme-sec-sub">{THEMES_PAGE.heatSub}</span></h2>
          <div class="hmp-toggle" role="tablist" aria-label="期間切換">
            <button class="hmp-tab is-active" type="button" role="tab" aria-selected="true" data-hmp="d">{THEMES_PAGE.periodD}</button>
            <button class="hmp-tab" type="button" role="tab" aria-selected="false" data-hmp="w">{THEMES_PAGE.periodW}</button>
            <button class="hmp-tab" type="button" role="tab" aria-selected="false" data-hmp="m">{THEMES_PAGE.periodM}</button>
          </div>
        </div>
        <div id="theme-hm" class="theme-hm" role="img" aria-label={`${theme.title} 成分股成交額熱力圖`} />
        <div class="thm-legend" aria-label="漲跌色階(紅漲綠跌)">
          <span class="lg-end dn">跌</span>
          {[-6, -4.8, -3.6, -2.4, -1.2, 0, 1.2, 2.4, 3.6, 4.8, 6].map((p) => <i data-pct={p}></i>)}
          <span class="lg-end up">漲</span>
        </div>
      </section>
    )}

    <section class="thov-chain" aria-label={THEMES_PAGE.chainTitle}>
      <h2 class="theme-sec-h">{THEMES_PAGE.chainTitle}</h2>
      <p class="theme-sec-sub thov-chain-hint">{THEMES_PAGE.chainHint}</p>
      <div class="thov-chain-row">
        {tierDefs.map(({ key, label }) => (
          <button class="thov-chain-cell" type="button" data-goto-tier={key} disabled={theme.tiers[key].length === 0}>
            <span class="thov-chain-l">{label}</span>
            <span class="thov-chain-n">{theme.tiers[key].length}</span>
          </button>
        ))}
      </div>
    </section>
  </section>

  <!-- ===== 產業地圖(角色分群 / 差異比較) ===== -->
  <section id="tpanel-structure" class="theme-panel" role="tabpanel" hidden>
    <div class="sview-toggle" role="tablist" aria-label="檢視切換">
      <button class="sview-tab is-active" role="tab" aria-selected="true" data-sview="role">{THEMES_PAGE.viewRole}</button>
      <button class="sview-tab" role="tab" aria-selected="false" data-sview="compare">{THEMES_PAGE.viewCompare}</button>
    </div>

    <!-- 角色分群 -->
    <div id="sview-role">
      {tierDefs.map(({ key, label }) => {
        const tier = theme.tiers[key];
        if (tier.length === 0) return null;
        const { groups, flat } = groupBySubcat(tier);
        return (
          <section class="sc-tier" data-tier={key} aria-label={label}>
            <button class="sc-tier-head" type="button" aria-expanded="true">
              <span class="sc-tier-caret" aria-hidden="true">▾</span>
              <span class="sc-tier-title">{label}</span>
              <span class="sc-tier-n">{tier.length}</span>
            </button>
            <div class="sc-tier-body">
              {groups.map((g) => (
                <div class="sc-subgroup">
                  {!flat && (
                    <h3 class="sc-subhead">{g.subcat || "其他"} <span class="sc-subn">{g.items.length}</span></h3>
                  )}
                  <div class="sc-grid">
                    {g.items.map((c) => {
                      const st = statusInfo(c.status);
                      const ll = linkLabel(c.link);
                      const mt = momTag(c);
                      return (
                        <article class="sc-card2" data-t={c.t}>
                          <button class="sc-fav" type="button" data-fav-tk={c.t} title={THEMES_PAGE.fav} aria-label={`${THEMES_PAGE.fav} ${c.n}`}>☆</button>
                          <a class="sc-card2-main" href={`/report/${c.t}`}>
                            <span class="sc-nm-row">
                              <span class="sc-nm">{c.n}</span>
                              <span class="sc-tk">{c.t}</span>
                              {st ? <span class={`sc-status ${st.cls} sc-status-inline`}>{st.label}</span> : null}
                            </span>
                            <span class="sc-sec">{sectorZh(c.s)}</span>
                            <span class="sc-meta">EPS {c.eps != null ? `${c.eps} 元` : "—"}{c.pe != null && c.pe > 0 ? ` · 本益比 ${c.pe.toFixed(1)}` : ""}</span>
                          </a>
                          <div class="sc-card2-foot">
                            <div class="sc-foot-left">
                              {ll ? <span class="sc-link">{ll}</span> : <span class="sc-foot-top" aria-hidden="true"></span>}
                              <div class="sc-tags">{mt ? <span class={`sc-tag ${mt.cls}`}>{mt.label}</span> : null}</div>
                            </div>
                            <span class="sc-q" data-px><span class="sc-dash">—</span></span>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>


    <!-- 差異比較 -->
    <div id="sview-compare" hidden>
      <div class="cmp-wrap">
        <table class="cmp-table" id="cmp-table"><tbody><tr><td class="cmp-loading">{MAP_PAGE.loading}</td></tr></tbody></table>
      </div>
    </div>
  </section>

  <script type="application/json" id="theme-cons" set:html={JSON.stringify(cons)} />

  <script>
    import { treemap, tileColor, tileTextColor } from "../../lib/heatmap";
    import { getWatchlist, toggleWatch } from "../../lib/watchlist";

    interface Con { t: string; n: string; mc: number | null; }
    type Stat = { d: number[]; w: number[]; m: number[] };
    const dataEl = document.getElementById("theme-cons");
    const cons: Con[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    const pct: Record<string, number> = {};
    const px: Record<string, number> = {};
    const stats: Record<string, Stat> = {};
    let period: "d" | "w" | "m" = "d";

    function esc(s: string): string {
      return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
    }
    function fmtTwPrice(p: number): string {
      return p < 50 ? p.toFixed(2) : p < 500 ? p.toFixed(1) : p.toFixed(0);
    }

    // 熱力圖:磚塊大小＝期間成交額(億,sqrt 壓縮),顏色＝期間漲跌%(紅漲綠跌)
    function renderHm() {
      const root = document.getElementById("theme-hm");
      if (!root) return;
      const W = root.clientWidth, H = root.clientHeight;
      if (W < 10 || H < 10 || cons.length === 0) return;
      const withTov = cons
        .map((c) => {
          const s = stats[c.t];
          return s ? { ...c, chg: s[period][0], tov: s[period][1] } : null;
        })
        .filter((c): c is Con & { chg: number; tov: number } => !!c && c.tov > 0)
        .sort((a, b) => b.tov - a.tov)
        .slice(0, 36);
      if (withTov.length === 0) { root.innerHTML = `<p class="hm-empty">暫無成交額資料</p>`; return; }
      const nodes = withTov.map((c) => ({ ...c, value: Math.sqrt(c.tov) }));
      const laid = treemap(nodes, 0, 0, W, H);
      const G = 1;
      root.innerHTML = laid
        .map((c) => {
          const p = c.chg;
          const big = c.w > 54 && c.h > 26;
          const showP = p != null && c.w > 44 && c.h > 38;
          return `<a class="thm-tile" href="/report/${c.t}" style="left:${c.x + G}px;top:${c.y + G}px;width:${Math.max(0, c.w - 2 * G)}px;height:${Math.max(0, c.h - 2 * G)}px;background:${tileColor(p ?? null)};color:${tileTextColor(p ?? null)}">`
            + (big ? `<span class="thm-tile-t">${esc(c.n)}</span>` : "")
            + (showP ? `<span class="thm-tile-p">${p > 0 ? "+" : ""}${p.toFixed(2)}%</span>` : "")
            + `</a>`;
        })
        .join("");
    }

    function fillCards() {
      document.querySelectorAll<HTMLElement>(".sc-card2").forEach((card) => {
        const t = card.getAttribute("data-t");
        const slot = card.querySelector(".sc-q");
        if (!t || !slot) return;
        const p = pct[t], pv = px[t];
        if (p == null && pv == null) { slot.innerHTML = `<span class="sc-dash">—</span>`; return; }
        const priceStr = pv != null ? `<span class="sc-price">${fmtTwPrice(pv)}</span>` : "";
        const cls = p == null ? "flat" : p > 0 ? "up" : p < 0 ? "down" : "flat";
        const chgStr = p == null ? "" : `<span class="sc-chg ${cls}">${p > 0 ? "+" : ""}${p.toFixed(2)}%</span>`;
        slot.innerHTML = priceStr + chgStr;
      });
    }

    // 熱力圖資料:期間成交額/漲跌快照(每日 CI 更新)
    async function loadStats() {
      try {
        const r = await fetch("/data/heatmap-stats.json");
        if (r.ok) {
          const j = await r.json();
          Object.assign(stats, j.stats || {});
        }
      } catch { /* ignore */ }
      renderHm();
    }

    // 成分股卡片即時報價(quote-batch);與熱力圖快照分開
    async function load() {
      const tickers = cons.map((c) => c.t).filter((t) => /^\d{4}$/.test(t));
      const CHUNK = 110;
      const chunks: string[][] = [];
      for (let i = 0; i < tickers.length; i += CHUNK) chunks.push(tickers.slice(i, i + CHUNK));
      const res = await Promise.all(
        chunks.map((ch) =>
          fetch(`/api/quote-batch?symbols=${encodeURIComponent(ch.join(","))}`)
            .then((r) => (r.ok ? r.json() : null))
            .catch(() => null),
        ),
      );
      for (const r of res) {
        if (!r || !r.quotes) continue;
        for (const k of Object.keys(r.quotes)) {
          const v = r.quotes[k];
          if (!v) continue;
          if (typeof v.changePct === "number" && isFinite(v.changePct)) pct[k] = v.changePct;
          if (typeof v.price === "number" && isFinite(v.price)) px[k] = v.price;
        }
      }
      fillCards();
    }

    function initHmPeriod() {
      const tabs = Array.prototype.slice.call(document.querySelectorAll<HTMLButtonElement>(".hmp-tab"));
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          period = (tab.getAttribute("data-hmp") as "d" | "w" | "m") || "d";
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle("is-active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
          });
          renderHm();
        });
      });
    }

    // ---- 收藏 ☆(個股,沿用 watchlist) ----
    function initFavs() {
      const faved = new Set(getWatchlist());
      document.querySelectorAll<HTMLButtonElement>(".sc-fav").forEach((b) => {
        const tk = b.getAttribute("data-fav-tk") || "";
        if (faved.has(tk)) { b.textContent = "★"; b.classList.add("is-on"); }
        b.addEventListener("click", (e) => {
          e.preventDefault(); e.stopPropagation();
          const on = toggleWatch(tk);
          b.textContent = on ? "★" : "☆";
          b.classList.toggle("is-on", on);
        });
      });
    }

    // ---- 可收合分段 ----
    function initCollapse() {
      document.querySelectorAll<HTMLButtonElement>(".sc-tier-head").forEach((h) =>
        h.addEventListener("click", () => {
          const tier = h.closest(".sc-tier"); if (!tier) return;
          const open = h.getAttribute("aria-expanded") !== "false";
          h.setAttribute("aria-expanded", open ? "false" : "true");
          tier.classList.toggle("is-collapsed", open);
        }),
      );
    }

    // ---- 差異比較表(client 端 join screener-index) ----
    let screenerRows: Record<string, any> | null = null;
    let comparedOnce = false;
    async function renderCompare() {
      const table = document.getElementById("cmp-table"); if (!table) return;
      if (comparedOnce) return; comparedOnce = true;
      if (!screenerRows) {
        try {
          const j = await fetch("/data/screener-index.json").then((r) => r.json());
          screenerRows = {}; for (const r of j.rows || []) screenerRows[r.t] = r;
        } catch { screenerRows = {}; }
      }
      const f = (v: unknown, d = 1) => (typeof v === "number" && isFinite(v) ? (v as number).toFixed(d) : "—");
      const fi = (v: unknown) => (typeof v === "number" && isFinite(v) ? Math.round(v as number).toLocaleString("zh-TW") : "—");
      const rows = cons.slice().sort((a, b) => (b.mc ?? -1) - (a.mc ?? -1)).map((c) => {
        const r = (screenerRows as any)[c.t] || {};
        const yoy = r.revYoy;
        const yc = typeof yoy === "number" ? (yoy > 0 ? "up" : yoy < 0 ? "down" : "") : "";
        return `<tr><td class="cmp-tk">${c.t}</td><td>${esc(c.n)}</td><td class="num">${fi(r.mc)}</td>`
          + `<td class="num">${f(r.pe)}</td><td class="num">${f(r.roe)}</td><td class="num">${f(r.gm)}</td>`
          + `<td class="num ${yc}">${f(yoy)}</td></tr>`;
      }).join("");
      table.innerHTML = `<thead><tr><th>代號</th><th>名稱</th><th class="num">市值(百萬)</th><th class="num">P/E</th><th class="num">ROE%</th><th class="num">毛利%</th><th class="num">營收YoY%</th></tr></thead><tbody>${rows}</tbody>`;
    }

    function initSviews() {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".sview-tab"));
      tabs.forEach((tab) =>
        tab.addEventListener("click", () => {
          const k = tab.getAttribute("data-sview") || "role";
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle("is-active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
          });
          const panels: Record<string, HTMLElement | null> = {
            role: document.getElementById("sview-role"),
            compare: document.getElementById("sview-compare"),
          };
          for (const id of Object.keys(panels)) {
            const p = panels[id]; if (p) p.hidden = id !== k;
          }
          if (k === "compare") renderCompare();
        }),
      );
    }

    // ---- 分頁切換(?tab=overview|structure) ----
    function setTab(key: string, push: boolean) {
      const panels: Record<string, HTMLElement | null> = {
        overview: document.getElementById("tpanel-overview"),
        structure: document.getElementById("tpanel-structure"),
      };
      const k = panels[key] ? key : "overview";
      for (const id of Object.keys(panels)) {
        const p = panels[id]; if (p) p.hidden = id !== k;
      }
      document.querySelectorAll<HTMLButtonElement>(".theme-tab").forEach((b) => {
        const on = b.getAttribute("data-ttab") === k;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      if (k === "overview") renderHm(); // 切回總覽時重排熱力圖(隱藏時 clientWidth=0)
      if (push) {
        const qs = k === "overview" ? location.pathname : `?tab=structure`;
        history.replaceState(null, "", qs);
      }
    }
    function initTabs() {
      document.querySelectorAll<HTMLButtonElement>(".theme-tab").forEach((b) =>
        b.addEventListener("click", () => setTab(b.getAttribute("data-ttab") || "overview", true)),
      );
      // 總覽的價值鏈摘要 → 跳到產業地圖
      document.querySelectorAll<HTMLButtonElement>("[data-goto-tier]").forEach((b) =>
        b.addEventListener("click", () => {
          setTab("structure", true);
          const tier = b.getAttribute("data-goto-tier");
          const el = document.querySelector(`.sc-tier[data-tier="${tier}"]`);
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
        }),
      );
    }

    initTabs();
    initSviews();
    initCollapse();
    initFavs();
    initHmPeriod();
    // 色階圖例:與磚塊同一個 tileColor 上色,確保一致
    document.querySelectorAll<HTMLElement>(".thm-legend i[data-pct]").forEach((el) => {
      el.style.background = tileColor(parseFloat(el.dataset.pct || "0"));
    });
    const initial = new URLSearchParams(location.search).get("tab") === "structure" ? "structure" : "overview";
    setTab(initial, false);
    renderHm();
    loadStats();
    load();
    if (typeof ResizeObserver !== "undefined") {
      let t: number | undefined;
      const ro = new ResizeObserver(() => { window.clearTimeout(t); t = window.setTimeout(renderHm, 150); });
      const root = document.getElementById("theme-hm");
      if (root) ro.observe(root);
    }
  </script>


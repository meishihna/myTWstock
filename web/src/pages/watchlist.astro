---
import Layout from "../layouts/Layout.astro";
---

<Layout title="自選股 Watchlist — TWstock" description="你收藏追蹤的台股清單與關鍵財務指標。">
  <main class="wl">
    <header class="wl__head">
      <div>
        <h1 class="wl__h1">自選股</h1>
        <p class="wl__intro">收藏的標的存在此瀏覽器(localStorage)。在報告頁點 ☆ 加入。</p>
      </div>
      <div class="wl__actions">
        <span id="wl-count" class="wl__count" role="status"></span>
        <a id="wl-compare" class="wl__btn wl__btn--primary" href="/compare">並排比較</a>
        <a class="wl__btn" href="/screener">選股器</a>
      </div>
    </header>

    <div id="wl-body" class="wl__grid"></div>

    <div id="wl-empty" class="wl__empty" hidden>
      <div class="wl__empty-star">☆</div>
      <p>尚未收藏任何標的。</p>
      <p class="wl__empty-sub">到<a href="/sectors">報告頁</a>點 ☆ 加入,或用<a href="/screener">選股器</a>找標的。</p>
    </div>
  </main>

  <script>
    import { getWatchlist, removeWatch } from "../lib/watchlist";
    import { sectorZh } from "../lib/sector-i18n";

    type Row = Record<string, string | number | null>;
    const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : null);
    const fmt = (v: unknown, d = 1) => (num(v) == null ? "—" : (v as number).toFixed(d));
    const fmtInt = (v: unknown) => (num(v) == null ? "—" : Math.round(v as number).toLocaleString("zh-TW"));
    // 火花圖漲跌色沿用全站 token(--up 紅 / --down 綠),避免硬編碼漂移
    const _rootCss = getComputedStyle(document.documentElement);
    const UP_COLOR = _rootCss.getPropertyValue("--up").trim() || "#e24b4a";
    const DOWN_COLOR = _rootCss.getPropertyValue("--down").trim() || "#1d9e75";

    const metric = (label: string, val: string, cls = "") =>
      `<div class="wl__m"><dt>${label}</dt><dd class="${cls}">${val}</dd></div>`;
    const yoyMetric = (v: unknown) => {
      const n = num(v);
      if (n == null) return metric("年營收 YoY%", "—");
      const cls = n > 0 ? "is-pos" : n < 0 ? "is-neg" : "";
      const arrow = n > 0 ? "▲" : n < 0 ? "▼" : "";
      return metric("年營收 YoY%", `${arrow}${Math.abs(n).toFixed(1)}`, "wl__chg " + cls);
    };
    // 月營收異動提示:YoY + MoM(環比) + 加速度旗標。
    // 加速度=本月 YoY − 近6月均 YoY(pp),≥+25→「轉強」、≤-25→「轉弱」(真正的突然轉折);
    // 否則退回看 YoY 幅度(|≥30%|→大增/大減)。你追蹤的股票剛發動時一眼看到。
    const sign = (v: number) => (v > 0 ? "▲" : v < 0 ? "▼" : "");
    const scls = (v: number) => (v > 0 ? "is-pos" : v < 0 ? "is-neg" : "");
    const monthRevAlert = (
      mrY: unknown,
      mrP: unknown,
      mrMoM: unknown,
      mrAcc: unknown,
    ) => {
      const y = num(mrY);
      if (y == null || typeof mrP !== "string" || !mrP) return "";
      const mm = Number(mrP.slice(5, 7));
      const mLabel = Number.isFinite(mm) && mm ? `${mm}月` : mrP;
      const acc = num(mrAcc);
      const mom = num(mrMoM);
      let flag = "",
        cls = "";
      if (acc != null && acc >= 25) {
        flag = "轉強";
        cls = "wl__rev--surge";
      } else if (acc != null && acc <= -25) {
        flag = "轉弱";
        cls = "wl__rev--drop";
      } else if (Math.abs(y) >= 30) {
        flag = y > 0 ? "營收大增" : "營收大減";
        cls = y > 0 ? "wl__rev--surge" : "wl__rev--drop";
      }
      const accTitle =
        acc != null ? `加速度 ${acc > 0 ? "+" : ""}${acc.toFixed(0)}pp（本月YoY − 近6月均）` : "";
      const flagHtml = flag
        ? `<span class="wl__rev-flag" title="${accTitle}">${flag}</span>`
        : "";
      const momHtml =
        mom != null
          ? `<span class="wl__rev-sub">MoM <b class="${scls(mom)}">${sign(mom)}${Math.abs(mom).toFixed(1)}%</b></span>`
          : "";
      return (
        `<div class="wl__rev ${cls}">` +
        `<div class="wl__rev-top"><span class="wl__rev-lab">月營收 ${mLabel}</span>${flagHtml}</div>` +
        `<div class="wl__rev-nums"><span class="wl__rev-sub">YoY <b class="${scls(y)}">${sign(y)}${Math.abs(y).toFixed(1)}%</b></span>${momHtml}</div>` +
        `</div>`
      );
    };

    const $ = (id: string) => document.getElementById(id);
    let index: Record<string, Row> = {};

    interface Mini {
      points: number[];
      /** 與 points 對齊的 X 比例(0..1),依當日盤中時段時間定位;缺則等距 */
      xs?: number[];
      latest: number;
      change: number;
      changePct: number;
      state: string;
      time: string | null;
    }
    function sparkSvg(points: number[], xs: number[] | undefined, up: boolean): string {
      if (!points || points.length < 2) return "";
      const W = 92,
        H = 26,
        n = points.length;
      let mn = Infinity,
        mx = -Infinity;
      for (const v of points) {
        if (v < mn) mn = v;
        if (v > mx) mx = v;
      }
      const range = mx - mn || 1;
      // 有 xs(依當日時間定位)→ 盤中線只走到現在的位置;否則退回等距填滿整寬。
      const useXs = Array.isArray(xs) && xs.length === n;
      const xa = (i: number) => ((useXs ? xs![i]! : i / (n - 1)) * W).toFixed(1);
      const ya = (v: number) => (H - 1 - ((v - mn) / range) * (H - 2)).toFixed(1);
      let line = "";
      for (let i = 0; i < n; i++) line += (i ? " " : "") + xa(i) + "," + ya(points[i]!);
      const lastX = xa(n - 1); // 填色與線只延伸到最後一個點(盤中＝現在)
      const col = up ? UP_COLOR : DOWN_COLOR;
      return (
        `<svg class="wl__spark" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" aria-hidden="true">` +
        `<polygon points="${line} ${lastX},${H} 0,${H}" fill="${col}" fill-opacity="0.12"></polygon>` +
        `<polyline points="${line}" fill="none" stroke="${col}" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"></polyline></svg>`
      );
    }
    function hhmm(iso: string): string {
      try {
        return new Date(iso).toLocaleTimeString("zh-TW", {
          timeZone: "Asia/Taipei",
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });
      } catch {
        return "";
      }
    }
    function mmdd(iso: string): string {
      try {
        return new Date(iso).toLocaleDateString("zh-TW", {
          timeZone: "Asia/Taipei",
          month: "2-digit",
          day: "2-digit",
        });
      } catch {
        return "";
      }
    }
    function fillQuote(el: Element, q: Mini): void {
      const up = q.change > 0,
        down = q.change < 0;
      const hasChg = !(q.change === 0 && q.changePct === 0);
      const arrow = up ? "▲" : down ? "▼" : "";
      const chg = hasChg
        ? `<span class="wl__quote-chg ${up ? "is-up" : down ? "is-down" : ""}">${arrow} ${Math.abs(q.change).toFixed(2)}　${Math.abs(q.changePct).toFixed(2)}%</span>`
        : `<span class="wl__quote-chg">—</span>`;
      const open = q.state === "REGULAR";
      const state = open
        ? `<span class="wl__quote-state is-open"><i></i>盤中${q.time ? " · " + hhmm(q.time) : ""}</span>`
        : `<span class="wl__quote-state">收盤${q.time ? " · " + mmdd(q.time) : ""}</span>`;
      el.innerHTML = `${sparkSvg(q.points, q.xs, q.change >= 0)}<span class="wl__quote-price">${q.latest.toFixed(2)}</span>${chg}${state}`;
    }
    function hydrateQuotes(): void {
      const blocks = Array.from(
        document.querySelectorAll<HTMLElement>(".wl__quote[data-quote-tk]"),
      );
      if (!blocks.length) return;
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            obs.unobserve(el);
            const tk = el.getAttribute("data-quote-tk");
            fetch("/api/quote-mini/" + tk)
              .then((r) => (r.ok ? r.json() : null))
              .then((q) => {
                if (q && typeof q.latest === "number") fillQuote(el, q as Mini);
                else el.innerHTML = "";
              })
              .catch(() => {
                el.innerHTML = "";
              });
          }
        },
        { rootMargin: "600px" },
      );
      blocks.forEach((b) => io.observe(b));
    }

    function render() {
      const list = getWatchlist();
      const body = $("wl-body");
      const empty = $("wl-empty");
      const count = $("wl-count");
      const cmp = $("wl-compare") as HTMLAnchorElement | null;
      if (count) count.textContent = `${list.length} 檔`;
      if (cmp) {
        cmp.href = list.length ? `/compare?tickers=${list.join(",")}` : "/compare";
        cmp.classList.toggle("is-disabled", list.length < 2);
      }
      if (empty) (empty as HTMLElement).hidden = list.length > 0;
      if (!body) return;
      body.innerHTML = list
        .map((t) => {
          const r = index[t] || { t, n: "", s: "" };
          return `<article class="wl__item">
            <button class="wl__rm" data-rm="${t}" title="移除" aria-label="移除 ${t}">×</button>
            <a class="wl__item-head" href="/report/${t}">
              <div class="wl__head-left">
                <span class="tk-chip">${t}</span>
                <span class="wl__name">${r.n ?? ""}</span>
                <span class="wl__sector">${r.s ? sectorZh(String(r.s)) : "—"}</span>
              </div>
              <div class="wl__quote" data-quote-tk="${t}"><span class="wl__quote-load">···</span></div>
            </a>
            ${monthRevAlert(r.mrY, r.mrP, r.mrMoM, r.mrAcc)}
            <dl class="wl__metrics">
              ${metric("市值(百萬)", (r.me ? "~" : "") + fmtInt(r.mc))}
              ${metric("P/E", fmt(r.pe))}
              ${metric("ROE%", fmt(r.roe))}
              ${metric("毛利率%", fmt(r.gm))}
              ${metric("EPS", fmt(r.eps, 2))}
              ${yoyMetric(r.revYoy)}
            </dl>
          </article>`;
        })
        .join("");
      body.querySelectorAll("[data-rm]").forEach((b) =>
        b.addEventListener("click", (e) => {
          e.preventDefault();
          removeWatch(b.getAttribute("data-rm")!);
          render();
        }),
      );
      hydrateQuotes();
    }

    fetch("/data/screener-index.json")
      .then((r) => r.json())
      .then((j) => {
        for (const row of j.rows || []) index[row.t] = row;
        render();
      })
      .catch(render);
    render();
  </script>

  <style is:global>
    .wl { max-width: var(--layout-max); margin: 0 auto; padding: 1.75rem 0 3rem; }
    .wl__head {
      display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
      gap: 0.75rem 1rem; margin-bottom: 1.25rem;
    }
    .wl__h1 { font-family: var(--font-display); font-size: 1.6rem; margin: 0 0 0.2rem; letter-spacing: -0.01em; }
    .wl__en { color: var(--muted); font-weight: 400; font-size: 1rem; }
    .wl__intro { color: var(--muted); font-size: 0.85rem; margin: 0; }
    .wl__actions { display: flex; align-items: center; gap: 0.6rem; }
    .wl__count { color: var(--muted); font-size: 0.78rem; font-variant-numeric: tabular-nums; padding-right: 0.1rem; }
    .wl__btn {
      padding: 7px 15px; border-radius: var(--radius-sm, 8px); font-size: 0.85rem; font-weight: 600;
      text-decoration: none; color: var(--text);
      border: 1px solid var(--border); background: var(--surface-elevated);
      transition: border-color var(--duration) var(--ease-out), filter var(--duration) var(--ease-out), opacity var(--duration) var(--ease-out);
    }
    .wl__btn:hover { border-color: var(--accent); }
    .wl__btn--primary { color: var(--accent-ink); border-color: transparent; background: var(--accent); }
    .wl__btn--primary:hover { filter: brightness(1.08); border-color: transparent; }
    .wl__btn--primary.is-disabled { opacity: 0.4; pointer-events: none; }

    /* 卡片網格 — 沿用報告頁 .meta-card 視覺語言 */
    .wl__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 1rem;
    }
    .wl__item {
      position: relative; overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius-md);
      padding: 1.15rem 1.25rem 1.2rem;
      transition:
        border-color var(--duration) var(--ease-out),
        box-shadow var(--duration) var(--ease-out);
    }
    .wl__item::before { display: none; }
    .wl__item:hover {
      border-color: var(--accent-glow);
      box-shadow: var(--shadow-sm);
    }

    .wl__item-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; text-decoration: none; }
    .wl__head-left { display: flex; flex-direction: column; gap: 0.32rem; min-width: 0; }
    .wl__name {
      font-family: var(--font-display); font-size: 1.15rem; font-weight: 600;
      color: var(--text-heading, var(--text-heading)); letter-spacing: -0.01em; line-height: 1.3;
    }
    .wl__sector { font-size: 0.78rem; color: var(--muted); }

    /* 右上角:即時／當日走勢 + 報價 */
    .wl__quote { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; flex: 0 0 auto; min-width: 92px; text-align: right; margin-right: 18px; }
    .wl__quote-load { color: var(--muted); font-size: 0.95rem; opacity: 0.4; letter-spacing: 1px; }
    .wl__spark { display: block; margin-bottom: 2px; }
    .wl__quote-price { font-family: ui-monospace, monospace; font-size: 1.2rem; font-weight: 600; color: var(--text-heading, var(--text-heading)); line-height: 1.05; font-variant-numeric: tabular-nums; }
    .wl__quote-chg { font-family: ui-monospace, monospace; font-size: 0.74rem; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
    .wl__quote-chg.is-up { color: var(--up); }
    .wl__quote-chg.is-down { color: var(--down); }
    .wl__quote-state { display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; color: var(--muted); margin-top: 1px; }
    .wl__quote-state i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent, #d0a94e); display: inline-block; }

    .wl__metrics {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem 0.6rem; margin: 1rem 0 0;
    }
    .wl__m dt {
      font-size: 0.66rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--text-secondary); opacity: 0.85; margin-bottom: 3px; white-space: nowrap;
    }
    .wl__m dd {
      margin: 0; font-size: 0.98rem; font-weight: 600;
      font-variant-numeric: tabular-nums; font-family: ui-monospace, monospace;
      color: var(--text-heading, var(--text-heading));
    }
    .wl__chg.is-pos { color: var(--up); }
    .wl__chg.is-neg { color: var(--down); }

    /* 月營收異動提示:雙行(YoY+MoM+加速度旗標);紅增綠減、轉強紅/轉弱綠 */
    .wl__rev {
      display: flex; flex-direction: column; gap: 5px;
      margin: 0.9rem 0 0; padding: 7px 11px;
      border: 1px solid var(--border); border-radius: 8px;
      background: rgba(var(--ink), 0.03);
    }
    .wl__rev-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .wl__rev-lab { color: var(--text-secondary); font-weight: 600; font-size: 0.78rem; white-space: nowrap; }
    .wl__rev-nums { display: flex; flex-wrap: wrap; gap: 3px 16px; }
    .wl__rev-sub { font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }
    .wl__rev-sub b { font-family: ui-monospace, monospace; font-weight: 700; color: var(--text-heading, var(--text-heading)); }
    .wl__rev-sub b.is-pos { color: var(--up); }
    .wl__rev-sub b.is-neg { color: var(--down); }
    .wl__rev-flag {
      font-size: 0.68rem; font-weight: 700; padding: 2px 8px;
      border-radius: 999px; white-space: nowrap; cursor: help;
    }
    .wl__rev--surge { border-color: color-mix(in srgb, var(--up) 40%, transparent); background: color-mix(in srgb, var(--up) 8%, transparent); }
    .wl__rev--surge .wl__rev-flag { color: color-mix(in srgb, var(--up) 72%, var(--text)); background: color-mix(in srgb, var(--up) 15%, transparent); }
    .wl__rev--drop { border-color: color-mix(in srgb, var(--down) 40%, transparent); background: color-mix(in srgb, var(--down) 8%, transparent); }
    .wl__rev--drop .wl__rev-flag { color: color-mix(in srgb, var(--down) 72%, var(--text)); background: color-mix(in srgb, var(--down) 18%, transparent); }

    .wl__rm {
      position: absolute; top: 9px; right: 9px; z-index: 2;
      width: 26px; height: 26px; border-radius: 50%;
      background: transparent; border: none; cursor: pointer;
      color: var(--muted); font-size: 0.8rem; line-height: 1;
      opacity: 0; transition: opacity var(--duration) var(--ease-out), background var(--duration) var(--ease-out), color var(--duration) var(--ease-out);
    }
    .wl__item:hover .wl__rm,
    .wl__item:focus-within .wl__rm { opacity: 1; }
    .wl__rm:hover { background: color-mix(in srgb, var(--up) 15%, transparent); color: var(--up); }
    .wl__rm:focus-visible { opacity: 1; outline: 2px solid var(--accent); outline-offset: 2px; }
    /* 觸控裝置無 hover:移除鈕恆顯示,否則永遠點不到 */
    @media (hover: none) { .wl__rm { opacity: 1; } }

    .wl__empty { padding: 3.5rem 1.5rem; text-align: center; }
    .wl__empty-star { font-size: 2.4rem; color: var(--muted); opacity: 0.5; margin-bottom: 0.4rem; }
    .wl__empty p { margin: 0.2rem 0; color: var(--text); }
    .wl__empty-sub { color: var(--muted); font-size: 0.85rem; }
    .wl__empty a { color: var(--link-report); }

    @media (max-width: 640px) { .wl__head { align-items: flex-start; } }
  </style>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Bi from "../components/Bi.astro";
import { DISCOVER_PAGE, SITE, WIKI } from "../lib/ui";
import fs from "node:fs";
import path from "node:path";

const hubPath = path.join(process.cwd(), "public/data/wikilink-hub-top500.json");
let entries: { label: string; slug: string; count: number }[] = [];
if (fs.existsSync(hubPath)) {
  entries = (JSON.parse(fs.readFileSync(hubPath, "utf8")).entries) ?? [];
}

export const prerender = true;

const pageTitle = `${DISCOVER_PAGE.title} — ${SITE.name}`;
---
<Layout title={pageTitle} description={DISCOVER_PAGE.lead}>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/"><Bi zh="首頁" en="Home" /></a>
    <span class="bc-sep"> / </span>
    <span>{DISCOVER_PAGE.nav}</span>
  </div>
  <h1 class="page-h1">{DISCOVER_PAGE.title}</h1>
  <p class="page-lead">{DISCOVER_PAGE.lead}</p>

  <div class="map-tabs" role="tablist" aria-label="探索檢視切換">
    <button class="map-tab is-active" role="tab" aria-selected="true" data-dtab="keyword">{DISCOVER_PAGE.tabKeyword}</button>
    <button class="map-tab" role="tab" aria-selected="false" data-dtab="index">{DISCOVER_PAGE.tabIndex}</button>
  </div>

  <!-- 關鍵字全文搜尋 -->
  <section id="dpanel-keyword" role="tabpanel">
    <form class="discover-form" id="discover-form" action="#" method="get">
      <label class="discover-label" for="discover-q"><Bi zh="關鍵字" en="Keyword" /></label>
      <div class="discover-row">
        <input
          class="discover-input"
          type="search"
          id="discover-q"
          name="q"
          autocomplete="off"
          placeholder={DISCOVER_PAGE.placeholder}
          maxlength="120"
        />
        <button class="discover-btn" type="submit">{DISCOVER_PAGE.searchBtn}</button>
      </div>
    </form>
    <p class="discover-status" id="discover-status" aria-live="polite"></p>
    <ul class="discover-results" id="discover-results" hidden></ul>
    <section class="discover-cli-hint" aria-label="CLI">
      <p>{DISCOVER_PAGE.cliHint}</p>
      <pre class="discover-pre"><code>{DISCOVER_PAGE.cliCode}</code></pre>
    </section>
  </section>

  <!-- 高頻實體索引(原 /wiki) -->
  <section id="dpanel-index" role="tabpanel" hidden>
    <p class="page-lead">共 {entries.length} 條索引（依提及次數前 500）</p>
    <div class="wiki-table-wrap">
      <table class="company-table wiki-table">
        <thead>
          <tr>
            <th>#</th>
            <th>{WIKI.nav}</th>
            <th>{WIKI.count}</th>
          </tr>
        </thead>
        <tbody>
          {
            entries.map((e, i) => (
              <tr>
                <td>{i + 1}</td>
                <td>
                  <a href={`/wiki/${e.slug}`}>{e.label}</a>
                </td>
                <td>{e.count}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ DISCOVER_PAGE }}>
  (function () {
    // 分頁切換
    var tabs = Array.prototype.slice.call(document.querySelectorAll(".map-tab[data-dtab]"));
    var panels = {
      keyword: document.getElementById("dpanel-keyword"),
      index: document.getElementById("dpanel-index"),
    };
    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        var key = tab.getAttribute("data-dtab");
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        for (var k in panels) {
          if (panels[k]) panels[k].hidden = k !== key;
        }
      });
    });

    // 關鍵字全文搜尋
    var form = document.getElementById("discover-form");
    var input = document.getElementById("discover-q");
    var status = document.getElementById("discover-status");
    var list = document.getElementById("discover-results");
    if (!form || !input || !status || !list) return;

    function esc(s) {
      var d = document.createElement("div");
      d.textContent = s;
      return d.innerHTML;
    }

    function render(data) {
      list.innerHTML = "";
      if (!data.results || data.results.length === 0) {
        list.hidden = true;
        status.textContent = DISCOVER_PAGE.noResults;
        return;
      }
      status.textContent = (DISCOVER_PAGE.foundFormat || "").replace(/\{n\}/g, String(data.count));
      list.hidden = false;
      data.results.forEach(function (r) {
        var li = document.createElement("li");
        li.className = "discover-hit";
        var sec =
          r.sectorSlug && r.sector
            ? '<a href="/sectors/' + esc(r.sectorSlug) + '">' + esc(r.sector) + "</a>"
            : esc(r.sector || "");
        li.innerHTML =
          '<div class="discover-hit-head"><a href="/report/' +
          esc(r.ticker) +
          '"><strong>' +
          esc(r.ticker) +
          "</strong> " +
          esc(r.name) +
          "</a></div>" +
          '<div class="discover-hit-meta">' +
          sec +
          "</div>" +
          '<p class="discover-hit-excerpt">' +
          esc(r.excerpt) +
          "</p>";
        list.appendChild(li);
      });
    }

    // 前端關鍵字搜尋:載入一次靜態索引(CDN,線上可用),於瀏覽器內比對。
    // (原本打 /api/discover 在請求時讀 Pilot_Reports/*.md,Vercel serverless 讀不到 → 線上失效)
    var searchRows = null;
    function loadIndex() {
      if (searchRows) return Promise.resolve(searchRows);
      return fetch("/data/search-index.json")
        .then(function (r) {
          if (!r.ok) throw new Error("idx");
          return r.json();
        })
        .then(function (j) {
          searchRows = j.rows || [];
          return searchRows;
        });
    }
    function clientSearch(rows, q) {
      var ql = q.toLowerCase();
      var results = [];
      for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var text = r.x || "";
        var pos = text.indexOf(q);
        if (pos < 0) pos = text.toLowerCase().indexOf(ql);
        if (pos < 0) continue;
        var start = Math.max(0, pos - 50);
        var excerpt =
          (start > 0 ? "…" : "") +
          text.slice(start, start + 180).replace(/\s+/g, " ").trim() +
          (start + 180 < text.length ? "…" : "");
        results.push({ ticker: r.t, name: r.n, sector: r.s, sectorSlug: r.ss, excerpt: excerpt });
        if (results.length >= 150) break;
      }
      results.sort(function (a, b) {
        return a.ticker.localeCompare(b.ticker);
      });
      return { query: q, count: results.length, results: results };
    }
    function run(q) {
      status.textContent = DISCOVER_PAGE.searching;
      list.hidden = true;
      loadIndex()
        .then(function (rows) {
          render(clientSearch(rows, q));
        })
        .catch(function () {
          status.textContent = DISCOVER_PAGE.apiError;
          list.hidden = true;
        });
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var q = (input.value || "").trim();
      if (q.length < 2) {
        status.textContent = DISCOVER_PAGE.tooShort;
        list.hidden = true;
        return;
      }
      run(q);
    });

    var params = new URLSearchParams(window.location.search);
    var initial = params.get("q");
    if (initial && initial.trim().length >= 2) {
      input.value = initial;
      run(initial.trim());
    }
  })();
</script>

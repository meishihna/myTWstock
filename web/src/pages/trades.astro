---
/**
 * /trades — 投資組合(Phase 2 介面殼,終端佈局)
 *
 * 版面權威 = 本地版「投資組合儀表板」的骨架:
 *   報頭 kicker → 巨大淨值數字 → 目標軌道 → 4 格 KPI 帶
 *   → 01–07 編號區塊(金色 idx 徽章 + 標題 + 副標 + 髮絲線卡頭)
 * 密度與終端感對齊 /signals。
 *
 * ⚠️ 本頁【不讀取、不匯入、不連結】任何本機或第三方持股資料
 *    (不碰 永豐持股.xlsx、券商匯出檔、或任何真實持倉)。
 *    僅參考該儀表板的【版面結構】,未複製任何資料內容。
 *
 * 現階段【只有版型,零資料】。Phase 2 = 使用者登入後【手動輸入自己的交易】,
 * 系統以【公開股價】自動計算損益與績效;不代下單、不連接券商。
 */
import Layout from "../layouts/Layout.astro";
import { SITE, TRADES_PAGE } from "../lib/ui";

export const prerender = true;

/** 目標軌道刻度(Phase 2 由使用者自訂;此處為版型示意) */
const GOAL_TICKS = ["0", "25 萬", "50 萬", "75 萬", "100 萬"] as const;

/** 頭條下的 4 格 KPI */
const KPIS = [
  { label: "合計損益", foot: "已實現 + 未實現", meter: false },
  { label: "累積報酬 TWR", foot: "時間加權,排除現金流影響", meter: false },
  { label: "VS 0050 超額", foot: "同期對照 元大台灣50", meter: false },
  { label: "現金水位", foot: "現金占淨值比重", meter: true },
] as const;

const HOLDING_COLS = ["代號", "名稱", "股數", "均價", "現價", "市值", "未實現損益", "報酬率"];
const TX_COLS = ["日期", "代號", "買/賣", "股數", "價格", "手續費", "稅", "淨額"];
const WATCH_COLS = ["代號", "名稱", "現價", "距離目標價", "加入日", "想法"];

/** 06 月報的統計格 */
const MONTHLY_STATS = [
  { label: "當月報酬", wide: false },
  { label: "當月已實現", wide: false },
  { label: "當月現金流", wide: false },
  { label: "月底淨值", wide: true },
] as const;
---

<Layout
  title={`${TRADES_PAGE.title} — ${SITE.name}`}
  description="投資組合:登入後手動輸入你自己的交易,系統以公開股價計算損益與績效。你的資料只存在你的帳號、不公開。"
>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">首頁</a><span class="bc-sep"> / </span><span>{TRADES_PAGE.title}</span>
  </div>

  <div id="tr-app">
    {/* 隱私與範圍聲明(頂部,不折疊) */}
    <p class="tr-privacy" role="note">
      <b>你的資料只存在你的帳號、不公開。</b>
      本平台<b>不代下單、不連接券商</b>,也不會讀取任何本機檔案或券商匯出檔;
      損益由你自行輸入的交易搭配<b>公開股價</b>計算。
    </p>

    {/*
      登入區。三種狀態由 client 切換,伺服器端不參與(頁面是靜態殼、無任何使用者資料)。
      🔴 預設顯示【未登入引導】而不是空白 —— 未登入不可白畫面,也不可洩漏他人資料的形狀。
    */}
    <section class="tr-auth" id="tr-auth" aria-live="polite">
      <div class="tr-auth__box" data-state="loading">
        <p class="tr-auth__line" id="tr-auth-loading">正在確認登入狀態…</p>

        <div class="tr-auth__signedout" hidden>
          <div class="tr-auth__head">
            <b>登入後開始記錄你自己的交易</b>
            <span>不需要密碼 · 你的資料只存在你的帳號</span>
          </div>
          <div class="tr-auth__actions">
            <button class="tr-btn tr-btn--primary" type="button" id="tr-google">用 Google 登入</button>
            <form class="tr-auth__mail" id="tr-magic">
              <label class="sr-only" for="tr-email">電子郵件</label>
              <input
                id="tr-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                inputmode="email"
              />
              <button class="tr-btn" type="submit">寄登入連結</button>
            </form>
          </div>
          <p class="tr-auth__note" id="tr-auth-msg" role="status"></p>
        </div>

        <div class="tr-auth__signedin" hidden>
          <div class="tr-auth__head">
            <b>已登入</b>
            <span id="tr-who" class="tr-auth__who">—</span>
          </div>
          <button class="tr-btn" type="button" id="tr-signout">登出</button>
        </div>

        <div class="tr-auth__unconfigured" hidden>
          <div class="tr-auth__head">
            <b>登入尚未開通</b>
            <span id="tr-auth-cfg">—</span>
          </div>
          <p class="tr-auth__note">
            這是部署設定問題,不是你的操作問題。設定完成前,本頁維持唯讀預覽。
          </p>
        </div>
      </div>
    </section>

    {/* ① 報頭 + 巨大淨值 */}
    <section class="tr-hero" aria-labelledby="tr-hero-h">
      <div class="tr-kicker">
        <span class="rule" aria-hidden="true"></span>
        <span class="txt">每日投資簡報</span>
        <span class="dt" id="tr-date">—</span>
        <span class="tr-phase">{TRADES_PAGE.phase}</span>
      </div>
      <h1 class="tr-num" id="tr-hero-h">
        <span class="cur">NT$</span><span class="tr-na">—</span>
      </h1>
      <p class="tr-sub">
        vs 總存入 <b class="tr-na">—</b>
        <span class="sep" aria-hidden="true">·</span>
        證券 <b class="tr-na">—</b> ＋ 現金 <b class="tr-na">—</b>
      </p>

      {/* ② 目標獲利進度條 */}
      <div class="tr-goal">
        <div class="g-head">
          <span class="lbl">目標獲利進度</span>
          <span class="right">尚無資料 · <b>登入後設定你的目標</b></span>
        </div>
        <div
          class="g-track"
          role="progressbar"
          aria-label="目標獲利進度"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuetext="尚無資料"
        >
          <div class="g-fill" style="width:0"></div>
          {
            GOAL_TICKS.map((_, i) => (
              <span
                class:list={["g-station", { end: i === GOAL_TICKS.length - 1 }]}
                style={`left:${(i / (GOAL_TICKS.length - 1)) * 100}%`}
                aria-hidden="true"
              />
            ))
          }
        </div>
        {/* 刻度標籤是【軌道外】的獨立一列:與軌道同層會讓它們疊在軌道底色上(對比度會被誤算,也不是實際視覺) */}
        <div class="g-ticks">
          {
            GOAL_TICKS.map((t, i) => (
              <span
                class:list={["g-tick-lbl", { first: i === 0, last: i === GOAL_TICKS.length - 1 }]}
                style={`left:${(i / (GOAL_TICKS.length - 1)) * 100}%`}
              >{t}</span>
            ))
          }
        </div>
      </div>

      {/* ③ 4 格 KPI */}
      <div class="tr-stats">
        {
          KPIS.map((k) => (
            <div class="tr-stat">
              <div class="micro">{k.label}</div>
              <div class="value tr-na">—</div>
              {k.meter && (
                <div class="meter" aria-hidden="true">
                  <div style="width:0"></div>
                </div>
              )}
              <div class="foot">{k.foot}</div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ④ 01–07 編號區塊 */}
    <section class="tr-block" id="sec-perf">
      <div class="duo">
        <div class="panel">
          <div class="p-head">
            <span class="idx">01</span>
            <h2>績效走勢</h2>
            <span class="sub">淨值曲線與回撤</span>
          </div>
          <div class="plot" role="img" aria-label="淨值走勢圖(尚無資料)">
            <span class="plot-t">淨值 / 累積報酬</span>
            <span class="plot-e">{TRADES_PAGE.emptyCta}</span>
          </div>
          <div class="dd-head">
            <span class="t">回撤</span><span class="hint">自高點回落</span>
          </div>
          <div class="plot plot--sm" role="img" aria-label="回撤圖(尚無資料)">
            <span class="plot-e">尚無資料</span>
          </div>
        </div>

        <div class="panel">
          <div class="p-head">
            <span class="idx">02</span>
            <h2>資產配置</h2>
            <span class="sub">市值 vs 風險曝險</span>
          </div>
          <div class="alloc">
            <div class="alloc-donut" role="img" aria-label="配置比重圖(尚無資料)">
              <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true">
                <circle cx="50" cy="50" r="38" fill="none" stroke="var(--border)" stroke-width="11"></circle>
                <circle
                  cx="50"
                  cy="50"
                  r="38"
                  fill="none"
                  stroke="var(--border-strong)"
                  stroke-width="11"
                  stroke-dasharray="4 6"
                ></circle>
              </svg>
            </div>
            <ul class="alloc-list" aria-label="配置明細(尚無資料)">
              {
                ["產業／個股", "現金", "其他"].map((n) => (
                  <li class="a-row">
                    <span class="a-l">{n}</span>
                    <span class="a-track">
                      <i style="width:0"></i>
                    </span>
                    <span class="a-v tr-na">—</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="note">輸入交易後,這裡會依你的持倉自動分群。</p>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-holdings">
      <div class="panel">
        <div class="p-head">
          <span class="idx">03</span>
          <h2>現有持倉</h2>
          <span class="sub">成本、市值、未實現損益(金額單位:新台幣元)</span>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>{HOLDING_COLS.map((c, i) => <th scope="col" class:list={[{ l: i < 2 }]}>{c}</th>)}</tr>
            </thead>
            <tbody>
              <tr class="tr-empty">
                <td colspan={HOLDING_COLS.length}>{TRADES_PAGE.emptyCta}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-stock">
      <div class="panel">
        <div class="p-head">
          <span class="idx">04</span>
          <h2>個股走勢與買賣點</h2>
          <span class="sub">以公開收盤價繪製,標上你自己的進出點</span>
        </div>
        <div class="stock-flex">
          <div class="stock-list" aria-label="持股清單(尚無資料)">
            {
              [1, 2, 3, 4].map(() => (
                <div class="s-row" aria-hidden="true">
                  <span class="s-tk">—</span>
                  <span class="s-bar"><i style="width:0"></i></span>
                </div>
              ))
            }
            <p class="s-empty">尚無持股</p>
          </div>
          <div class="stock-main">
            <div class="plot" role="img" aria-label="個股走勢圖(尚無資料)">
              <span class="plot-t">個股走勢 + 你的買賣點</span>
              <span class="plot-e">選擇持股後,這裡會顯示走勢與你的買賣位置</span>
            </div>
            <p class="note">股價來源:臺灣證券交易所／證券櫃檯買賣中心公開收盤價(非即時報價)。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-tx">
      <div class="panel">
        <div class="p-head">
          <span class="idx">05</span>
          <h2>交易紀錄</h2>
          <span class="sub">由你自行輸入;不連接券商、不自動匯入</span>
        </div>
        <div class="tr-actions">
          <button class="tr-btn tr-btn--primary" type="button" id="tx-new" disabled>＋ 新增交易</button>
          <span class="tr-hint">Phase 2 · 登入後開放</span>
          <span class="tx-status" id="tx-status" role="status"></span>
        </div>

        {/* 新增/編輯表單。未登入時不顯示 —— 不給一個按了只會失敗的入口 */}
        <form class="tx-form" id="tx-form" hidden>
          <div class="tx-grid">
            <label>日期<input type="date" name="trade_date" required /></label>
            <label>代號<input type="text" name="ticker" required maxlength="5" placeholder="2330" /></label>
            <label>買/賣
              <select name="side">
                <option value="buy">買進</option>
                <option value="sell">賣出</option>
              </select>
            </label>
            <label>股數<input type="number" name="shares" required min="0" step="any" placeholder="1000" /></label>
            <label>價格<input type="number" name="price" required min="0" step="any" placeholder="100" /></label>
            <label>手續費<input type="number" name="fee" min="0" step="any" /></label>
            <label>證交稅<input type="number" name="tax" min="0" step="any" /></label>
            <label>同日序<input type="number" name="seq" min="0" step="1" value="0" /></label>
          </div>
          <p class="tx-note">
            手續費與證交稅會依 <b>0.1425%</b> 與 <b>0.3%</b> 自動帶入(與回測引擎同口徑),
            <b>可自行修改</b> —— 券商折扣、當沖減半都會讓實際值不同。同日多筆請用「同日序」決定先後,
            那是 FIFO 的排序依據。
          </p>
          <div class="tx-form-actions">
            <button class="tr-btn tr-btn--primary" type="submit" id="tx-save">儲存</button>
            <button class="tr-btn" type="button" id="tx-cancel">取消</button>
            <span class="tx-err" id="tx-err" role="alert"></span>
          </div>
        </form>

        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>
                {TX_COLS.map((c, i) => <th scope="col" class:list={[{ l: i < 3 }]}>{c}</th>)}
                <th scope="col">操作</th>
              </tr>
            </thead>
            <tbody id="tx-body">
              <tr class="tr-empty">
                <td colspan={TX_COLS.length + 1}>{TRADES_PAGE.emptyCta}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-monthly">
      <div class="panel">
        <div class="p-head">
          <span class="idx">06</span>
          <h2>月報</h2>
          <span class="sub">逐月報酬與現金流</span>
        </div>
        <div class="rz-stats">
          {
            MONTHLY_STATS.map((s) => (
              <div class:list={["rstat", { wide: s.wide }]}>
                <div class="micro">{s.label}</div>
                <div class:list={["value", "tr-na", { big: s.wide }]}>—</div>
              </div>
            ))
          }
        </div>
        <p class="note">輸入交易後,系統會自動產生逐月績效與現金流。</p>
      </div>
    </section>

    <section class="tr-block" id="sec-watch">
      <div class="panel">
        <div class="p-head">
          <span class="idx">07</span>
          <h2>觀察清單</h2>
          <span class="sub">尚未進場的追蹤標的</span>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>{WATCH_COLS.map((c, i) => <th scope="col" class:list={[{ l: i < 2 || i === 5 }]}>{c}</th>)}</tr>
            </thead>
            <tbody>
              <tr class="tr-empty">
                <td colspan={WATCH_COLS.length}>
                  Phase 2 會與<a href="/watchlist">自選股</a>整合:自選中的標的可直接加入並記錄想法。
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <p class="tr-foot" role="note">
      本頁為 Phase 2 介面預覽,尚未開放輸入,頁面上所有數值皆為空值示意。
      {TRADES_PAGE.privacy}
      本平台僅提供資訊與計算工具,不構成投資建議,亦不代為執行任何交易。
      紅=獲利、綠=虧損(台股慣例)。
    </p>
  </div>

  <script>
    /* 只填今天的日期;本頁不載入任何資料 */
    const el = document.getElementById("tr-date");
    if (el) {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, "0");
      el.textContent = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
    }
  </script>

  <script>
    /**
     * 登入狀態切換。輪 1 只做 auth —— 資料讀寫在輪 2。
     *
     * 🔴 這裡沒有任何「權限判斷」:能不能讀資料由資料庫的 RLS 決定,不由這段程式決定。
     *    這段只決定【畫面顯示哪一塊】。前端若寫錯,最壞是使用者看到錯的提示,
     *    不可能讓任何人讀到別人的資料。
     */
    import { getSupabase, supabaseConfigured, supabaseConfigError } from "../lib/supabaseClient";

    const box = document.querySelector<HTMLElement>("#tr-auth .tr-auth__box");
    const loading = document.getElementById("tr-auth-loading");
    const outEl = document.querySelector<HTMLElement>("#tr-auth .tr-auth__signedout");
    const inEl = document.querySelector<HTMLElement>("#tr-auth .tr-auth__signedin");
    const cfgEl = document.querySelector<HTMLElement>("#tr-auth .tr-auth__unconfigured");
    const msg = document.getElementById("tr-auth-msg");
    const who = document.getElementById("tr-who");

    /** 交易/觀察區塊的提示文字:登入前後說法不同,但兩者都不假裝功能已開放 */
    function setHints(signedIn: boolean) {
      document.querySelectorAll<HTMLElement>(".tr-hint").forEach((h) => {
        h.textContent = signedIn ? "輸入功能開發中" : "Phase 2 · 登入後開放";
      });
    }

    function show(which: "signedout" | "signedin" | "unconfigured") {
      if (loading) loading.hidden = true;
      if (box) box.dataset.state = which;
      if (outEl) outEl.hidden = which !== "signedout";
      if (inEl) inEl.hidden = which !== "signedin";
      if (cfgEl) cfgEl.hidden = which !== "unconfigured";
      setHints(which === "signedin");
    }

    if (!supabaseConfigured) {
      // fail closed:設定缺失就明說,不要退化成「看起來像未登入」
      const c = document.getElementById("tr-auth-cfg");
      if (c) c.textContent = supabaseConfigError ?? "設定缺失";
      show("unconfigured");
    } else {
      const sb = getSupabase()!;

      const render = (email: string | null | undefined) => {
        if (email) {
          if (who) who.textContent = email;
          show("signedin");
        } else {
          show("signedout");
        }
      };

      sb.auth.getSession().then(({ data }) => render(data.session?.user?.email));
      sb.auth.onAuthStateChange((_e, session) => render(session?.user?.email));

      const redirectTo = `${location.origin}/auth/callback`;

      document.getElementById("tr-google")?.addEventListener("click", async () => {
        const { error } = await sb.auth.signInWithOAuth({ provider: "google", options: { redirectTo } });
        if (error && msg) msg.textContent = `無法開始 Google 登入:${error.message}`;
      });

      document.getElementById("tr-magic")?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const input = document.getElementById("tr-email") as HTMLInputElement | null;
        const email = input?.value.trim();
        if (!email) return;
        if (msg) msg.textContent = "寄送中…";
        const { error } = await sb.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectTo } });
        if (msg) {
          msg.textContent = error
            ? `寄送失敗:${error.message}`
            : `已寄出登入連結到 ${email}。點擊信中的連結即可登入(連結有時效)。`;
        }
      });

      document.getElementById("tr-signout")?.addEventListener("click", async () => {
        await sb.auth.signOut();
      });

      /* ══ 輪 2:交易 CRUD + 雙實作比對 ══════════════════════════════════ */
      const {
        fetchTrades, insertTrade, updateTrade, deleteTrade,
        crossCheck, newCompareState, defaultFee, defaultTax,
      } = await import("../lib/tradesApp");

      const form = document.getElementById("tx-form") as HTMLFormElement | null;
      const body = document.getElementById("tx-body");
      const status = document.getElementById("tx-status");
      const errEl = document.getElementById("tx-err");
      const newBtn = document.getElementById("tx-new") as HTMLButtonElement | null;
      const cmp = newCompareState();
      let editingId: number | string | null = null;
      let uid: string | null = null;

      const fmt = (n: number, d = 2) =>
        n.toLocaleString("zh-TW", { minimumFractionDigits: d, maximumFractionDigits: d });

      function renderStatus() {
        if (!status) return;
        if (cmp.status === "diff") {
          // 平白說法:使用者不需要知道「FIFO 雙實作」是什麼
          status.textContent = `部分代號的數值待核(${[...cmp.pending].join("、")})`;
          status.dataset.tone = "warn";
        } else if (cmp.status === "error") {
          status.textContent = "數值核對未完成";
          status.dataset.tone = "warn";
        } else {
          status.textContent = "";
          status.dataset.tone = "";
        }
      }

      function renderTrades(rows: any[]) {
        if (!body) return;
        if (!rows.length) {
          body.innerHTML = `<tr class="tr-empty"><td colspan="9">還沒有交易紀錄。按「＋ 新增交易」開始記錄。</td></tr>`;
          return;
        }
        body.textContent = "";
        for (const r of rows) {
          const net = r.side === "buy"
            ? -(r.shares * r.price + r.fee)
            : r.shares * r.price - r.fee - r.tax;
          const tr = document.createElement("tr");
          const cells = [
            r.trade_date, r.ticker, r.side === "buy" ? "買進" : "賣出",
            fmt(r.shares, 0), fmt(r.price), fmt(r.fee), fmt(r.tax), fmt(net),
          ];
          for (const c of cells) {
            const td = document.createElement("td");
            td.textContent = c; // 🔴 textContent 不是 innerHTML:note/ticker 都是使用者輸入
            tr.appendChild(td);
          }
          const ops = document.createElement("td");
          const mk = (label: string, act: string) => {
            const b = document.createElement("button");
            b.type = "button"; b.className = "tx-op"; b.textContent = label;
            b.dataset.act = act; b.dataset.id = String(r.id);
            return b;
          };
          ops.append(mk("編輯", "edit"), mk("刪除", "del"));
          tr.appendChild(ops);
          body.appendChild(tr);
        }
      }

      let cache: any[] = [];
      async function reload() {
        cache = await fetchTrades(sb);
        renderTrades(cache);
        /**
         * 🔴 比對排在首次繪製【之後】,且不 await —— 資料先上畫面。
         *    幾千筆交易時,這個比對不可以是白畫面的原因。
         */
        queueMicrotask(() => {
          crossCheck(sb, cache, cmp).then(renderStatus);
        });
      }

      function fillDefaults() {
        if (!form) return;
        const f = new FormData(form);
        const shares = Number(f.get("shares")) || 0;
        const price = Number(f.get("price")) || 0;
        const side = String(f.get("side") || "buy") as "buy" | "sell";
        const feeEl = form.elements.namedItem("fee") as HTMLInputElement;
        const taxEl = form.elements.namedItem("tax") as HTMLInputElement;
        if (!feeEl.dataset.touched) feeEl.value = shares && price ? String(defaultFee(shares, price)) : "";
        if (!taxEl.dataset.touched) taxEl.value = shares && price ? String(defaultTax(side, shares, price)) : "";
      }
      form?.addEventListener("input", (ev) => {
        const t = ev.target as HTMLInputElement;
        if (t.name === "fee" || t.name === "tax") t.dataset.touched = "1";
        if (["shares", "price", "side"].includes(t.name)) fillDefaults();
      });

      function openForm(row?: any) {
        if (!form) return;
        form.hidden = false;
        editingId = row?.id ?? null;
        const set = (n: string, v: any) => ((form.elements.namedItem(n) as HTMLInputElement).value = v ?? "");
        set("trade_date", row?.trade_date ?? new Date().toISOString().slice(0, 10));
        set("ticker", row?.ticker ?? "");
        (form.elements.namedItem("side") as HTMLSelectElement).value = row?.side ?? "buy";
        set("shares", row?.shares ?? "");
        set("price", row?.price ?? "");
        set("fee", row?.fee ?? "");
        set("tax", row?.tax ?? "");
        set("seq", row?.seq ?? 0);
        (form.elements.namedItem("fee") as HTMLInputElement).dataset.touched = row ? "1" : "";
        (form.elements.namedItem("tax") as HTMLInputElement).dataset.touched = row ? "1" : "";
        if (errEl) errEl.textContent = "";
        (form.elements.namedItem("ticker") as HTMLInputElement).focus();
      }

      newBtn?.addEventListener("click", () => openForm());
      document.getElementById("tx-cancel")?.addEventListener("click", () => {
        if (form) form.hidden = true;
        editingId = null;
      });

      body?.addEventListener("click", async (ev) => {
        const b = (ev.target as HTMLElement).closest("button.tx-op") as HTMLButtonElement | null;
        if (!b) return;
        const row = cache.find((r) => String(r.id) === b.dataset.id);
        if (!row) return;
        if (b.dataset.act === "edit") return openForm(row);
        if (b.dataset.act === "del") {
          if (!confirm(`刪除 ${row.trade_date} ${row.ticker} 這筆紀錄?此動作無法復原。`)) return;
          try { await deleteTrade(sb, row.id); await reload(); }
          catch (e) { if (errEl) errEl.textContent = `刪除失敗:${(e as Error).message}`; }
        }
      });

      form?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        if (!uid) return;
        const f = new FormData(form);
        const payload = {
          ticker: String(f.get("ticker") || "").trim().toUpperCase(),
          trade_date: String(f.get("trade_date")),
          seq: Number(f.get("seq")) || 0,
          side: String(f.get("side")) as "buy" | "sell",
          shares: Number(f.get("shares")),
          price: Number(f.get("price")),
          fee: Number(f.get("fee")) || 0,
          tax: Number(f.get("tax")) || 0,
        };
        try {
          if (editingId != null) await updateTrade(sb, editingId, payload);
          else await insertTrade(sb, uid, payload);
          form.hidden = true;
          editingId = null;
          await reload();
        } catch (e) {
          // 資料庫的 check 約束(代號格式、股數 > 0…)會走到這裡 —— 照實顯示,不吞
          if (errEl) errEl.textContent = `儲存失敗:${(e as Error).message}`;
        }
      });

      // 登入狀態決定要不要載入資料
      const wire = async (session: any) => {
        uid = session?.user?.id ?? null;
        if (newBtn) newBtn.disabled = !uid;
        if (!uid) {
          if (form) form.hidden = true;
          if (body) body.innerHTML = `<tr class="tr-empty"><td colspan="9">登入後即可開始記錄你自己的交易。</td></tr>`;
          if (status) status.textContent = "";
          return;
        }
        await reload();
      };
      sb.auth.getSession().then(({ data }) => wire(data.session));
      sb.auth.onAuthStateChange((_e, session) => wire(session));
    }
  </script>
</Layout>


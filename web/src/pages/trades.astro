  /* ══ 交易輸入表單 ══ */
  .tx-status { font-size: 0.76rem; color: var(--text-secondary); }
  .tx-status[data-tone="warn"] { color: var(--accent-hover); font-weight: 600; }
  .tx-form {
    margin: 0.7rem 0 0.9rem; padding: 0.8rem; background: var(--bg);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .tx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px 12px; }
  .tx-grid label { display: flex; flex-direction: column; gap: 3px; font-size: 0.74rem; color: var(--text-secondary); }
  .tx-grid input, .tx-grid select {
    padding: 0.3rem 0.45rem; font: inherit; font-size: 0.82rem; color: var(--text);
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .tx-grid input:focus-visible, .tx-grid select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .tx-note { margin: 0.6rem 0 0; font-size: 0.74rem; line-height: 1.65; color: var(--text-secondary); }
  .tx-note b { color: var(--text); }
  .tx-form-actions { display: flex; align-items: center; gap: 8px; margin-top: 0.7rem; flex-wrap: wrap; }
  .tx-err { font-size: 0.76rem; color: var(--down, #2e9e5b); }
  .tx-op {
    font: inherit; font-size: 0.72rem; padding: 1px 7px; margin-right: 5px; cursor: pointer;
    color: var(--text-secondary); background: transparent;
    border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .tx-op:hover { color: var(--text); border-color: var(--accent); }
  .tx-op:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  /* ══ 持倉表 ══ */
  /* 賣超必須看得見:靜默的零最難查 */
  .hd-anomaly {
    margin: 0.6rem 0 0.2rem; padding: 0.55rem 0.8rem; font-size: 0.78rem; line-height: 1.65;
    color: var(--text); background: var(--surface);
    border: 1px solid var(--accent-glow); border-left: 3px solid var(--accent); border-radius: var(--radius-sm);
  }
  .hd-anomaly ul { margin: 0.35rem 0 0; padding-left: 1.1rem; }
  .hd-anomaly li { font-family: var(--font-mono); font-size: 0.76rem; }

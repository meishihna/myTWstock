---
/**
 * /trades — 投資組合(Phase 2 介面殼,終端佈局)
 *
 * 版面權威 = 本地版「投資組合儀表板」的骨架:
 *   報頭 kicker → 巨大淨值數字 → 目標軌道 → 4 格 KPI 帶
 *   → 01–07 編號區塊(金色 idx 徽章 + 標題 + 副標 + 髮絲線卡頭)
 * 密度與終端感對齊 /signals。
 *
 * ⚠️ 本頁【不讀取、不匯入、不連結】任何本機或第三方持股資料
 *    (不碰 永豐持股.xlsx、券商匯出檔、或任何真實持倉)。
 *    僅參考該儀表板的【版面結構】,未複製任何資料內容。
 *
 * 現階段【只有版型,零資料】。Phase 2 = 使用者登入後【手動輸入自己的交易】,
 * 系統以【公開股價】自動計算損益與績效;不代下單、不連接券商。
 */
import Layout from "../layouts/Layout.astro";
import { SITE, TRADES_PAGE } from "../lib/ui";

export const prerender = true;

/** 目標軌道刻度(Phase 2 由使用者自訂;此處為版型示意) */
const GOAL_TICKS = ["0", "25 萬", "50 萬", "75 萬", "100 萬"] as const;

/** 頭條下的 4 格 KPI */
const KPIS = [
  { key: "pnl", label: "合計損益", foot: "已實現 + 未實現", meter: false },
  /* TWR 與 VS 0050 需要【逐日重建部位 × 逐日股價】—— 那是時間序列輪的範圍,
     不是現值類。這裡維持留白,但 foot 會由 JS 補上「排在哪一輪」,
     🔴 不可讓它看起來像「算出來是沒有」。 */
  { key: "twr", label: "累積報酬 TWR", foot: "時間加權,排除現金流影響", meter: false },
  { key: "vs0050", label: "VS 0050 超額", foot: "同期對照 元大台灣50", meter: false },
  { key: "cash", label: "現金水位", foot: "現金占淨值比重", meter: true },
] as const;

const HOLDING_COLS = ["代號", "名稱", "股數", "均價", "現價", "市值", "未實現損益", "報酬率"];
const TX_COLS = ["日期", "代號", "買/賣", "股數", "價格", "手續費", "稅", "淨額"];
const WATCH_COLS = ["代號", "名稱", "現價", "距離目標價", "加入日", "想法"];

/** 06 月報的統計格 */
const MONTHLY_STATS = [
  { label: "當月報酬", wide: false },
  { label: "當月已實現", wide: false },
  { label: "當月現金流", wide: false },
  { label: "月底淨值", wide: true },
] as const;
---

<Layout
  title={`${TRADES_PAGE.title} — ${SITE.name}`}
  description="投資組合:登入後手動輸入你自己的交易,系統以公開股價計算損益與績效。你的資料只存在你的帳號、不公開。"
>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">首頁</a><span class="bc-sep"> / </span><span>{TRADES_PAGE.title}</span>
  </div>

  <div id="tr-app">
    {/* 隱私與範圍聲明(頂部,不折疊) */}
    <p class="tr-privacy" role="note">
      <b>你的資料只存在你的帳號、不公開。</b>
      本平台<b>不代下單、不連接券商</b>,也不會讀取任何本機檔案或券商匯出檔;
      損益由你自行輸入的交易搭配<b>公開股價</b>計算。
      <br />
      {/*
        🔴 架構承諾是「伺服器從不看到使用者資料」,但取價時代號清單會經過本站的報價代理,
           因而會出現在存取記錄裡。**承諾與實際資料流不一致時,要改的是承諾的措辭,
           不是把差異藏起來。** 詳見 docs/financials-known-limitations 的同名條目。

        🔴 2026-08-24(輪 7)更新措辭:淨值曲線需要【歷史持股】的日線,
           包含**已經出清的標的** —— 所以送出的不只是「現在持有的」,而是「曾持有過的」。
           **歷史持股比現有持股透露更多:那是交易歷史的形狀,不只是現在的部位。**
           措辭必須跟著實際資料流走。
      */}
      <b>一個例外要讓你知道:</b>取得股價時,<b>你曾持有過的股票代號會傳送到本站的報價代理</b>
      (交易明細、股數、成本、日期都不會)。
      <b>包含已經賣光的標的</b> —— 淨值曲線要算歷史,就得取那些代號的歷史股價。
      這比「現在持有什麼」透露更多:它是<b>交易歷史的形狀</b>。這是計算歷史績效無法避免的一步。
    </p>

    {/*
      登入區。三種狀態由 client 切換,伺服器端不參與(頁面是靜態殼、無任何使用者資料)。
      🔴 預設顯示【未登入引導】而不是空白 —— 未登入不可白畫面,也不可洩漏他人資料的形狀。
    */}
    <section class="tr-auth" id="tr-auth" aria-live="polite">
      <div class="tr-auth__box" data-state="loading">
        <p class="tr-auth__line" id="tr-auth-loading">正在確認登入狀態…</p>

        <div class="tr-auth__signedout" hidden>
          <div class="tr-auth__head">
            <b>登入後開始記錄你自己的交易</b>
            <span>不需要密碼 · 你的資料只存在你的帳號</span>
          </div>
          <div class="tr-auth__actions">
            <button class="tr-btn tr-btn--primary" type="button" id="tr-google">用 Google 登入</button>
            <form class="tr-auth__mail" id="tr-magic">
              <label class="sr-only" for="tr-email">電子郵件</label>
              <input
                id="tr-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                inputmode="email"
              />
              <button class="tr-btn" type="submit">寄登入連結</button>
            </form>
          </div>
          <p class="tr-auth__note" id="tr-auth-msg" role="status"></p>
        </div>

        <div class="tr-auth__signedin" hidden>
          <div class="tr-auth__head">
            <b>已登入</b>
            <span id="tr-who" class="tr-auth__who">—</span>
          </div>
          <button class="tr-btn" type="button" id="tr-signout">登出</button>
        </div>

        <div class="tr-auth__unconfigured" hidden>
          <div class="tr-auth__head">
            <b>登入尚未開通</b>
            <span id="tr-auth-cfg">—</span>
          </div>
          <p class="tr-auth__note">
            這是部署設定問題,不是你的操作問題。設定完成前,本頁維持唯讀預覽。
          </p>
        </div>
      </div>
    </section>

    {/* ① 報頭 + 巨大淨值 */}
    <section class="tr-hero" aria-labelledby="tr-hero-h">
      <div class="tr-kicker">
        <span class="rule" aria-hidden="true"></span>
        <span class="txt">每日投資簡報</span>
        <span class="dt" id="tr-date">—</span>
        <span class="tr-phase">{TRADES_PAGE.phase}</span>
      </div>
      <h1 class="tr-num" id="tr-hero-h">
        <span class="cur">NT$</span><span class="tr-na" id="tr-equity">—</span>
      </h1>
      <p class="tr-sub">
        vs 總存入 <b class="tr-na" id="tr-vsdep">—</b>
        <span class="sep" aria-hidden="true">·</span>
        證券 <b class="tr-na" id="tr-sec">—</b> ＋ 現金 <b class="tr-na" id="tr-cash">—</b>
      </p>
      {/* 🔴 恆等式的結果要看得見:合計損益 與 vs 總存入 是兩條不同的路,
          它們相等是定義逼出來的。不一致時必須說出來,不可只顯示其中一個。 */}
      <p class="tr-idcheck" id="tr-idcheck" role="status" hidden></p>

      {/* ② 目標獲利進度條 */}
      <div class="tr-goal">
        <div class="g-head">
          <span class="lbl">目標獲利進度</span>
          <span class="right">尚無資料 · <b>登入後設定你的目標</b></span>
        </div>
        <div
          class="g-track"
          role="progressbar"
          aria-label="目標獲利進度"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuetext="尚無資料"
        >
          <div class="g-fill" style="width:0"></div>
          {
            GOAL_TICKS.map((_, i) => (
              <span
                class:list={["g-station", { end: i === GOAL_TICKS.length - 1 }]}
                style={`left:${(i / (GOAL_TICKS.length - 1)) * 100}%`}
                aria-hidden="true"
              />
            ))
          }
        </div>
        {/* 刻度標籤是【軌道外】的獨立一列:與軌道同層會讓它們疊在軌道底色上(對比度會被誤算,也不是實際視覺) */}
        <div class="g-ticks">
          {
            GOAL_TICKS.map((t, i) => (
              <span
                class:list={["g-tick-lbl", { first: i === 0, last: i === GOAL_TICKS.length - 1 }]}
                style={`left:${(i / (GOAL_TICKS.length - 1)) * 100}%`}
              >{t}</span>
            ))
          }
        </div>
      </div>

      {/* ③ 4 格 KPI */}
      <div class="tr-stats">
        {
          KPIS.map((k) => (
            <div class="tr-stat">
              <div class="micro">{k.label}</div>
              <div class="value tr-na" id={`kpi-${k.key}`}>—</div>
              {k.meter && (
                <div class="meter" aria-hidden="true">
                  <div style="width:0" id={`kpi-${k.key}-meter`}></div>
                </div>
              )}
              <div class="foot" id={`kpi-${k.key}-foot`}>{k.foot}</div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ④ 01–07 編號區塊 */}
    <section class="tr-block" id="sec-perf">
      <div class="duo">
        <div class="panel">
          <div class="p-head">
            <span class="idx">01</span>
            <h2>績效走勢</h2>
            <span class="sub">淨值曲線與回撤</span>
          </div>
          {/* 🔴 佔位文字不可以陳述事實(輪 6 的教訓)——
              這裡的空狀態說「尚未計算」而不是「你沒有資料」。 */}
          <div class="plot" id="nv-plot" role="img" aria-label="淨值走勢圖">
            <span class="plot-t">淨值 / 累積報酬</span>
            <span class="plot-e" id="nv-empty">{TRADES_PAGE.emptyCta}</span>
          </div>
          <div class="dd-head">
            <span class="t">回撤</span><span class="hint">自高點回落</span>
          </div>
          <div class="plot plot--sm" id="dd-plot" role="img" aria-label="回撤圖">
            <span class="plot-e" id="dd-empty">尚未計算</span>
          </div>

          {/* 🔴 品質註記:填補次數 / 缺價天數 / 除權息事件都必須看得見。
              填補會把問題抹平,而看不見的抹平就是靜默錯誤。 */}
          <p class="nv-quality" id="nv-quality" role="status"></p>
          <ul class="nv-events" id="nv-events" hidden></ul>

          {/* 🔴 D:逐日抽點。
              D 的期望值是【使用者自己的】逐日位置,那份資料在線上 ——
              所以 D 不可能是 repo 裡的單元測試。它必須是使用者跑得起來的東西。 */}
          <details class="nv-probe">
            <summary>逐日抽點(核對某一天的現金與持股)</summary>
            <p class="nv-why">
              輸入日期 → 顯示<b>該日收盤後</b>的現金與逐檔股數。
              🔴 這是驗<b>逐日位置</b>的唯一方式 ——
              「現金累加 == 現在的現金」那條在<b>日期全錯時照樣通過</b>,它只驗總量。
            </p>
            <div class="nv-probe-row">
              <label class="sr-only" for="nv-date">抽點日期</label>
              <input type="date" id="nv-date" />
              <button class="tr-btn" type="button" id="nv-probe-go">查這一天</button>
            </div>
            <p class="nv-probe-out" id="nv-probe-out" role="status"></p>
          </details>
        </div>

        <div class="panel">
          <div class="p-head">
            <span class="idx">02</span>
            <h2>資產配置</h2>
            <span class="sub">市值 vs 風險曝險</span>
          </div>
          <div class="alloc">
            <div class="alloc-donut" id="alloc-donut" role="img" aria-label="配置比重圖">
              <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true">
                <circle cx="50" cy="50" r="38" fill="none" stroke="var(--border)" stroke-width="11"></circle>
                <circle
                  cx="50"
                  cy="50"
                  r="38"
                  fill="none"
                  stroke="var(--border-strong)"
                  stroke-width="11"
                  stroke-dasharray="4 6"
                ></circle>
              </svg>
            </div>
            <ul class="alloc-list" id="alloc-list" aria-label="配置明細">
              {
                ["產業／個股", "現金", "其他"].map((n) => (
                  <li class="a-row">
                    <span class="a-l">{n}</span>
                    <span class="a-track">
                      <i style="width:0"></i>
                    </span>
                    <span class="a-v tr-na">—</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="note" id="alloc-note">輸入交易後,這裡會依你的持倉自動分群。</p>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-holdings">
      <div class="panel">
        <div class="p-head">
          <span class="idx">03</span>
          <h2>現有持倉</h2>
          <span class="sub">成本、市值、未實現損益(金額單位:新台幣元)</span>
        </div>

        {/* 賣超警告:必須指名。持倉自然變 0 看起來完全正常,而使用者以為自己賣光了 */}
        <div class="hd-anomaly" id="hd-anomaly" role="alert" hidden></div>

        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>{HOLDING_COLS.map((c, i) => <th scope="col" class:list={[{ l: i < 2 }]}>{c}</th>)}</tr>
            </thead>
            <tbody id="hd-body">
              <tr class="tr-empty">
                <td colspan={HOLDING_COLS.length}>{TRADES_PAGE.emptyCta}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="hd-foot" id="hd-foot"></p>
      </div>
    </section>

    <section class="tr-block" id="sec-stock">
      <div class="panel">
        <div class="p-head">
          <span class="idx">04</span>
          <h2>個股走勢與買賣點</h2>
          <span class="sub">以公開收盤價繪製,標上你自己的進出點</span>
        </div>
        {/*
          🔴 2026-08-22 修:這一區【整塊都是靜態 markup】,從來沒有被 JS 接上,
             而它寫死了一句「尚無持股」—— 於是同一頁的 03 現有持倉有 6 檔、
             這裡卻說沒有持股。矛盾出現過兩輪。

             成因不是渲染時序、也不是資料流:**是佔位文字陳述了一個事實。**
             「尚無持股」與「算出來的結果」在畫面上長得一模一樣,
             所以真實資料一到就自相矛盾,而且沒人分得清是 bug 還是未實作。

             → 守則:**佔位文字不可以陳述事實。** 要嘛接上真資料,
               要嘛說「此區尚未實作」——不可以替使用者的資料下結論。

             左側清單只需要【持倉】,現值類資料現在就有 → 接上。
             右側走勢圖需要【逐日股價】,那是時間序列輪 → 明說排在哪一輪,不假裝沒資料。
        */}
        <div class="stock-flex">
          <div class="stock-list" id="stk-list" aria-label="持股清單"></div>
          <div class="stock-main">
            <div class="plot" role="img" aria-label="個股走勢圖(尚未實作)">
              <span class="plot-t">個股走勢 + 你的買賣點</span>
              <span class="plot-e" id="stk-plot-note"
                >走勢圖需要逐日收盤價,排在<b>時間序列輪</b>(與淨值曲線、回撤、TWR 同一批)</span
              >
            </div>
            <p class="note">股價來源:臺灣證券交易所／證券櫃檯買賣中心公開收盤價(非即時報價)。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-tx">
      <div class="panel">
        <div class="p-head">
          <span class="idx">05</span>
          <h2>交易紀錄</h2>
          <span class="sub">由你自行輸入;不連接券商、不自動匯入</span>
        </div>
        <div class="tr-actions">
          <button class="tr-btn tr-btn--primary" type="button" id="tx-new" disabled>＋ 新增交易</button>
          {/* 貼上匯入獨立一頁:那是「貼上 → 預覽 → 確認 → 對帳 → 撤銷」的多步流程,
              放進本頁會讓本頁多出一整條只在匯入時才走的分支。 */}
          <a class="tr-btn" href="/trades/import">⇱ 從試算表匯入</a>
          <span class="tr-hint">Phase 2 · 登入後開放</span>
          <span class="tx-status" id="tx-status" role="status"></span>
        </div>

        {/* 新增/編輯表單。未登入時不顯示 —— 不給一個按了只會失敗的入口 */}
        <form class="tx-form" id="tx-form" hidden>
          <div class="tx-grid">
            <label>日期<input type="date" name="trade_date" required /></label>
            <label>代號<input type="text" name="ticker" required maxlength="5" placeholder="2330" /></label>
            <label>買/賣
              <select name="side">
                <option value="buy">買進</option>
                <option value="sell">賣出</option>
              </select>
            </label>
            <label>股數<input type="number" name="shares" required min="0" step="any" placeholder="1000" /></label>
            <label>價格<input type="number" name="price" required min="0" step="any" placeholder="100" /></label>
            <label>手續費<input type="number" name="fee" min="0" step="any" /></label>
            <label>證交稅<input type="number" name="tax" min="0" step="any" /></label>
            <label>同日序<input type="number" name="seq" min="0" step="1" value="0" /></label>
          </div>
          <p class="tx-note">
            手續費與證交稅會依 <b>0.1425%</b> 與 <b>0.3%</b> 自動帶入(與回測引擎同口徑),
            <b>可自行修改</b> —— 券商折扣、當沖減半都會讓實際值不同。同日多筆請用「同日序」決定先後,
            那是 FIFO 的排序依據。
          </p>
          <div class="tx-form-actions">
            <button class="tr-btn tr-btn--primary" type="submit" id="tx-save">儲存</button>
            <button class="tr-btn" type="button" id="tx-cancel">取消</button>
            <span class="tx-err" id="tx-err" role="alert"></span>
          </div>
        </form>

        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>
                {TX_COLS.map((c, i) => <th scope="col" class:list={[{ l: i < 3 }]}>{c}</th>)}
                <th scope="col">操作</th>
              </tr>
            </thead>
            <tbody id="tx-body">
              <tr class="tr-empty">
                <td colspan={TX_COLS.length + 1}>{TRADES_PAGE.emptyCta}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="tr-block" id="sec-monthly">
      <div class="panel">
        <div class="p-head">
          <span class="idx">06</span>
          <h2>月報</h2>
          <span class="sub">逐月報酬與現金流</span>
        </div>
        <div class="rz-stats">
          {
            MONTHLY_STATS.map((s) => (
              <div class:list={["rstat", { wide: s.wide }]}>
                <div class="micro">{s.label}</div>
                <div class:list={["value", "tr-na", { big: s.wide }]}>—</div>
              </div>
            ))
          }
        </div>
        <p class="note">輸入交易後,系統會自動產生逐月績效與現金流。</p>
      </div>
    </section>

    <section class="tr-block" id="sec-watch">
      <div class="panel">
        <div class="p-head">
          <span class="idx">07</span>
          <h2>觀察清單</h2>
          <span class="sub">尚未進場的追蹤標的</span>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>{WATCH_COLS.map((c, i) => <th scope="col" class:list={[{ l: i < 2 || i === 5 }]}>{c}</th>)}</tr>
            </thead>
            <tbody>
              <tr class="tr-empty">
                <td colspan={WATCH_COLS.length}>
                  Phase 2 會與<a href="/watchlist">自選股</a>整合:自選中的標的可直接加入並記錄想法。
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <p class="tr-foot" role="note">
      本頁為 Phase 2 介面預覽,尚未開放輸入,頁面上所有數值皆為空值示意。
      {TRADES_PAGE.privacy}
      本平台僅提供資訊與計算工具,不構成投資建議,亦不代為執行任何交易。
      紅=獲利、綠=虧損(台股慣例)。
    </p>
  </div>

  <script>
    /* 只填今天的日期;本頁不載入任何資料 */
    const el = document.getElementById("tr-date");
    if (el) {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, "0");
      el.textContent = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
    }
  </script>

  <script>
    /**
     * 登入狀態切換。輪 1 只做 auth —— 資料讀寫在輪 2。
     *
     * 🔴 這裡沒有任何「權限判斷」:能不能讀資料由資料庫的 RLS 決定,不由這段程式決定。
     *    這段只決定【畫面顯示哪一塊】。前端若寫錯,最壞是使用者看到錯的提示,
     *    不可能讓任何人讀到別人的資料。
     */
    import { getSupabase, supabaseConfigured, supabaseConfigError } from "../lib/supabaseClient";

    const box = document.querySelector<HTMLElement>("#tr-auth .tr-auth__box");
    const loading = document.getElementById("tr-auth-loading");
    const outEl = document.querySelector<HTMLElement>("#tr-auth .tr-auth__signedout");
    const inEl = document.querySelector<HTMLElement>("#tr-auth .tr-auth__signedin");
    const cfgEl = document.querySelector<HTMLElement>("#tr-auth .tr-auth__unconfigured");
    const msg = document.getElementById("tr-auth-msg");
    const who = document.getElementById("tr-who");

    /** 交易/觀察區塊的提示文字:登入前後說法不同,但兩者都不假裝功能已開放 */
    function setHints(signedIn: boolean) {
      document.querySelectorAll<HTMLElement>(".tr-hint").forEach((h) => {
        h.textContent = signedIn ? "輸入功能開發中" : "Phase 2 · 登入後開放";
      });
    }

    function show(which: "signedout" | "signedin" | "unconfigured") {
      if (loading) loading.hidden = true;
      if (box) box.dataset.state = which;
      if (outEl) outEl.hidden = which !== "signedout";
      if (inEl) inEl.hidden = which !== "signedin";
      if (cfgEl) cfgEl.hidden = which !== "unconfigured";
      setHints(which === "signedin");
    }

    if (!supabaseConfigured) {
      // fail closed:設定缺失就明說,不要退化成「看起來像未登入」
      const c = document.getElementById("tr-auth-cfg");
      if (c) c.textContent = supabaseConfigError ?? "設定缺失";
      show("unconfigured");
    } else {
      const sb = getSupabase()!;

      const render = (email: string | null | undefined) => {
        if (email) {
          if (who) who.textContent = email;
          show("signedin");
        } else {
          show("signedout");
        }
      };

      sb.auth.getSession().then(({ data }) => render(data.session?.user?.email));
      sb.auth.onAuthStateChange((_e, session) => render(session?.user?.email));

      const redirectTo = `${location.origin}/auth/callback`;

      document.getElementById("tr-google")?.addEventListener("click", async () => {
        const { error } = await sb.auth.signInWithOAuth({ provider: "google", options: { redirectTo } });
        if (error && msg) msg.textContent = `無法開始 Google 登入:${error.message}`;
      });

      document.getElementById("tr-magic")?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const input = document.getElementById("tr-email") as HTMLInputElement | null;
        const email = input?.value.trim();
        if (!email) return;
        if (msg) msg.textContent = "寄送中…";
        const { error } = await sb.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectTo } });
        if (msg) {
          msg.textContent = error
            ? `寄送失敗:${error.message}`
            : `已寄出登入連結到 ${email}。點擊信中的連結即可登入(連結有時效)。`;
        }
      });

      document.getElementById("tr-signout")?.addEventListener("click", async () => {
        await sb.auth.signOut();
      });

      /* ══ 輪 2:交易 CRUD + 雙實作比對 ══════════════════════════════════ */
      const {
        fetchTrades, insertTrade, updateTrade, deleteTrade,
        crossCheck, newCompareState, defaultFee, defaultTax,
        fetchHoldings, fetchAnomalies, fetchQuotes, buildHoldingRows, portfolioTotals,
        fetchRealizedByTicker,
      } = await import("../lib/tradesApp");

      const form = document.getElementById("tx-form") as HTMLFormElement | null;
      const body = document.getElementById("tx-body");
      const status = document.getElementById("tx-status");
      const errEl = document.getElementById("tx-err");
      const newBtn = document.getElementById("tx-new") as HTMLButtonElement | null;
      const cmp = newCompareState();
      let editingId: number | string | null = null;
      let uid: string | null = null;

      const fmt = (n: number, d = 2) =>
        n.toLocaleString("zh-TW", { minimumFractionDigits: d, maximumFractionDigits: d });

      function renderStatus() {
        if (!status) return;
        if (cmp.status === "diff") {
          // 平白說法:使用者不需要知道「FIFO 雙實作」是什麼
          status.textContent = `部分代號的數值待核(${[...cmp.pending].join("、")})`;
          status.dataset.tone = "warn";
        } else if (cmp.status === "error") {
          status.textContent = "數值核對未完成";
          status.dataset.tone = "warn";
        } else {
          status.textContent = "";
          status.dataset.tone = "";
        }
      }

      function renderTrades(rows: any[]) {
        if (!body) return;
        if (!rows.length) {
          body.innerHTML = `<tr class="tr-empty"><td colspan="9">還沒有交易紀錄。按「＋ 新增交易」開始記錄。</td></tr>`;
          return;
        }
        body.textContent = "";
        for (const r of rows) {
          const net = r.side === "buy"
            ? -(r.shares * r.price + r.fee)
            : r.shares * r.price - r.fee - r.tax;
          const tr = document.createElement("tr");
          const cells = [
            r.trade_date, r.ticker, r.side === "buy" ? "買進" : "賣出",
            fmt(r.shares, 0), fmt(r.price), fmt(r.fee), fmt(r.tax), fmt(net),
          ];
          for (const c of cells) {
            const td = document.createElement("td");
            td.textContent = c; // 🔴 textContent 不是 innerHTML:note/ticker 都是使用者輸入
            tr.appendChild(td);
          }
          const ops = document.createElement("td");
          const mk = (label: string, act: string) => {
            const b = document.createElement("button");
            b.type = "button"; b.className = "tx-op"; b.textContent = label;
            b.dataset.act = act; b.dataset.id = String(r.id);
            return b;
          };
          ops.append(mk("編輯", "edit"), mk("刪除", "del"));
          tr.appendChild(ops);
          body.appendChild(tr);
        }
      }

      /* ══ 輪 3:持倉 / 未實現 / 賣超 ══════════════════════════════════ */
      const hdBody = document.getElementById("hd-body");
      const hdFoot = document.getElementById("hd-foot");
      const hdAnom = document.getElementById("hd-anomaly");
      /** 紅漲綠跌(台股慣例):正 = 紅、負 = 綠 */
      const toneOf = (n: number | null) => (n == null ? "" : n > 0 ? "up" : n < 0 ? "down" : "");

      function renderAnomalies(list: any[]) {
        if (!hdAnom) return;
        if (!list.length) { hdAnom.hidden = true; hdAnom.textContent = ""; return; }
        hdAnom.hidden = false;
        hdAnom.textContent = "";
        const h = document.createElement("b");
        h.textContent = "賣出股數超過買入股數,請檢查是否漏登買入或代號打錯:";
        hdAnom.appendChild(h);
        const ul = document.createElement("ul");
        for (const a of list) {
          const li = document.createElement("li");
          li.textContent = `${a.ticker}:買入 ${a.boughtShares}、賣出 ${a.soldShares}(多賣 ${a.oversoldShares} 股)`;
          ul.appendChild(li);
        }
        hdAnom.appendChild(ul);
      }

      let cache: any[] = [];
      let hdRows: any[] = [];
      let hdTotals: any = { marketValue: null, unrealized: null, pricedCount: 0, missingCount: 0 };

      /* ══ 輪 6:現值類卡片(淨值 / 合計損益 / 現金水位 / 資產配置 / 個股清單)══
         🔴 時間序列類(淨值曲線、回撤、TWR、VS 0050)不在本輪 ——
            那需要逐日重建部位 × 逐日股價,是另一個量級的問題。
            但那四格【不可以只留白】:留白看起來像「算出來是沒有」。 */
      const { summarizeEquity } = await import("../lib/equity");
      const { fetchCashFlows, fetchCashFlowSumView } = await import("../lib/tradesApp");

      let cashFlows: any[] = [];
      let realizedTotal = 0;
      let anomalyList: any[] = [];

      const $$ = (id: string) => document.getElementById(id);
      /** 金額:整數位到元,小數兩位。null → 留白(「—」),不以 0 代替 */
      const money = (v: number | null) =>
        v == null ? "—" : v.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const signed = (v: number | null) => (v == null ? "—" : (v > 0 ? "+" : "") + money(v));
      const pct1 = (v: number | null) => (v == null ? "—" : `${v.toFixed(2)}%`);

      /** 套上「留白 vs 有值」的樣式,並回傳該元素 */
      function put(id: string, text: string, tone: "" | "up" | "down" = "") {
        const el = $$(id);
        if (!el) return null;
        el.textContent = text;
        el.classList.toggle("tr-na", text === "—");
        el.classList.remove("up", "down");
        if (tone) el.classList.add(tone);
        return el;
      }

      function renderSummary() {
        const s = summarizeEquity({
          rows: hdRows,
          realizedTotal,
          cashFlows,
          trades: cache,
          oversoldTickers: anomalyList.map((a: any) => a.ticker),
        });

        /* ── 頭條 ── */
        put("tr-equity", money(s.equity));
        put("tr-vsdep", signed(s.vsDeposits), toneOf(s.vsDeposits));
        put("tr-sec", money(s.securities));
        put("tr-cash", money(s.cash));

        /* ── KPI:合計損益 ── */
        put("kpi-pnl", signed(s.totalPnl), toneOf(s.totalPnl));
        const pnlFoot = $$("kpi-pnl-foot");
        if (pnlFoot) {
          pnlFoot.textContent =
            s.unrealized == null
              ? `已實現 ${money(s.realized)} + 未實現(缺 ${s.missingPriceCount} 檔現價)`
              : `已實現 ${money(s.realized)} + 未實現 ${signed(s.unrealized)}` +
                (s.internalFlows !== 0 ? ` + 股息等 ${signed(s.internalFlows)}` : "");
        }

        /* ── KPI:現金水位 ── */
        put("kpi-cash", pct1(s.cashPct));
        const meter = $$("kpi-cash-meter");
        if (meter) meter.style.width = s.cashPct == null ? "0" : `${Math.max(0, Math.min(100, s.cashPct))}%`;
        const cashFoot = $$("kpi-cash-foot");
        if (cashFoot) {
          cashFoot.textContent =
            s.cashPct == null
              ? `現金 ${money(s.cash)} · 占比需要淨值才算得出來`
              : `現金 ${money(s.cash)} · 總存入 ${money(s.totalDeposits)}`;
        }

        /* ── KPI:TWR / VS 0050 ──
           🔴 留白 + 明說排在哪一輪。留白而不說明,讀起來像「算出來是沒有」。 */
        for (const [id, why] of [
          ["kpi-twr-foot", "時間加權,排除現金流影響 · 需逐日重建部位,排時間序列輪"],
          ["kpi-vs0050-foot", "同期對照 元大台灣50 · 需逐日 0050 序列,排時間序列輪"],
        ] as const) {
          const el = $$(id);
          if (el) el.textContent = why;
        }

        /* ── 🔴 恆等式:兩條不同的路必須等值 ── */
        const idc = $$("tr-idcheck");
        if (idc) {
          const i = s.identity;
          idc.classList.remove("bad", "warn");
          if (i.status === "ok") {
            idc.hidden = false;
            idc.textContent =
              `✓ 兩條路一致:已實現 + 未實現${s.internalFlows !== 0 ? " + 股息等" : ""} ` +
              `= 淨值 − 總存入 = ${signed(i.totalPnl)}(差額 ${i.diff})`;
          } else if (i.status === "diff") {
            idc.hidden = false;
            idc.classList.add("bad");
            idc.textContent =
              `🔴 兩條路不一致:合計損益 ${money(i.totalPnl)} vs 淨值 − 總存入 ${money(i.vsDeposits)}` +
              `,差額 ${i.diff} —— 這兩個數字相等是定義逼出來的,不一致代表某一邊算錯了。`;
          } else {
            idc.hidden = false;
            idc.classList.add("warn");
            idc.textContent = `⚠️ 無法核對兩條路:${i.reason ?? ""}`;
          }
        }

        /* ── 資產配置 ── */
        const list = $$("alloc-list");
        const note = $$("alloc-note");
        const donut = $$("alloc-donut");
        if (list) {
          list.textContent = "";
          if (!s.allocation.length) {
            if (note) {
              note.textContent =
                s.missingPriceCount > 0
                  ? `有 ${s.missingPriceCount} 檔取不到現價 —— 配置的分母(淨值)不可信,所以整塊不顯示。🔴 不會塞一個「其他」把缺口蓋掉。`
                  : "輸入交易後,這裡會依你的持倉自動分群。";
            }
          } else {
            for (const a of s.allocation) {
              const li = document.createElement("li");
              li.className = "a-row";
              const l = document.createElement("span");
              l.className = "a-l";
              l.textContent = a.label;
              const track = document.createElement("span");
              track.className = "a-track";
              const i = document.createElement("i");
              i.style.width = `${Math.max(0, Math.min(100, a.pct))}%`;
              track.appendChild(i);
              const v = document.createElement("span");
              v.className = "a-v";
              v.textContent = pct1(a.pct);
              li.append(l, track, v);
              list.appendChild(li);
            }
            if (note) note.textContent = `占淨值 ${money(s.equity)};各片加總 100%(含現金)。`;
          }
        }
        /* donut:用 conic-gradient 疊出比例(不畫 SVG 弧,省一層幾何) */
        if (donut) {
          const inner = donut.querySelector("svg");
          if (s.allocation.length) {
            if (inner) (inner as SVGElement).style.display = "none";
            let acc = 0;
            const stops = s.allocation.map((a, idx) => {
              const from = acc;
              acc += a.pct;
              const c = a.key === "__cash__" ? "var(--border-strong)" : `var(--accent)`;
              const op = a.key === "__cash__" ? 1 : 1 - (idx / Math.max(1, s.allocation.length)) * 0.65;
              return `color-mix(in srgb, ${c} ${(op * 100).toFixed(0)}%, transparent) ${from}% ${acc}%`;
            });
            donut.style.background = `conic-gradient(${stops.join(",")})`;
            donut.style.borderRadius = "50%";
            donut.setAttribute("aria-label", `配置比重圖:${s.allocation.map((a) => `${a.label} ${pct1(a.pct)}`).join("、")}`);
          } else {
            donut.style.background = "";
            if (inner) (inner as SVGElement).style.display = "";
          }
        }

        /* ── 個股清單(項目 ⑤ 的實際修法:接上真資料)── */
        const stk = $$("stk-list");
        if (stk) {
          stk.textContent = "";
          if (!hdRows.length) {
            const p = document.createElement("p");
            p.className = "s-empty";
            p.textContent = "尚無持股 —— 新增買進紀錄後會出現在這裡";
            stk.appendChild(p);
          } else {
            const max = Math.max(...hdRows.map((r: any) => r.marketValue ?? 0), 1);
            for (const r of hdRows) {
              const row = document.createElement("div");
              row.className = "s-row";
              const tk = document.createElement("span");
              tk.className = "s-tk";
              tk.textContent = r.name ? `${r.ticker} ${r.name}` : r.ticker;
              const bar = document.createElement("span");
              bar.className = "s-bar";
              const i = document.createElement("i");
              /* 🔴 缺價的那一檔畫 0 寬並標注 —— 不可畫成「最小的一檔」 */
              i.style.width = r.marketValue == null ? "0" : `${(r.marketValue / max) * 100}%`;
              bar.appendChild(i);
              row.append(tk, bar);
              if (r.marketValue == null) {
                const na = document.createElement("span");
                na.className = "s-na";
                na.textContent = "現價未取得";
                row.appendChild(na);
              }
              stk.appendChild(row);
            }
          }
        }
      }

      function renderHoldings() {
        if (!hdBody) return;
        if (!hdRows.length) {
          hdBody.innerHTML = `<tr class="tr-empty"><td colspan="8">目前沒有持倉。新增買進紀錄後,這裡會自動計算。</td></tr>`;
          if (hdFoot) hdFoot.textContent = "";
          return;
        }
        hdBody.textContent = "";
        for (const r of hdRows) {
          const tr = document.createElement("tr");
          const cell = (text: string, cls = "") => {
            const td = document.createElement("td");
            td.textContent = text;
            if (cls) td.className = cls;
            return td;
          };
          // 代號欄:待核標記【下沉到逐檔】,附在該列的代號旁
          const tkTd = document.createElement("td");
          tkTd.textContent = r.ticker;
          if (cmp.pending.has(r.ticker)) {
            tr.classList.add("hd-pending");
            const badge = document.createElement("span");
            badge.className = "hd-badge";
            badge.textContent = "數值待核";
            tkTd.appendChild(badge);
          }
          // 🔴 現價缺失 → 留白 + 平白說明,不以 0 代替(null ≠ 0)
          const na = (v: number | null, d = 2) => (v == null ? "—" : fmt(v, d));
          tr.append(
            tkTd,
            cell(r.name ?? "—"),
            cell(fmt(r.shares, 0)),
            cell(fmt(r.avgCost)),
            cell(r.price == null ? "現價未取得" : fmt(r.price), r.price == null ? "hd-na" : ""),
            cell(na(r.marketValue)),
            cell(na(r.unrealized), toneOf(r.unrealized)),
            cell(r.returnPct == null ? "—" : `${fmt(r.returnPct)}%`, toneOf(r.returnPct)),
          );
          hdBody.appendChild(tr);
        }
        if (hdFoot) {
          const parts: string[] = [];
          if (hdTotals.marketValue != null) {
            parts.push(`已取價 ${hdTotals.pricedCount} 檔合計市值 ${fmt(hdTotals.marketValue)} 元`);
            parts.push(`未實現 ${fmt(hdTotals.unrealized ?? 0)} 元`);
          }
          // 🔴 缺價個股不併入分母,而且要說出來
          if (hdTotals.missingCount > 0) parts.push(`不含 ${hdTotals.missingCount} 檔未取價個股`);
          hdFoot.textContent = parts.join(" · ");
        }
      }


      /* ══ 輪 7:時間序列(淨值曲線 / 回撤 / TWR / VS 0050)════════════════
         🔴 全部排在【首次繪製之後】,而且不 await —— 它要抓 10 檔的兩年日線,
            那不可以是白畫面的原因。同輪 2 的雙實作比對。

         🔴 日線快取只在伺服器記憶體(priceCache 的 5 分鐘),**不落地** ——
            持久化就從「代理」跨進「重散布」。見 docs/portfolio-series-design.md §0。 */
      const PS = await import("../lib/portfolioSeries");
      const CH = await import("../lib/seriesChartSvg");

      /** 對標:元大台灣50 */
      const BENCH = "0050";

      let seriesDays: any[] = [];

      const svgNS = "http://www.w3.org/2000/svg";
      const mkSvg = (c: any, cls: string, areas?: string[]) => {
        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("viewBox", `0 0 ${c.w} ${c.h}`);
        svg.setAttribute("preserveAspectRatio", "none");
        for (const t of c.ticks) {
          const l = document.createElementNS(svgNS, "line");
          l.setAttribute("x1", "0");
          l.setAttribute("x2", String(c.w));
          l.setAttribute("y1", String(t.y));
          l.setAttribute("y2", String(t.y));
          l.setAttribute("class", "nv-grid");
          svg.appendChild(l);
        }
        for (const d of areas ?? []) {
          if (!d) continue;
          const p = document.createElementNS(svgNS, "path");
          p.setAttribute("d", d);
          p.setAttribute("class", cls);
          svg.appendChild(p);
        }
        if (!areas) {
          for (const d of c.paths) {
            const p = document.createElementNS(svgNS, "path");
            p.setAttribute("d", d);
            p.setAttribute("class", cls);
            svg.appendChild(p);
          }
        }
        return svg;
      };

      /** 取一檔的日線。🔴 失敗回 null,不回空陣列 —— 「沒有資料」與「取不到」是兩件事 */
      async function fetchBars(tk: string): Promise<any[] | null> {
        try {
          const r = await fetch(`/api/bars/${encodeURIComponent(tk)}`);
          if (!r.ok) return null;
          const j = await r.json();
          return Array.isArray(j?.bars) ? j.bars.map((b: any) => ({ time: b.time, close: b.close })) : null;
        } catch {
          return null;
        }
      }
      async function fetchEvents(tk: string): Promise<any[]> {
        try {
          const r = await fetch(`/api/corp-events/${encodeURIComponent(tk)}`);
          if (!r.ok) return [];
          const j = await r.json();
          return Array.isArray(j?.events) ? j.events.map((e: any) => ({ ...e, ticker: tk })) : [];
        } catch {
          return [];
        }
      }

      async function renderSeries() {
        if (!cache.length) return;

        /* 🔴 需要【曾持有過】的全部代號,不只現在持有的 ——
           已出清的標的也在曲線期間內。隱私聲明已照這件事改過措辭。 */
        const everHeld = [...new Set(cache.map((t: any) => t.ticker))].sort();
        const first = cache.reduce((m: string, t: any) => (t.trade_date < m ? t.trade_date : m), cache[0].trade_date);
        const today = new Date().toISOString().split("T")[0]!;

        const fetched = await Promise.all(everHeld.map(async (tk) => [tk, await fetchBars(tk)] as const));
        const series = new Map<string, any[]>();
        const noBars: string[] = [];
        for (const [tk, bars] of fetched) {
          if (bars && bars.length) series.set(tk, bars);
          else noBars.push(tk);
        }
        if (!series.size) {
          const e = $$("nv-empty");
          if (e) e.textContent = "取不到任何日線 —— 曲線無法計算(不是「你沒有資料」)";
          return;
        }

        const axis = PS.buildAxis(series, first, today);
        seriesDays = PS.rebuildDaily(axis, cache, cashFlows);
        const nav = PS.buildNav(seriesDays, series);
        const dd = PS.drawdownSeries(nav.points);
        const t = PS.twr(nav.points, PS.externalFlowByDate(cashFlows));

        /* ── 繪圖 ── */
        const plot = $$("nv-plot");
        if (plot) {
          const c = CH.buildLineChart(nav.points.map((p: any) => ({ date: p.date, v: p.nav })), { w: 640, h: 168 });
          plot.querySelectorAll("svg").forEach((n) => n.remove());
          if (c.paths.length) {
            $$("nv-empty")!.hidden = true;
            plot.appendChild(mkSvg(c, "nv-line"));
            plot.setAttribute(
              "aria-label",
              `淨值走勢:${axis[0]} 至 ${axis[axis.length - 1]},共 ${axis.length} 個交易日` +
                (c.gaps ? `,其中 ${c.gaps} 天無法定價(曲線斷開)` : "")
            );
          } else {
            $$("nv-empty")!.hidden = false;
            $$("nv-empty")!.textContent = "沒有任何一天算得出淨值 —— 見下方品質註記";
          }
        }
        const ddEl = $$("dd-plot");
        if (ddEl) {
          const c = CH.buildDrawdownArea(dd.series.map((p: any) => ({ date: p.date, v: p.dd })), { w: 640, h: 64 });
          ddEl.querySelectorAll("svg").forEach((n) => n.remove());
          if (c.areas.length) {
            $$("dd-empty")!.hidden = true;
            ddEl.appendChild(mkSvg(c, "nv-dd", c.areas));
            ddEl.setAttribute("aria-label", `回撤圖:最大回撤 ${dd.maxDrawdown?.toFixed(2)}%`);
          } else {
            $$("dd-empty")!.hidden = false;
          }
        }

        /* ── KPI:TWR / VS 0050 ── */
        put("kpi-twr", t.pct == null ? "—" : `${t.pct >= 0 ? "+" : ""}${t.pct.toFixed(2)}%`, toneOf(t.pct));
        const twrFoot = $$("kpi-twr-foot");
        if (twrFoot) {
          twrFoot.textContent =
            t.pct == null
              ? "時間加權 · 沒有可連乘的日子"
              : `時間加權,排除現金流影響 · 連乘 ${t.linkedDays} 天` +
                (t.skippedDays ? ` · 跳過 ${t.skippedDays} 天(無法定價)` : "") +
                (t.degenerateDays ? ` · ${t.degenerateDays} 天分母 ≤ 0` : "");
        }

        const benchBars = await fetchBars(BENCH);
        const bench = benchBars ? PS.benchmarkReturn(benchBars, axis) : null;
        const excess = t.pct == null || bench == null ? null : t.pct - bench;
        put("kpi-vs0050", excess == null ? "—" : `${excess >= 0 ? "+" : ""}${excess.toFixed(2)}%`, toneOf(excess));
        const vsFoot = $$("kpi-vs0050-foot");
        if (vsFoot) {
          vsFoot.textContent =
            excess == null
              ? bench == null
                ? "同期對照 元大台灣50 · 取不到 0050 日線"
                : "同期對照 元大台灣50 · 需要投組 TWR"
              : `同期對照 元大台灣50(買進持有 ${bench.toFixed(2)}%),同一條軸`;
        }

        /* ── 🔴 品質註記:填補 / 缺價 / 末點 / 取不到日線的檔 ── */
        const q = $$("nv-quality");
        if (q) {
          const bits: string[] = [`軸 ${axis.length} 個交易日(${axis[0]} → ${axis[axis.length - 1]})`];
          if (nav.carriedTotal) bits.push(`向前填補 ${nav.carriedTotal} 格(上限 ${PS.CARRY_MAX_DAYS} 個交易日)`);
          if (nav.unknownDays) bits.push(`${nav.unknownDays} 天無法定價 → 曲線斷開`);
          if (nav.lastPointUnpriced) bits.push("🔴 末點未取價 —— 末點刻意不使用填補值");
          if (noBars.length) bits.push(`取不到日線:${noBars.join("、")}`);
          q.textContent = bits.join(" · ");
          q.classList.toggle("warn", nav.unknownDays > 0 || nav.lastPointUnpriced || noBars.length > 0);
        }

        /* ── 除權息:偵測並具名,不修正 ── */
        const evAll = (await Promise.all([...series.keys()].map(fetchEvents))).flat();
        const inHold = PS.eventsInHolding(evAll, seriesDays);
        const ul = $$("nv-events");
        if (ul) {
          ul.textContent = "";
          ul.hidden = inHold.length === 0;
          if (inHold.length) {
            const head = document.createElement("li");
            head.textContent =
              "🔴 持有期間內有除權息/配股事件 —— 曲線在這些日子前後【不可比】" +
              "(配股的股數變動沒有紀錄,現金股息需要你自己登記):";
            ul.appendChild(head);
            for (const e of inHold.slice(0, 12)) {
              const li = document.createElement("li");
              li.textContent = `${e.date} · ${e.ticker} · ${e.detail}`;
              ul.appendChild(li);
            }
          }
        }
      }

      /* ── D:逐日抽點 ── */
      $("nv-probe-go")?.addEventListener("click", () => {
        const out = $$("nv-probe-out");
        const dateEl = $$("nv-date") as HTMLInputElement | null;
        if (!out || !dateEl) return;
        if (!seriesDays.length) {
          out.textContent = "曲線還沒算好(或算不出來)—— 沒有可抽點的逐日部位";
          return;
        }
        const d = dateEl.value;
        if (!d) {
          out.textContent = "請先選一個日期";
          return;
        }
        const p = PS.positionAt(seriesDays, d);
        if (!p) {
          out.textContent = `${d} 早於全部軸日(第一個軸日是 ${seriesDays[0].date})—— 那一天還沒有任何部位`;
          return;
        }
        const sh = Object.entries(p.shares)
          .sort(([a], [b]) => (a < b ? -1 : 1))
          .map(([tk, n]) => `${tk}:${n}`)
          .join("  ");
        out.textContent =
          `${p.date}${p.date === d ? "" : `(${d} 不在軸上,取 ≤ 該日的最後一個軸日)`}` +
          `\n現金 ${money(p.cash)}\n${sh || "(當日無持股)"}`;
        out.style.whiteSpace = "pre-line";
      });

      async function reload() {
        cache = await fetchTrades(sb);
        renderTrades(cache);

        // 持倉先以「尚未取價」畫出來 —— 股數與成本是本地已知的事實,不必等網路
        let holds: any[] = [];
        try {
          /* 🔴 現金水位與已實現損益【與股價無關】—— 和持倉一起先取,
             不必等報價。它們是本地已知的事實,沒有理由留白等網路。

             ⚠️ 這裡【只放畫面必需的查詢】。交叉檢查移到下方單獨跑 ——
             理由見那一段:一個檢查不該有能力把頁面弄壞。 */
          const [h, anom, flows, realizedByTk] = await Promise.all([
            fetchHoldings(sb),
            fetchAnomalies(sb),
            fetchCashFlows(sb),
            fetchRealizedByTicker(sb),
          ]);
          holds = h;
          anomalyList = anom;
          cashFlows = flows;
          realizedTotal = [...realizedByTk.values()].reduce((n: number, v: number) => n + v, 0);

          renderAnomalies(anom);
          hdRows = buildHoldingRows(holds, new Map());
          hdTotals = portfolioTotals(hdRows);
          renderHoldings();
          renderSummary();

          /* ── 交叉檢查:本地加的 cash_flows 總和 vs SQL 檢視算的 ──
             🔴 **它不可以擋住渲染,也不可以靜默。** 兩者都錯:
                擋住渲染 → 一個檢查把主要內容弄掉了(而檢查本身不是資料);
                靜默跳過 → 現金水位錯了也沒人知道(「量不到」與「沒問題」不可混為一談)。
             所以:單獨跑、自己吞例外、結果一律出聲(含「跑不起來」也要出聲)。 */
          void (async () => {
            const mine = flows.reduce((n: number, r: any) => n + r.amount, 0);
            try {
              const flowSum = await fetchCashFlowSumView(sb);
              if (flowSum == null) {
                /* 一筆現金流都沒有時,檢視本來就沒有列 —— 那是【正常狀態】,不是異常。
                   🔴 對正常狀態發警告會訓練人忽略警告,而那比不發更糟:
                      真的出問題那天,這行字看起來和前一百次一模一樣。
                   只有「本地有列、檢視卻沒有」才是矛盾。 */
                if (flows.length > 0) {
                  console.error(`[trades] 🔴 本地有 ${flows.length} 筆現金流,檢視卻沒有回傳列 —— 兩邊不一致`);
                }
              } else if (Math.abs(mine - flowSum) > 0.005) {
                console.error(`[trades] 🔴 現金流合計不一致:本地 ${mine} vs v_cash_flow_total ${flowSum}`);
              }
            } catch (err) {
              console.warn(`[trades] 現金流合計交叉檢查【跑不起來】:${(err as Error).message} —— 這一格沒有被驗證`);
            }
          })();
        } catch (e) {
          console.warn(`[trades] 讀取持倉失敗:${(e as Error).message}`);
        }

        /**
         * 🔴 比對與現價都排在首次繪製【之後】,且不 await —— 資料先上畫面。
         *    幾千筆交易時,這兩件事不可以是白畫面的原因。
         */
        queueMicrotask(async () => {
          crossCheck(sb, cache, cmp).then(() => {
            renderStatus();
            renderHoldings(); // 待核標記下沉到逐檔
          });
          if (holds.length) {
            const quotes = await fetchQuotes(holds.map((h: any) => h.ticker));
            hdRows = buildHoldingRows(holds, quotes);
            hdTotals = portfolioTotals(hdRows);
            renderHoldings();
            renderSummary();
            /* 🔴 時間序列排最後,而且自己吞例外 ——
               它要抓 10 檔的兩年日線,不可以把已經畫好的現值卡片弄掉。 */
            renderSeries().catch((e) => {
              console.warn(`[trades] 時間序列算不出來:${(e as Error).message}`);
              const q = document.getElementById("nv-quality");
              if (q) {
                q.textContent = `時間序列計算失敗:${(e as Error).message} —— 這一區沒有被計算(不是「你沒有資料」)`;
                q.classList.add("warn");
              }
            });
          }
        });
      }

      function fillDefaults() {
        if (!form) return;
        const f = new FormData(form);
        const shares = Number(f.get("shares")) || 0;
        const price = Number(f.get("price")) || 0;
        const side = String(f.get("side") || "buy") as "buy" | "sell";
        const feeEl = form.elements.namedItem("fee") as HTMLInputElement;
        const taxEl = form.elements.namedItem("tax") as HTMLInputElement;
        if (!feeEl.dataset.touched) feeEl.value = shares && price ? String(defaultFee(shares, price)) : "";
        if (!taxEl.dataset.touched) taxEl.value = shares && price ? String(defaultTax(side, shares, price)) : "";
      }
      form?.addEventListener("input", (ev) => {
        const t = ev.target as HTMLInputElement;
        if (t.name === "fee" || t.name === "tax") t.dataset.touched = "1";
        if (["shares", "price", "side"].includes(t.name)) fillDefaults();
      });

      function openForm(row?: any) {
        if (!form) return;
        form.hidden = false;
        editingId = row?.id ?? null;
        const set = (n: string, v: any) => ((form.elements.namedItem(n) as HTMLInputElement).value = v ?? "");
        set("trade_date", row?.trade_date ?? new Date().toISOString().slice(0, 10));
        set("ticker", row?.ticker ?? "");
        (form.elements.namedItem("side") as HTMLSelectElement).value = row?.side ?? "buy";
        set("shares", row?.shares ?? "");
        set("price", row?.price ?? "");
        set("fee", row?.fee ?? "");
        set("tax", row?.tax ?? "");
        set("seq", row?.seq ?? 0);
        (form.elements.namedItem("fee") as HTMLInputElement).dataset.touched = row ? "1" : "";
        (form.elements.namedItem("tax") as HTMLInputElement).dataset.touched = row ? "1" : "";
        if (errEl) errEl.textContent = "";
        (form.elements.namedItem("ticker") as HTMLInputElement).focus();
      }

      newBtn?.addEventListener("click", () => openForm());
      document.getElementById("tx-cancel")?.addEventListener("click", () => {
        if (form) form.hidden = true;
        editingId = null;
      });

      body?.addEventListener("click", async (ev) => {
        const b = (ev.target as HTMLElement).closest("button.tx-op") as HTMLButtonElement | null;
        if (!b) return;
        const row = cache.find((r) => String(r.id) === b.dataset.id);
        if (!row) return;
        if (b.dataset.act === "edit") return openForm(row);
        if (b.dataset.act === "del") {
          if (!confirm(`刪除 ${row.trade_date} ${row.ticker} 這筆紀錄?此動作無法復原。`)) return;
          try { await deleteTrade(sb, row.id); await reload(); }
          catch (e) { if (errEl) errEl.textContent = `刪除失敗:${(e as Error).message}`; }
        }
      });

      form?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        if (!uid) return;
        const f = new FormData(form);
        const payload = {
          ticker: String(f.get("ticker") || "").trim().toUpperCase(),
          trade_date: String(f.get("trade_date")),
          seq: Number(f.get("seq")) || 0,
          side: String(f.get("side")) as "buy" | "sell",
          shares: Number(f.get("shares")),
          price: Number(f.get("price")),
          fee: Number(f.get("fee")) || 0,
          tax: Number(f.get("tax")) || 0,
        };
        try {
          if (editingId != null) await updateTrade(sb, editingId, payload);
          else await insertTrade(sb, uid, payload);
          form.hidden = true;
          editingId = null;
          await reload();
        } catch (e) {
          // 資料庫的 check 約束(代號格式、股數 > 0…)會走到這裡 —— 照實顯示,不吞
          if (errEl) errEl.textContent = `儲存失敗:${(e as Error).message}`;
        }
      });

      // 登入狀態決定要不要載入資料
      const wire = async (session: any) => {
        uid = session?.user?.id ?? null;
        if (newBtn) newBtn.disabled = !uid;
        if (!uid) {
          if (form) form.hidden = true;
          if (body) body.innerHTML = `<tr class="tr-empty"><td colspan="9">登入後即可開始記錄你自己的交易。</td></tr>`;
          // 登出時把持倉、賣超警告、待核標記一併清掉 —— 不可讓上一個帳號的內容殘留在畫面上
          if (hdBody) hdBody.innerHTML = `<tr class="tr-empty"><td colspan="8">登入後,這裡會依你的交易自動計算持倉。</td></tr>`;
          if (hdFoot) hdFoot.textContent = "";
          if (hdAnom) { hdAnom.hidden = true; hdAnom.textContent = ""; }
          hdRows = [];
          cmp.pending.clear();
          if (status) status.textContent = "";
          return;
        }
        await reload();
      };
      sb.auth.getSession().then(({ data }) => wire(data.session));
      sb.auth.onAuthStateChange((_e, session) => wire(session));
    }
  </script>
</Layout>

<style is:global>
  /* ══ /trades 終端佈局(版面對齊本地版「投資組合儀表板」) ══ */
  #tr-app { font-variant-numeric: tabular-nums; }
  #tr-app .tr-na { color: var(--muted); font-weight: 500; }

  .tr-privacy {
    margin: 0 0 0.9rem; padding: 0.55rem 0.85rem; font-size: 0.78rem; line-height: 1.6;
    color: var(--text-secondary); background: var(--surface); border: 1px solid var(--border);
    border-left: 3px solid var(--accent); border-radius: var(--radius-sm);
  }
  .tr-privacy b { color: var(--text); font-weight: 700; }

  /* ══ 登入區 ══ */
  /* 本站尚無 .sr-only 工具類,這裡自備(僅本頁作用域內的 global) */
  #tr-app .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .tr-auth { margin: 0 0 1rem; }
  .tr-auth__box {
    padding: 0.85rem 1rem; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .tr-auth__head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .tr-auth__head b { font-size: 0.92rem; color: var(--text); }
  .tr-auth__head span { font-size: 0.76rem; color: var(--text-secondary); }
  .tr-auth__who { font-family: var(--font-mono); }
  .tr-auth__actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .tr-auth__mail { display: flex; gap: 6px; flex-wrap: wrap; }
  .tr-auth__mail input {
    min-width: 220px; padding: 0.34rem 0.55rem; font: inherit; font-size: 0.82rem;
    color: var(--text); background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .tr-auth__mail input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .tr-auth__note { margin: 0.55rem 0 0; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.6; }

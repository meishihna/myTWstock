---
import Layout from "../../layouts/Layout.astro";
import Bi from "../../components/Bi.astro";
import fs from "node:fs";
import path from "node:path";
import { DISCOVER_PAGE, SITE, WIKI, WIKI_STUB } from "../../lib/ui";

const hubPath = path.join(process.cwd(), "public/data/wikilink-hub-top500.json");
const stubsPath = path.join(process.cwd(), "public/data/wikilink-stubs.json");

type HubEntry = {
  label: string;
  slug: string;
  count: number;
  related?: { label: string; slug: string; count: number }[];
  tickers: {
    ticker: string;
    name: string;
    sector: string;
    sectorSlug: string;
  }[];
};

type StubEntry = {
  slug: string;
  labels: string[];
  mentions: { ticker: string; name: string }[];
};

export function getStaticPaths() {
  // Paths must be inlined here: Astro bundles getStaticPaths separately and does
  // not include sibling module bindings (hubPath/stubsPath) in that chunk.
  const hubFile = path.join(process.cwd(), "public/data/wikilink-hub-top500.json");
  const stubsFile = path.join(process.cwd(), "public/data/wikilink-stubs.json");
  const slugs = new Set<string>();
  if (fs.existsSync(hubFile)) {
    const hub = JSON.parse(fs.readFileSync(hubFile, "utf8"));
    for (const e of (hub.entries || []) as HubEntry[]) slugs.add(e.slug);
  }
  if (fs.existsSync(stubsFile)) {
    const data = JSON.parse(fs.readFileSync(stubsFile, "utf8"));
    for (const s of (data.stubs || []) as StubEntry[]) slugs.add(s.slug);
  }
  return [...slugs].map((slug) => ({ params: { slug } }));
}

export const prerender = true;

const { slug } = Astro.params;

let hubEntries: HubEntry[] = [];
if (fs.existsSync(hubPath)) {
  const hub = JSON.parse(fs.readFileSync(hubPath, "utf8"));
  hubEntries = hub.entries || [];
}

let stubEntries: StubEntry[] = [];
if (fs.existsSync(stubsPath)) {
  const data = JSON.parse(fs.readFileSync(stubsPath, "utf8"));
  stubEntries = data.stubs || [];
}

const entry = hubEntries.find((e) => e.slug === slug);
const stub = stubEntries.find((s) => s.slug === slug);

if (!entry && !stub) {
  return Astro.redirect("/discover");
}

const isStubOnly = !entry && !!stub;
const pageTitle = entry
  ? `${entry.label} — ${WIKI.nav} — ${SITE.name}`
  : `${stub!.labels[0] ?? slug} — ${WIKI_STUB.nav} — ${SITE.name}`;
const pageDesc = entry ? `${entry.label} — ${WIKI.lead}` : WIKI_STUB.badge;
---
<Layout title={pageTitle} description={pageDesc}>
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="/"><Bi zh="首頁" en="Home" /></a>
    <span class="bc-sep"> / </span>
    <a href="/discover">{DISCOVER_PAGE.nav}</a>
    <span class="bc-sep"> / </span>
    <span>{entry?.label ?? stub?.labels[0] ?? slug}</span>
  </div>

  {
    entry && (
      <>
        <h1 class="page-h1">{entry.label}</h1>
        <p class="page-lead">
          {WIKI.count}：<strong>{entry.count}</strong> · {WIKI.companies}：{entry.tickers.length}
          {WIKI.lead}
        </p>

        <table class="company-table">
          <thead>
            <tr>
              <th>
                <Bi zh="代號" en="Ticker" />
              </th>
              <th>
                <Bi zh="公司" en="Company" />
              </th>
              <th>
                <Bi zh="產業" en="Sector" />
              </th>
            </tr>
          </thead>
          <tbody>
            {entry.tickers.map((c) => (
              <tr>
                <td>
                  <a href={`/report/${c.ticker}`}>{c.ticker}</a>
                </td>
                <td>
                  <a href={`/report/${c.ticker}`}>{c.name}</a>
                </td>
                <td>
                  <a href={`/sectors/${c.sectorSlug}`}>{c.sector}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {entry.related && entry.related.length > 0 && (
          <section class="wiki-related">
            <h2 class="wiki-related__h">常一起出現的實體（相關供應鏈／同業）</h2>
            <p class="wiki-related__sub muted">與本實體最常出現在同一篇報告的其他實體,可循此探索供應鏈關聯。</p>
            <ul class="wiki-related__list">
              {entry.related.map((r) => (
                <li>
                  <a href={`/wiki/${r.slug}`}>{r.label}</a>
                  <span class="wiki-related__n">{r.count}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }

  {
    isStubOnly && stub && (
      <>
        <p class="wiki-stub-badge">{WIKI_STUB.badge}</p>
        <h1 class="page-h1">{stub.labels.join(" · ")}</h1>
        <p class="page-lead muted">
          {WIKI_STUB.mentions}
        </p>
        {stub.labels.length > 1 && (
          <p class="wiki-stub-aliases">
            <strong>{WIKI_STUB.aliases}：</strong>
            {stub.labels.join("、")}
          </p>
        )}
        <table class="company-table">
          <thead>
            <tr>
              <th>
                <Bi zh="代號" en="Ticker" />
              </th>
              <th>
                <Bi zh="公司" en="Company" />
              </th>
            </tr>
          </thead>
          <tbody>
            {stub.mentions.map((c) => (
              <tr>
                <td>
                  <a href={`/report/${c.ticker}`}>{c.ticker}</a>
                </td>
                <td>
                  <a href={`/report/${c.ticker}`}>{c.name}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="wiki-stub-back">
          <a href="/discover">{WIKI_STUB.backToWiki}</a>
        </p>
      </>
    )
  }
</Layout>

<style>
  .wiki-related { margin-top: 2rem; }
  .wiki-related__h { font-size: 1.05rem; margin: 0 0 0.25rem; }
  .wiki-related__sub { font-size: 0.8rem; margin: 0 0 0.75rem; }
  .wiki-related__list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .wiki-related__list li { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid var(--border, rgba(255,255,255,0.14)); border-radius: 999px; background: var(--bg2, rgba(255,255,255,0.04)); }
  .wiki-related__list a { text-decoration: none; color: var(--link-report, #7dd3c0); }
  .wiki-related__list a:hover { text-decoration: underline; }
  .wiki-related__n { font-size: 0.72rem; color: var(--muted, #9aa0a6); font-variant-numeric: tabular-nums; }
</style>

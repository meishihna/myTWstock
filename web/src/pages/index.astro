---
import Layout from "../layouts/Layout.astro";
import { HOME, SITE } from "../lib/ui";
import TodayThemes from "../components/TodayThemes.astro";
import MarketFocus from "../components/MarketFocus.astro";
import TopMovers from "../components/TopMovers.astro";
import MarketRefresh from "../components/MarketRefresh.astro";
---
<Layout title={`${SITE.name} — ${HOME.title}`} description={HOME.subtitle}>
  <div class="hero">
    <h1 class="hero-title">{HOME.title}</h1>
    <p class="hero-sub">{HOME.subtitle}</p>
  </div>

  <div class="search-panel">
    <label for="q">{HOME.searchLabel}</label>
    <input
      type="search"
      id="q"
      placeholder={HOME.searchPlaceholder}
      autocomplete="off"
    />
    <div
      class="search-results"
      id="results"
      hidden
      data-empty-msg={HOME.noResults}
      data-index-loading={HOME.indexLoading}
      data-index-error={HOME.indexError}
    >
    </div>
  </div>

  <MarketRefresh />

  <MarketFocus />

  <TopMovers />

  <TodayThemes variant="home" limit={6} />

  <script>
    const input = document.getElementById("q");
    const box = document.getElementById("results");
    /** @type {{ ticker: string; name: string; sector: string }[]} */
    let rows = [];
    const emptyMsg = box?.dataset.emptyMsg || "";
    const indexLoading = box?.dataset.indexLoading || "";
    const indexError = box?.dataset.indexError || "";
    /** @type {"idle" | "loading" | "ready" | "error"} */
    let indexState = "idle";

    // 延遲載入:聚焦或開始輸入時才抓 reports-index.json(首頁不再無條件下載 ~319KB)
    function loadIndex() {
      if (indexState !== "idle") return;
      indexState = "loading";
      fetch("/data/reports-index.json")
        .then((r) => {
          if (!r.ok) throw new Error("bad");
          return r.json();
        })
        .then((idx) => {
          rows = Object.values(idx.byTicker ?? {}).map((m) => ({
            ticker: m.ticker,
            name: m.name,
            sector: m.sector,
          }));
          indexState = "ready";
        })
        .catch(() => {
          indexState = "error";
        });
    }
    input?.addEventListener("focus", loadIndex, { once: true });

    function norm(s) {
      return s.trim().toLowerCase();
    }

    input?.addEventListener("input", () => {
      loadIndex();
      const q = norm(/** @type {HTMLInputElement} */ (input).value);
      if (!box) return;
      if (!q) {
        box.hidden = true;
        box.innerHTML = "";
        return;
      }
      if (indexState === "loading") {
        box.hidden = false;
        box.innerHTML = `<span class="muted" role="status">${indexLoading}</span>`;
        return;
      }
      if (indexState === "error") {
        box.hidden = false;
        box.innerHTML = `<span class="muted" role="alert">${indexError}</span>`;
        return;
      }
      const hit = rows.filter(
        (r) =>
          r.ticker.includes(q) ||
          norm(r.name).includes(q) ||
          norm(r.sector).includes(q)
      );
      hit.sort((a, b) => a.ticker.localeCompare(b.ticker));
      const top = hit.slice(0, 40);
      if (top.length === 0) {
        box.hidden = false;
        box.innerHTML = `<span class="muted">${emptyMsg}</span>`;
        return;
      }
      box.hidden = false;
      box.innerHTML = top
        .map(
          (r) =>
            `<a href="/report/${r.ticker}"><strong>${r.ticker}</strong> ${r.name}<span class="muted"> — ${r.sector}</span></a>`
        )
        .join("");
    });
  </script>
</Layout>

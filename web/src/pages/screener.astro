---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="財務選股器 Screener — TWstock"
  description="以最新年度財務與估值指標篩選、排序全市場 1,700+ 檔台股。"
>
  <main class="screener">
    <header class="scr-head">
      <h1 class="scr-h1">財務選股器</h1>
      <p class="scr-intro">
        以最新年度損益與估值指標篩選、排序全市場上市櫃(來源 <code>financials_store</code>);部分小型股估值欄位可能從缺。點欄位標題可排序。
      </p>
    </header>

    <div class="scr-controls">
      <input id="scr-q" class="scr-input" type="search" placeholder="代號或名稱…" aria-label="代號或名稱搜尋" />
      <select id="scr-sector" class="scr-input scr-select" aria-label="產業篩選">
        <option value="">全部產業</option>
      </select>
      <label class="scr-flab">P/E ≤ <input id="scr-pe" class="scr-num" type="number" step="any" inputmode="decimal" /></label>
      <label class="scr-flab">ROE% ≥ <input id="scr-roe" class="scr-num" type="number" step="any" inputmode="decimal" /></label>
      <label class="scr-flab">毛利率% ≥ <input id="scr-gm" class="scr-num" type="number" step="any" inputmode="decimal" /></label>
      <label class="scr-flab">營收YoY% ≥ <input id="scr-yoy" class="scr-num" type="number" step="any" inputmode="decimal" /></label>
      <button id="scr-reset" class="scr-reset" type="button">重設</button>
      <span id="scr-count" class="scr-count" role="status"></span>
    </div>

    <div class="scr-card">
      <div class="scr-table-wrap">
        <table class="scr-table">
          <thead><tr id="scr-head"></tr></thead>
          <tbody id="scr-body"></tbody>
        </table>
      </div>
      <p id="scr-empty" class="scr-empty" hidden>無符合條件的標的。</p>
    </div>
  </main>

  <script>
    import { sectorZh } from "../lib/sector-i18n";
    type Row = Record<string, string | number | null>;
    const COLS: { k: string; label: string; num: boolean; fmt?: (v: number) => string }[] = [
      { k: "t", label: "代號", num: false },
      { k: "n", label: "名稱", num: false },
      { k: "s", label: "產業", num: false },
      { k: "mc", label: "市值(百萬)", num: true, fmt: (v) => Math.round(v).toLocaleString("zh-TW") },
      { k: "pe", label: "P/E", num: true, fmt: (v) => v.toFixed(1) },
      { k: "pb", label: "P/B", num: true, fmt: (v) => v.toFixed(2) },
      { k: "roe", label: "ROE%", num: true, fmt: (v) => v.toFixed(1) },
      { k: "gm", label: "毛利率%", num: true, fmt: (v) => v.toFixed(1) },
      { k: "nm", label: "淨利率%", num: true, fmt: (v) => v.toFixed(1) },
      { k: "eps", label: "EPS", num: true, fmt: (v) => v.toFixed(2) },
      { k: "revYoy", label: "營收YoY%", num: true, fmt: (v) => v.toFixed(1) },
    ];
    const MAX_SHOW = 500;

    let rows: Row[] = [];
    let sortKey = "mc";
    let sortDir = -1;

    const $ = (id: string) => document.getElementById(id);
    const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : null);

    function buildHead() {
      const tr = $("scr-head");
      if (!tr) return;
      tr.innerHTML = COLS.map(
        (c) =>
          `<th data-key="${c.k}" class="${c.num ? "scr-th--num" : ""}" role="button" tabindex="0">${c.label}<span class="scr-arrow" data-arrow="${c.k}"></span></th>`,
      ).join("");
      tr.querySelectorAll("th").forEach((th) => {
        const handler = () => {
          const k = th.getAttribute("data-key")!;
          if (sortKey === k) sortDir = -sortDir;
          else {
            sortKey = k;
            sortDir = COLS.find((c) => c.k === k)?.num ? -1 : 1;
          }
          render();
        };
        th.addEventListener("click", handler);
        th.addEventListener("keydown", (e) => {
          if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
            e.preventDefault();
            handler();
          }
        });
      });
    }

    function initSectors() {
      const sel = $("scr-sector") as HTMLSelectElement | null;
      if (!sel) return;
      const sectors = Array.from(new Set(rows.map((r) => String(r.s || "")).filter(Boolean))).sort((a, b) =>
        sectorZh(a).localeCompare(sectorZh(b), "zh-Hant"),
      );
      for (const s of sectors) {
        const o = document.createElement("option");
        o.value = s; // 值維持英文供篩選比對;顯示用繁中
        o.textContent = sectorZh(s);
        sel.appendChild(o);
      }
    }

    function getFilters() {
      const q = (($("scr-q") as HTMLInputElement)?.value || "").trim().toLowerCase();
      const sector = ($("scr-sector") as HTMLSelectElement)?.value || "";
      const peMax = parseFloat(($("scr-pe") as HTMLInputElement)?.value);
      const roeMin = parseFloat(($("scr-roe") as HTMLInputElement)?.value);
      const gmMin = parseFloat(($("scr-gm") as HTMLInputElement)?.value);
      const yoyMin = parseFloat(($("scr-yoy") as HTMLInputElement)?.value);
      return { q, sector, peMax, roeMin, gmMin, yoyMin };
    }

    function applyFilters(): Row[] {
      const f = getFilters();
      return rows.filter((r) => {
        if (f.q && !(String(r.t).toLowerCase().includes(f.q) || String(r.n).toLowerCase().includes(f.q)))
          return false;
        if (f.sector && r.s !== f.sector) return false;
        if (Number.isFinite(f.peMax)) {
          const v = num(r.pe);
          if (v == null || v > f.peMax) return false;
        }
        if (Number.isFinite(f.roeMin)) {
          const v = num(r.roe);
          if (v == null || v < f.roeMin) return false;
        }
        if (Number.isFinite(f.gmMin)) {
          const v = num(r.gm);
          if (v == null || v < f.gmMin) return false;
        }
        if (Number.isFinite(f.yoyMin)) {
          const v = num(r.revYoy);
          if (v == null || v < f.yoyMin) return false;
        }
        return true;
      });
    }

    function sortRows(list: Row[]) {
      const col = COLS.find((c) => c.k === sortKey);
      list.sort((a, b) => {
        const av = a[sortKey];
        const bv = b[sortKey];
        if (col?.num) {
          const an = num(av);
          const bn = num(bv);
          if (an == null && bn == null) return 0;
          if (an == null) return 1;
          if (bn == null) return -1;
          return (an - bn) * sortDir;
        }
        return String(av ?? "").localeCompare(String(bv ?? "")) * sortDir;
      });
    }

    function render() {
      const list = applyFilters();
      sortRows(list);
      const body = $("scr-body");
      const empty = $("scr-empty");
      const count = $("scr-count");
      if (count) count.textContent = `符合 ${list.length} 檔` + (list.length > MAX_SHOW ? `(顯示前 ${MAX_SHOW};可用搜尋或篩選查看其餘)` : "");
      if (empty) (empty as HTMLElement).hidden = list.length > 0;
      document.querySelectorAll(".scr-arrow").forEach((el) => (el.textContent = ""));
      const arrow = document.querySelector(`[data-arrow="${sortKey}"]`);
      if (arrow) arrow.textContent = sortDir === 1 ? " ▲" : " ▼";
      if (!body) return;
      const shown = list.slice(0, MAX_SHOW);
      body.innerHTML = shown
        .map((r) => {
          const cells = COLS.map((c) => {
            if (c.k === "t")
              return `<td class="scr-td--t"><a class="scr-chip" href="/report/${r.t}">${r.t}</a></td>`;
            if (c.k === "n")
              return `<td class="scr-td--n"><a href="/report/${r.t}">${r.n ?? ""}</a></td>`;
            if (c.k === "s") return `<td class="scr-td--s">${r.s ? sectorZh(String(r.s)) : "—"}</td>`;
            const v = num(r[c.k]);
            if (c.k === "revYoy") {
              if (v == null) return `<td class="scr-td--num">—</td>`;
              const cls = v > 0 ? "is-pos" : v < 0 ? "is-neg" : "";
              const arr = v > 0 ? "▲" : v < 0 ? "▼" : "";
              return `<td class="scr-td--num scr-chg ${cls}">${arr}${Math.abs(v).toFixed(1)}</td>`;
            }
            return `<td class="scr-td--num">${v == null ? "—" : c.fmt!(v)}</td>`;
          });
          return `<tr>${cells.join("")}</tr>`;
        })
        .join("");
    }

    function attachFilterEvents() {
      ["scr-q", "scr-pe", "scr-roe", "scr-gm", "scr-yoy"].forEach((id) =>
        $(id)?.addEventListener("input", render),
      );
      $("scr-sector")?.addEventListener("change", render);
      $("scr-reset")?.addEventListener("click", () => {
        ["scr-q", "scr-pe", "scr-roe", "scr-gm", "scr-yoy"].forEach((id) => {
          const el = $(id) as HTMLInputElement | null;
          if (el) el.value = "";
        });
        const sel = $("scr-sector") as HTMLSelectElement | null;
        if (sel) sel.value = "";
        sortKey = "mc";
        sortDir = -1;
        render();
      });
    }

    buildHead();
    attachFilterEvents();
    fetch("/data/screener-index.json")
      .then((r) => r.json())
      .then((j) => {
        rows = j.rows || [];
        initSectors();
        render();
      })
      .catch(() => {
        const count = $("scr-count");
        if (count) count.textContent = "載入失敗";
      });
  </script>

  <style is:global>
    .screener { max-width: 1200px; margin: 0 auto; padding: 1.75rem 1rem 3rem; }
    .scr-head { margin-bottom: 1.1rem; }
    .scr-h1 { font-family: var(--font-display); font-size: 1.6rem; margin: 0 0 0.2rem; letter-spacing: -0.01em; }
    .scr-h1-en { color: var(--muted); font-weight: 400; font-size: 1rem; }
    .scr-intro { color: var(--muted); font-size: 0.85rem; margin: 0; line-height: 1.6; }
    .scr-intro code { font-family: ui-monospace, monospace; font-size: 0.8rem; background: rgba(255,255,255,0.05); padding: 1px 6px; border-radius: 5px; }

    .scr-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 1.1rem; }
    .scr-input, .scr-num {
      height: 36px; padding: 0 12px; border-radius: var(--radius-sm, 8px);
      border: 1px solid var(--border); background: var(--surface-elevated); color: var(--text); font-size: 0.85rem;
    }
    .scr-input { min-width: 150px; }
    .scr-select { cursor: pointer; }
    .scr-input:focus, .scr-num:focus { outline: none; border-color: var(--accent); }
    .scr-flab { display: inline-flex; align-items: center; gap: 5px; font-size: 0.8rem; color: var(--muted); }
    .scr-num { width: 76px; padding: 0 9px; }
    .scr-reset {
      height: 36px; padding: 0 14px; border-radius: var(--radius-sm, 8px); cursor: pointer; font-size: 0.82rem; font-weight: 600;
      border: 1px solid var(--border); background: var(--surface-elevated); color: var(--text);
      transition: border-color var(--duration) var(--ease-out);
    }
    .scr-reset:hover { border-color: var(--accent); }
    .scr-count { color: var(--muted); font-size: 0.8rem; margin-left: auto; font-variant-numeric: tabular-nums; }

    .scr-card {
      border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden;
      background: var(--surface);
    }
    .scr-table-wrap { overflow-x: auto; }
    .scr-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }

    .scr-table thead th {
      position: sticky; top: 0; z-index: 1; background: var(--surface-elevated);
      padding: 11px 14px; text-align: left; white-space: nowrap; cursor: pointer; user-select: none;
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-secondary);
      border-bottom: 1px solid var(--border);
    }
    .scr-table thead th:hover { color: var(--text); }
    .scr-th--num { text-align: right; }
    .scr-arrow { color: var(--accent); }

    .scr-table tbody td {
      padding: 10px 14px; white-space: nowrap; border-bottom: 1px solid rgba(255,255,255,0.045);
    }
    .scr-table tbody tr:hover td { background: rgba(255,255,255,0.03); }
    .scr-td--num {
      text-align: right; font-variant-numeric: tabular-nums; font-family: ui-monospace, monospace; color: var(--text);
    }
    .scr-td--s { color: var(--muted); font-size: 0.8rem; }
    .scr-td--n a { color: var(--text); text-decoration: none; font-weight: 500; }
    .scr-td--n a:hover { color: var(--link-report); }
    .scr-chip {
      font-family: ui-monospace, monospace; font-size: 0.78rem; font-weight: 700; text-decoration: none;
      color: var(--link-report); background: color-mix(in srgb, var(--link-report) 14%, transparent);
      padding: 2px 8px; border-radius: 6px;
    }
    .scr-chg.is-pos { color: var(--up); }
    .scr-chg.is-neg { color: var(--down); }

    .scr-empty { padding: 2.5rem 1.5rem; text-align: center; color: var(--muted); }
  </style>
</Layout>

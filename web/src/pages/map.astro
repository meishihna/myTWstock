---
import Layout from "../layouts/Layout.astro";
import TodayThemes from "../components/TodayThemes.astro";
import { MAP_PAGE } from "../lib/ui";

export const prerender = true;
---

<Layout
  title="投資題材 — TWstock"
  description="台股投資題材熱力圖:依題材瀏覽上中下游與成分股,當日漲跌一眼掌握。官方產業分類另見「產業」。"
>
  <main class="map-page">
    <header class="map-head">
      <h1 class="map-h1">{MAP_PAGE.title}</h1>
      <p class="map-lead">{MAP_PAGE.lead}</p>
    </header>

    <div class="map-tabs" role="tablist" aria-label="題材檢視切換">
      <button class="map-tab is-active" role="tab" aria-selected="true" data-tab="heatmap">{MAP_PAGE.tabHeatmap}</button>
      <button class="map-tab" role="tab" aria-selected="false" data-tab="industry">{MAP_PAGE.tabIndustry}</button>
    </div>

    <!-- 熱力圖 -->
    <section id="panel-heatmap" class="map-panel" role="tabpanel">
      <div class="map-toolbar">
        <p class="map-hint">{MAP_PAGE.heatmapHint}</p>
        <div class="map-toolbar-r">
          <div class="hmp-toggle" role="tablist" aria-label="期間切換">
            <button class="hmp-tab is-active" type="button" role="tab" aria-selected="true" data-hmp="d">{MAP_PAGE.periodD}</button>
            <button class="hmp-tab" type="button" role="tab" aria-selected="false" data-hmp="w">{MAP_PAGE.periodW}</button>
            <button class="hmp-tab" type="button" role="tab" aria-selected="false" data-hmp="m">{MAP_PAGE.periodM}</button>
          </div>
          <span id="hm-status" class="map-status" data-prefix={MAP_PAGE.updatedAt} role="status"></span>
        </div>
      </div>
      <div id="hm-root" class="hm-root" aria-label="題材市場熱力圖" role="img"></div>
      <div class="map-foot">
        <div class="hm-legend" aria-hidden="true">
          <span>{MAP_PAGE.legendDown}</span>
          {[-6, -4.8, -3.6, -2.4, -1.2, 0, 1.2, 2.4, 3.6, 4.8, 6].map((p) => <i data-pct={p}></i>)}
          <span>{MAP_PAGE.legendUp}</span>
        </div>
        <p class="map-note">{MAP_PAGE.delayedNote}</p>
      </div>
    </section>

    <!-- 主題:題材總覽(今日熱門 + 分類篩選 + 卡片/關係圖) -->
    <section id="panel-industry" class="map-panel" role="tabpanel" hidden>
      <TodayThemes variant="hub" limit={5} />

      <div class="tov-bar">
        <div id="tcat-pills" class="tcat-pills" role="tablist" aria-label="題材分類"></div>
      </div>

      <div id="ind-root" class="ind-grid"></div>

      <script type="application/json" id="tov-i18n" set:html={JSON.stringify({
        all: MAP_PAGE.catAll,
        fav: MAP_PAGE.favFilter,
        explore: MAP_PAGE.cardExplore,
        verified: MAP_PAGE.cardVerified,
        companies: MAP_PAGE.cardCompanies,
        favEmpty: MAP_PAGE.favEmpty,
        graphHint: MAP_PAGE.graphHint,
        emptyCat: "此分類暫無題材",
      })} />
    </section>
  </main>

  <div id="hm-tip" class="hm-tip" hidden></div>

  <script>
    import { getThemes, toggleTheme } from "../lib/themelist";
    import { treemap, tileColor, tileTextColor, type Rect } from "../lib/heatmap";

    interface Co { t: string; n: string; s: string; ss: string; mc: number | null; }
    interface Theme {
      slug: string; title: string; companyCount: number; aggMcap: number;
      desc?: string; category?: string; cagr?: string;
      related: { label: string; slug: string | null }[];
      tiers: { u: Co[]; m: Co[]; d: Co[] };
    }
    const TOP_N = 6;          // 卡片 pct 用:每題材取市值前 N 檔估算平均漲跌
    const CHUNK = 110;        // /api/quote-batch 單次上限 120
    let themes: Theme[] = [];
    const pctByTicker: Record<string, number> = {};
    const pxByTicker: Record<string, number> = {};  // 即時價
    const volByTicker: Record<string, number> = {}; // 即時累積成交量(股)

    // 熱力圖:成交額/漲跌快照(日/週/月)
    type Stat = { d: number[]; w: number[]; m: number[] };
    const statsByTicker: Record<string, Stat> = {};
    let hmPeriod: "d" | "w" | "m" = "d";
    let statsAt = "";

    // 題材總覽狀態
    const I18N: Record<string, string> = JSON.parse(
      document.getElementById("tov-i18n")?.textContent || "{}",
    );
    let verifiedDate = "";
    let curCat = "__all__";
    let curFav = false;
    let favSet = new Set<string>();

    const $ = (id: string) => document.getElementById(id);
    const esc = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));

    // treemap 版面 + 漲跌配色改用共用 lib/heatmap(見上方 import),不再本地複製一份

    function dedupTop(t: Theme): Co[] {
      const seen = new Set<string>(); const all: Co[] = [];
      for (const c of [...t.tiers.u, ...t.tiers.m, ...t.tiers.d]) {
        if (seen.has(c.t)) continue; seen.add(c.t); all.push(c);
      }
      all.sort((a, b) => (b.mc ?? -1) - (a.mc ?? -1));
      return all.slice(0, TOP_N);
    }
    function themeAvgPct(t: Theme): number | null {
      let wsum = 0, psum = 0, n = 0, simple = 0;
      for (const c of dedupTop(t)) {
        const p = pctByTicker[c.t];
        if (p == null || !isFinite(p)) continue;
        n++; simple += p;
        const w = c.mc != null && c.mc > 0 ? c.mc : 0;
        if (w > 0) { wsum += w; psum += w * p; }
      }
      if (n === 0) return null;
      return wsum > 0 ? psum / wsum : simple / n;
    }

    // 題材的期間成交額(億)與成交額加權漲跌%(取所有有快照的成分股)
    function themeStat(t: Theme): { tov: number; chg: number | null } {
      let tov = 0, wsum = 0, psum = 0;
      const seen = new Set<string>();
      for (const c of [...t.tiers.u, ...t.tiers.m, ...t.tiers.d]) {
        if (seen.has(c.t)) continue; seen.add(c.t);
        const s = statsByTicker[c.t]; if (!s) continue;
        const arr = s[hmPeriod]; if (!arr) continue;
        // 日線漲跌與成交額優先用即時延遲報價(quote-batch);週/月無即時對應,用 CI 快照
        const live = hmPeriod === "d" && typeof pctByTicker[c.t] === "number" && isFinite(pctByTicker[c.t]) ? pctByTicker[c.t] : null;
        const liveTov = hmPeriod === "d" && typeof pxByTicker[c.t] === "number" && pxByTicker[c.t] > 0 && typeof volByTicker[c.t] === "number" && volByTicker[c.t] > 0 ? (pxByTicker[c.t] * volByTicker[c.t]) / 1e8 : null;
        const chg = live != null ? live : arr[0], tv = liveTov != null ? liveTov : arr[1];
        if (typeof tv === "number" && tv > 0) {
          tov += tv;
          if (typeof chg === "number" && isFinite(chg)) { wsum += tv; psum += tv * chg; }
        }
      }
      return { tov, chg: wsum > 0 ? psum / wsum : null };
    }

    // 熱力圖:磚塊大小＝題材期間成交額(sqrt 壓縮),顏色＝成交額加權漲跌%
    function renderHeatmap() {
      const root = $("hm-root"); if (!root) return;
      const W = root.clientWidth, H = root.clientHeight;
      if (W < 10 || H < 10 || themes.length === 0) return;
      const rows = themes.map((t) => ({ t, st: themeStat(t) })).filter((x) => x.st.tov > 0);
      if (rows.length === 0) { root.innerHTML = `<p class="map-fail">暫無成交額資料</p>`; return; }
      const nodes = rows.map((x) => ({ ...x.t, value: Math.sqrt(x.st.tov), _chg: x.st.chg }));
      const laid = treemap(nodes, 0, 0, W, H);
      const G = 1; // 內縮 gap
      root.innerHTML = laid.map((t) => {
        const pct = (t as typeof t & { _chg: number | null })._chg;
        const big = t.w > 74 && t.h > 30;
        const showPct = pct != null && t.w > 52 && t.h > 42;
        const pctStr = pct == null ? "" : (pct > 0 ? "+" : "") + pct.toFixed(2) + "%";
        return `<a class="hm-tile" href="/themes/${encodeURIComponent(t.slug)}" data-slug="${esc(t.slug)}" `
          + `style="left:${t.x + G}px;top:${t.y + G}px;width:${Math.max(0, t.w - 2 * G)}px;height:${Math.max(0, t.h - 2 * G)}px;background:${tileColor(pct)};color:${tileTextColor(pct)}">`
          + (big ? `<span class="hm-tile-t">${esc(t.title)}</span>` : "")
          + (showPct ? `<span class="hm-tile-p">${pctStr}</span>` : "")
          + `</a>`;
      }).join("");
    }

    // ---- 題材總覽:分類膠囊 + 卡片 + 關係圖 ----
    function fmtDate(iso: string): string {
      const d = new Date(iso || "");
      if (isNaN(d.getTime())) return "";
      return new Intl.DateTimeFormat("zh-TW", { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Asia/Taipei" })
        .format(d).replace(/\//g, "-");
    }
    function passFilter(t: Theme): boolean {
      if (curFav) return favSet.has(t.slug);
      if (curCat !== "__all__" && t.category !== curCat) return false;
      return true;
    }
    function updateUrl() {
      const p = new URLSearchParams();
      if (curFav) p.set("fav", "1");
      else if (curCat !== "__all__") p.set("cat", curCat);
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    }
    function readUrl() {
      const p = new URLSearchParams(location.search);
      if (p.get("fav") === "1") curFav = true;
      const c = p.get("cat"); if (c) curCat = c;
    }

    function renderPills() {
      const box = $("tcat-pills"); if (!box) return;
      const cats = [...new Set(themes.map((t) => t.category).filter(Boolean) as string[])]
        .sort((a, b) => a.localeCompare(b, "zh-Hant"));
      const pill = (key: string, label: string, on: boolean, extra = "") =>
        `<button class="tcat-pill${on ? " is-active" : ""}${extra}" type="button" role="tab" aria-selected="${on}" data-cat="${esc(key)}">${esc(label)}</button>`;
      let html = pill("__all__", I18N.all || "全部", curCat === "__all__" && !curFav);
      for (const c of cats) html += pill(c, c, !curFav && curCat === c);
      html += pill("__fav__", I18N.fav || "♡ 收藏", curFav, " tcat-fav");
      box.innerHTML = html;
      box.querySelectorAll<HTMLButtonElement>(".tcat-pill").forEach((b) =>
        b.addEventListener("click", () => {
          const k = b.getAttribute("data-cat") || "__all__";
          if (k === "__fav__") curFav = !curFav;
          else { curFav = false; curCat = k; }
          renderPills(); renderTov(); updateUrl();
        }),
      );
    }

    function cardHtml(t: Theme): string {
      const pct = themeAvgPct(t);
      const pctCls = pct == null ? "flat" : pct > 0 ? "up" : pct < 0 ? "down" : "flat";
      const pctStr = pct == null ? "" : `${pct > 0 ? "+" : ""}${pct.toFixed(2)}%`;
      const faved = favSet.has(t.slug);
      const cagr = t.cagr ? `<span class="ind-cagr">CAGR ${esc(t.cagr)}</span>` : "";
      const cat = t.category ? `<span class="ind-cat">${esc(t.category)}</span>` : "";
      const s = encodeURIComponent(t.slug);
      return `<article class="ind-card2">`
        + `<div class="ind-card2-top">`
        +   `<span class="ind-ico" aria-hidden="true">▦</span>`
        +   `<span class="ind-cnt">${t.companyCount} ${I18N.companies || "家"}</span>`
        +   `<button class="ind-fav${faved ? " is-on" : ""}" type="button" data-fav="${esc(t.slug)}" title="收藏" aria-label="收藏 ${esc(t.title)}">${faved ? "★" : "☆"}</button>`
        + `</div>`
        + `<a class="ind-card2-body" href="/themes/${s}?tab=overview">`
        +   `<span class="ind-title">${esc(t.title)}</span>`
        +   (t.desc ? `<span class="ind-desc">${esc(t.desc)}</span>` : "")
        + `</a>`
        + `<div class="ind-tags">${cat}${cagr}${pctStr ? `<span class="ind-pct ${pctCls}">${pctStr}</span>` : ""}</div>`
        + `<div class="ind-card2-foot">`
        +   `<a class="ind-explore" href="/themes/${s}?tab=structure">${I18N.explore || "探索 →"}</a>`
        +   `<span class="ind-verified">${verifiedDate ? `${I18N.verified || "核實"} ${verifiedDate}` : ""}</span>`
        + `</div>`
        + `</article>`;
    }

    function renderThemes() {
      const root = $("ind-root"); if (!root) return;
      const list = themes.filter(passFilter).sort((a, b) => b.companyCount - a.companyCount);
      if (list.length === 0) {
        root.innerHTML = `<p class="ind-empty">${curFav ? (I18N.favEmpty || "") : (I18N.emptyCat || "")}</p>`;
        return;
      }
      root.innerHTML = list.map(cardHtml).join("");
      root.querySelectorAll<HTMLButtonElement>(".ind-fav").forEach((b) =>
        b.addEventListener("click", (e) => {
          e.preventDefault(); e.stopPropagation();
          const s = b.getAttribute("data-fav"); if (!s) return;
          const on = toggleTheme(s);
          if (on) favSet.add(s); else favSet.delete(s);
          b.classList.toggle("is-on", on);
          b.textContent = on ? "★" : "☆";
          if (curFav && !on) renderThemes();
        }),
      );
    }

    // 題材總覽僅卡片檢視(關係圖已移至各題材詳細頁的供應鏈結構圖)
    function renderTov() { renderThemes(); }

    async function loadQuotes(): Promise<{ any: boolean; fetchedAt: string }> {
      const set = new Set<string>();
      for (const t of themes) for (const c of dedupTop(t)) if (/^\d{4}$/.test(c.t)) set.add(c.t);
      const all = [...set];
      const chunks: string[][] = [];
      for (let i = 0; i < all.length; i += CHUNK) chunks.push(all.slice(i, i + CHUNK));
      const results = await Promise.all(
        chunks.map((ch) =>
          fetch(`/api/quote-batch?symbols=${encodeURIComponent(ch.join(","))}`)
            .then((r) => (r.ok ? r.json() : null))
            .catch(() => null)
        )
      );
      let any = false, fetchedAt = "";
      for (const res of results) {
        if (!res || !res.quotes) continue;
        fetchedAt = res.fetchedAt || fetchedAt;
        for (const k of Object.keys(res.quotes)) {
          const v = res.quotes[k];
          if (!v) continue;
          if (typeof v.changePct === "number" && isFinite(v.changePct)) { pctByTicker[k] = v.changePct; any = true; }
          if (typeof v.price === "number" && isFinite(v.price)) { pxByTicker[k] = v.price; any = true; }
          if (typeof v.volume === "number" && isFinite(v.volume)) volByTicker[k] = v.volume;
        }
      }
      return { any, fetchedAt };
    }

    function setStatus() {
      const el = $("hm-status"); if (!el) return;
      const prefix = el.getAttribute("data-prefix") || "";
      const d = fmtDate(statsAt);
      el.textContent = d ? `${prefix} ${d}` : "";
    }

    // 熱力圖資料:成交額/漲跌快照(每日 CI 更新)
    async function loadStats() {
      try {
        const r = await fetch("/data/heatmap-stats.json");
        if (r.ok) {
          const j = await r.json();
          Object.assign(statsByTicker, j.stats || {});
          statsAt = j.generatedAt || "";
        }
      } catch { /* ignore */ }
      renderHeatmap();
      setStatus();
    }

    // 卡片 pct 徽章:即時報價(quote-batch),抓完重繪卡牆
    async function loadGallery() {
      const { any } = await loadQuotes();
      if (any) { renderThemes(); renderHeatmap(); } // 即時報價到手後,題材熱力圖也以最新日線漲跌重新上色
    }

    function initHmPeriod() {
      const tabs = Array.prototype.slice.call(document.querySelectorAll<HTMLButtonElement>(".hmp-tab"));
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          hmPeriod = (tab.getAttribute("data-hmp") as "d" | "w" | "m") || "d";
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle("is-active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
          });
          const tip = $("hm-tip"); if (tip) tip.hidden = true;
          renderHeatmap();
        });
      });
    }

    // ---- tooltip ----
    function initTooltip() {
      const root = $("hm-root"), tip = $("hm-tip"); if (!root || !tip) return;
      const bySlug = (s: string) => themes.find((t) => t.slug === s);
      root.addEventListener("mousemove", (e) => {
        const tgt = (e.target as HTMLElement).closest(".hm-tile") as HTMLElement | null;
        if (!tgt) { tip.hidden = true; return; }
        const t = bySlug(tgt.getAttribute("data-slug") || "");
        if (!t) { tip.hidden = true; return; }
        const st = themeStat(t);
        const c = st.chg;
        const pctStr = c == null ? "—" : `<b class="${c > 0 ? "up" : c < 0 ? "down" : "flat"}">${c > 0 ? "+" : ""}${c.toFixed(2)}%</b>`;
        const tovStr = st.tov >= 10000 ? `${(st.tov / 10000).toFixed(2)} 兆` : `${Math.round(st.tov)} 億`;
        const pl = hmPeriod === "d" ? "當日" : hmPeriod === "w" ? "近週" : "近月";
        tip.innerHTML = `<span class="hm-tip-t">${esc(t.title)}</span>`
          + `<span class="hm-tip-r">涵蓋 ${t.companyCount} 家 · ${pl}成交額 ${tovStr}</span>`
          + `<span class="hm-tip-r">${pl}漲跌 ${pctStr}</span>`;
        tip.hidden = false;
        const pad = 14, tw = tip.offsetWidth, th = tip.offsetHeight;
        let lx = e.clientX + pad, ly = e.clientY + pad;
        if (lx + tw > window.innerWidth - 8) lx = e.clientX - tw - pad;
        if (ly + th > window.innerHeight - 8) ly = e.clientY - th - pad;
        tip.style.left = `${lx}px`; tip.style.top = `${ly}px`;
      });
      root.addEventListener("mouseleave", () => { tip.hidden = true; });
    }

    // ---- tabs ----
    function initTabs() {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".map-tab"));
      const panels: Record<string, HTMLElement | null> = {
        heatmap: $("panel-heatmap"),
        industry: $("panel-industry"),
      };
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const key = tab.getAttribute("data-tab") || "heatmap";
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle("is-active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
          });
          for (const k of Object.keys(panels)) {
            const p = panels[k]; if (p) p.hidden = k !== key;
          }
          const tip = $("hm-tip");
          if (tip) tip.hidden = true; // 切分頁時清掉殘留的熱力圖 tooltip
          if (key === "heatmap") renderHeatmap();
        });
      });
    }

    // ---- debounced resize ----
    let rT: number | undefined;
    function onResize() {
      window.clearTimeout(rT);
      rT = window.setTimeout(() => { renderHeatmap(); }, 150);
    }

    // ---- init ----
    // 色階圖例:與磚塊同一個 tileColor 上色,確保一致
    document.querySelectorAll<HTMLElement>(".hm-legend i[data-pct]").forEach((el) => {
      el.style.background = tileColor(parseFloat(el.dataset.pct || "0"));
    });
    initTabs();
    initTooltip();
    initHmPeriod();
    favSet = new Set(getThemes());
    readUrl();
    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(onResize);
      const root = $("hm-root"); if (root) ro.observe(root);
    } else {
      window.addEventListener("resize", onResize);
    }

    fetch("/data/map-index.json")
      .then((r) => r.json())
      .then((j) => {
        themes = j.themes || [];
        verifiedDate = fmtDate(j.generatedAt);
        renderPills();
        renderHeatmap();
        renderThemes();
        loadStats();   // 熱力圖:成交額快照
        loadGallery(); // 卡牆:即時 pct 徽章
        // 帶著題材總覽篩選進站 → 自動切到「主題」分頁
        if (curFav || curCat !== "__all__") {
          (document.querySelector('.map-tab[data-tab="industry"]') as HTMLButtonElement | null)?.click();
        }
      })
      .catch(() => {
        const root = $("hm-root");
        if (root) root.innerHTML = `<p class="map-fail">資料載入失敗，請重新整理頁面。</p>`;
      });
  </script>

  <style is:global>
    .map-page { max-width: var(--layout-max, 1200px); margin: 0 auto; padding: 1.75rem 1rem 3rem; }
    .map-head { margin-bottom: 1.1rem; }
    .map-h1 { font-family: var(--font-display); font-size: 1.7rem; margin: 0 0 0.25rem; letter-spacing: -0.01em; }
    .map-lead { color: var(--muted); font-size: 0.88rem; margin: 0; line-height: 1.6; max-width: 64ch; }

    .map-tabs { display: inline-flex; gap: 4px; margin-bottom: 1.1rem; border-bottom: 1px solid rgba(var(--ink), 0.12); }
    .map-tab { appearance: none; border: none; background: none; color: var(--muted); font: inherit; font-size: 0.85rem; font-weight: 600; padding: 8px 14px 10px; border-radius: 0; cursor: pointer; position: relative; transition: color var(--duration) var(--ease-out); }
    .map-tab::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 2px; border-radius: 1px; background: var(--accent); transform: scaleX(0); transition: transform 0.22s cubic-bezier(0.2, 0.6, 0.2, 1); }
    .map-tab:hover { color: var(--text); }
    .map-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

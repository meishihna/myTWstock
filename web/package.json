{
  "name": "twstock-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "predev": "node scripts/build-data.mjs && node scripts/check-selfcontained.mjs",
    "dev": "astro dev",
    "dev:plain": "astro dev",
    "prebuild": "node scripts/build-data.mjs && node scripts/check-selfcontained.mjs",
    "build": "astro build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "test:news-resolve": "npx --yes tsx scripts/test-news-resolve.ts",
    "test:news-nlp": "npx --yes tsx scripts/test-news-nlp.ts",
    "test:reconcile": "node tests/reconcile-live.mjs",
    "test:fin-compare": "npx --yes tsx tests/compare-financials-migration.ts",
    "check:selfcontained": "node scripts/check-selfcontained.mjs",
    "check:selfcontained:self-test": "node scripts/check-selfcontained.mjs --self-test",
    "test:import-parse": "npx --yes tsx tests/import-parse.mjs",
    "test:recon-fields": "npx --yes tsx tests/recon-fields.mjs",
    "test:equity": "npx --yes tsx tests/equity-identity.mjs",
    "test:series": "npx --yes tsx tests/portfolio-series.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^8.3.4",
    "@astrojs/vercel": "^7.8.2",
    "@supabase/supabase-js": "^2.112.3",
    "astro": "^4.16.0",
    "lightweight-charts": "^4.2.3",
    "marked": "^15.0.0",
    "rss-parser": "^3.13.0",
    "yahoo-finance2": "^3.14.0"
  }
}
